# Ignore bundler config and installed gems.
/.bundle
/vendor/bundle

# Ignore all environment files.
/.env*
!/.env*.erb

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore master key for decrypting credentials and more.
/config/master.key
/config/credentials/*.key

# Ignore node_modules
/node_modules

# Ignore precompiled assets
/public/assets

# macOS
.DS_Store

# Python (gemini-slack-bot)
tools/**/.env
tools/**/.venv/
tools/**/__pycache__/

# El repo usa `structure.sql` (config.active_record.schema_format = :sql).
# `db/schema.rb` quedo versionado y pinneado en abril de 2026, sin `rtn`,
# `acceso_habilitado`, `tema`, `sucursal_retiro_id`, `notas_caja` ni `notas_sac`:
# quien corriera `db:schema:load` con ese archivo armaba una base rota. Rails ni
# lo consulta con este formato, asi que lo unico que podia hacer era mentir.
/db/schema.rb
