<%= render PageHeaderComponent.new(title: "Pre-Factura a mano", subtitle: "La puerta de las excepciones") %>

<%# PR-P.10 · Jorge, 2026-10-10: desde la Fase 14 la pre-factura se prepara
    (hoja → auditar → F9) y se cobra por el volumen medido. Esta pantalla queda
    para lo que el escaneo no cubre — y lo dice arriba, para que nadie la use
    por costumbre. %>
<div class="mb-6 p-4 rounded-lg bg-amber-50 border border-amber-200 text-sm text-amber-900" data-aviso="excepciones">
  <p class="font-medium">Esta puerta es para las excepciones:</p>
  <ul class="mt-1 list-disc list-inside space-y-0.5">
    <li>un paquete prepagado en Miami (lleva el cobro simbólico);</li>
    <li>una tanda cuyas cajas se cobran con tarifas distintas;</li>
    <li>un paquete que no se midió, o que no vino en un manifiesto oficial;</li>
    <li>volver a pre-facturar después de anular.</li>
  </ul>
  <p class="mt-2">
    Lo que tiene volumen medido se cobra igual por volumen, con su tanda entera.
    <%= link_to "Lo normal es Preparar pre-factura", hoja_de_preparacion_path, class: "font-medium text-cec-navy underline hover:text-cec-navy-light" %>
  </p>
</div>

<% if @cliente.nil? %>
  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-lg font-semibold mb-4">Paso 1: Seleccionar Cliente</h2>
    <%= form_tag new_pre_factura_path, method: :get, class: "space-y-4" do %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Cliente</label>
        <%= select_tag :cliente_id,
            options_from_collection_for_select(Cliente.activos.order(:codigo), :id, ->(c) { "#{c.codigo} - #{c.nombre_completo}" }),
            include_blank: "— Selecciona un cliente —",
            class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" %>
      </div>
      <%# C21-10. Yusef: *"lo que vamos a seleccionar, de que estamos
          procesando, es el manifiesto"*. Va opcional a propósito: una
          recolecta, o un paquete que entró por otra vía, no tiene manifiesto. %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Manifiesto que se está trabajando</label>
        <%= select_tag :manifiesto_id,
            options_from_collection_for_select(@manifiestos, :id, ->(m) { "#{m.numero} — #{m.cantidad_paquetes} paquete(s)" }, params[:manifiesto_id]),
            include_blank: "— Todos los manifiestos —",
            class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" %>
        <p class="text-xs text-gray-500 mt-1">
          <% if @manifiestos.any? %>
            Filtra los paquetes del cliente a los que vinieron en ese manifiesto, y lo deja guardado en la pre-factura.
          <% else %>
            No hay manifiestos con carga por facturar todavía.
          <% end %>
        </p>
      </div>
      <button type="submit" class="px-4 py-2 bg-cec-navy text-white rounded-lg hover:bg-cec-navy-light text-sm font-medium" data-shortcut="F8">Continuar (F8)</button>
    <% end %>
  </div>
<% else %>
  <div class="bg-white rounded-lg shadow p-6 mb-6">
    <h2 class="text-lg font-semibold mb-2">Cliente: <%= @cliente.codigo %> — <%= @cliente.nombre_completo %></h2>
    <p class="text-sm text-gray-500">
      Grupo: <%= @cliente.categoria_precio&.nombre || "Sin grupo (paga el precio de lista)" %>
    </p>
    <% if @cliente.saldo_pendiente.to_f > 0 %>
      <p class="text-sm text-amber-700 mt-1">Saldo pendiente actual: L. <%= number_with_delimiter(@cliente.saldo_pendiente.to_f, precision: 2) %></p>
    <% end %>
    <p class="text-sm mt-1">
      <% if @manifiesto %>
        Manifiesto: <span class="font-mono font-semibold text-cec-navy"><%= @manifiesto.numero %></span>
        <%= link_to "cambiar", new_pre_factura_path, class: "text-xs text-cec-teal hover:underline ml-1" %>
      <% else %>
        <span class="text-gray-500">Sin manifiesto — se ven todos los paquetes facturables del cliente.</span>
      <% end %>
    </p>
  </div>

  <% if @paquetes_facturables.any? %>
    <%# PR-P.10 · Las filas salen del mismo armador que `create`
        (`ArmarPreFacturaManual`, sin guardar): una tanda medida es UNA fila
        con UN check —el volumen pesó todo lo que tiene adentro, no se elige
        media—; una tanda que no puede ir por volumen muestra sus cajas sueltas
        con el porqué; lo demás, paquete por paquete como siempre. %>
    <% tandas = @preview.por_volumen %>
    <% rechazadas = @paquetes_facturables.select { |p| @preview.rechazo_de(p) }.group_by(&:medicion_sesion) %>
    <% sueltos = @paquetes_facturables.reject { |p| @preview.por_volumen?(p) || @preview.rechazo_de(p) } %>
    <%= form_tag pre_facturas_path, method: :post,
          data: { controller: "pre-factura-seleccion",
                  pre_factura_seleccion_url_value: cotizacion_pre_facturas_path(cliente_id: @cliente.id) } do %>
      <%= hidden_field_tag :cliente_id, @cliente.id %>
      <%= hidden_field_tag :manifiesto_id, @manifiesto&.id %>
      <div class="bg-white rounded-lg shadow overflow-hidden">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-4 py-3 text-left">
                  <input type="checkbox" aria-label="Marcar todo" class="rounded"
                         data-pre-factura-seleccion-target="todos" data-action="change->pre-factura-seleccion#todos">
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tracking</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tipo</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Peso Cobrar</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Precio/Lb</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Subtotal</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% tandas.each do |sesion| %>
                <% cajas = @preview.cajas_de_la_tanda(sesion) %>
                <% lineas = @preview.lineas_de_volumen(sesion) %>
                <tr class="hover:bg-gray-50 bg-cec-navy/5" data-tanda="<%= sesion %>">
                  <td class="px-4 py-3 align-top">
                    <%= check_box_tag "paquete_ids[]", cajas.map(&:id).join(","), false,
                          id: "tanda_#{sesion}", class: "rounded border-gray-300 text-cec-teal focus:ring-cec-teal",
                          data: { pre_factura_seleccion_target: "check", action: "change->pre-factura-seleccion#cambiar" } %>
                  </td>
                  <td class="px-6 py-3 text-sm align-top">
                    <label for="tanda_<%= sesion %>" class="font-medium text-cec-navy cursor-pointer">
                      Tanda medida · <%= pluralize(cajas.size, "caja", plural: "cajas") %>
                    </label>
                    <ul class="mt-1 space-y-0.5 text-xs text-gray-700">
                      <% lineas.each do |linea| %>
                        <li data-volumen="<%= linea.bulto_id %>">
                          <%= [ "Volumen", linea.bulto.de_cuantos_texto ].compact.join(" ") %> ·
                          <%= number_with_precision(linea.peso_cobrar, precision: 2, strip_insignificant_zeros: true) %> lb ·
                          L. <%= number_with_precision(linea.subtotal, precision: 2, delimiter: ",") %>
                          <% if linea.concepto.start_with?("⚠") %>
                            <span class="text-[10px] font-bold text-red-700 uppercase">⚠ sin tarifa cargada</span>
                          <% elsif linea.minimo_aplicado %>
                            <span class="text-[10px] text-amber-700 uppercase tracking-wide">mínimo</span>
                          <% end %>
                        </li>
                      <% end %>
                    </ul>
                    <div class="mt-1 font-mono text-[11px] text-gray-500">
                      <% cajas.each do |caja| %>
                        <div>
                          <%= truncate(caja.tracking, length: 22) %>
                          <%# Una caja de la tanda que vino en otro manifiesto entra
                              igual: el volumen la pesó. Se dice, para que no se
                              cobre sin verla. %>
                          <% if @manifiesto && caja.manifiesto_id != @manifiesto.id %>
                            <span class="text-amber-700 font-sans">(otro manifiesto: <%= caja.manifiesto&.numero || "—" %>)</span>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  </td>
                  <td class="px-6 py-3 text-sm text-gray-600 align-top"><%= cajas.first&.tipo_envio&.nombre || "—" %></td>
                  <td class="px-6 py-3 text-right text-sm align-top">
                    <%= number_with_precision(lineas.sum { |l| l.peso_cobrar.to_d }, precision: 2, strip_insignificant_zeros: true) %>
                  </td>
                  <td class="px-6 py-3 text-right text-sm align-top">
                    <% if lineas.size == 1 %>
                      L. <%= number_with_precision(lineas.first.precio_libra, precision: 2, delimiter: ",") %>
                    <% else %>
                      <span class="text-gray-500 italic">por volumen</span>
                    <% end %>
                  </td>
                  <td class="px-6 py-3 text-right text-sm font-medium align-top" data-subtotal-tanda>
                    L. <%= number_with_precision(lineas.sum { |l| l.subtotal.to_d }, precision: 2, delimiter: ",") %>
                  </td>
                </tr>
              <% end %>

              <% rechazadas.each do |sesion, paquetes| %>
                <tr class="bg-amber-50" data-tanda-rechazada="<%= sesion %>">
                  <td colspan="6" class="px-6 py-2 text-xs text-amber-900">
                    <span class="font-medium">Tanda medida que va por paquete, con el peso de Miami:</span>
                    <%= @preview.rechazos[sesion] %>
                  </td>
                </tr>
                <% paquetes.each do |p| %>
                  <%= render "fila_paquete", paquete: p, flete: @preview.flete_de(p) %>
                <% end %>
              <% end %>

              <% sueltos.each do |p| %>
                <%= render "fila_paquete", paquete: p, flete: @preview.flete_de(p) %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <%# PR-P.10 · El total de lo marcado lo calcula el servidor con el mismo
          armador y la misma cuenta del documento (ISV half-up): es el total
          que va a quedar guardado. %>
      <div class="mt-6 bg-white rounded-lg shadow p-6">
        <%= turbo_frame_tag "cotizacion_pre_factura", data: { pre_factura_seleccion_target: "frame" } do %>
          <%= render "cotizacion_total", pre_factura: nil %>
        <% end %>
      </div>

      <div class="mt-6 bg-white rounded-lg shadow p-6">
        <label class="block text-sm font-medium text-gray-700 mb-1">Notas (opcional)</label>
        <%= render "shared/plantillas_notas", selector: "#pre_factura_notas" %>
        <%= text_area_tag "pre_factura[notas]", "", rows: 2, id: "pre_factura_notas", class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm" %>
      </div>

      <div class="mt-6 flex gap-3">
        <button type="submit" class="px-4 py-2 bg-cec-navy text-white rounded-lg hover:bg-cec-navy-light text-sm font-medium" data-shortcut="F8">Crear Pre-Factura (F8)</button>
        <%= link_to "Cancelar (F2)", pre_facturas_path, class: "px-4 py-2 text-sm text-gray-600 hover:text-gray-900", data: { shortcut: "F2" } %>
      </div>
    <% end %>
  <% else %>
    <%= render EmptyStateComponent.new(
      title: "Sin paquetes facturables",
      description: @manifiesto ? "Este cliente no tiene paquetes por facturar en el manifiesto #{@manifiesto.numero}." : "Este cliente no tiene paquetes en bodega Honduras disponibles para facturar.",
      icon: "archive-box"
    ) %>
  <% end %>
<% end %>
