<%# Una fila por paquete en el paso 2 de /pre_facturas/new: lo que no tiene
    tanda medida, o cuya tanda no puede ir por volumen (PR-P.10).

    PR-10.h: el precio es el de la línea que va a guardar la pre-factura —ahora
    sale del mismo armador que `create` (`flete`)—. Antes se calculaba acá con
    la cadena vieja y se imprimía con "L." un monto que estaba en dólares. %>
<tr class="hover:bg-gray-50 <%= 'bg-cec-teal/5' if paquete.prepagado_miami? %>">
  <td class="px-4 py-3">
    <%= check_box_tag "paquete_ids[]", paquete.id, false, id: "paquete_#{paquete.id}",
          class: "rounded border-gray-300 text-cec-teal focus:ring-cec-teal",
          data: { pre_factura_seleccion_target: "check", action: "change->pre-factura-seleccion#cambiar" } %>
  </td>
  <td class="px-6 py-3 font-mono text-sm">
    <%= truncate(paquete.tracking, length: 20) %>
    <% if paquete.tracking_secundario.present? %>
      <div class="text-[11px] text-gray-500 mt-0.5" title="Tracking secundario"><%= truncate(paquete.tracking_secundario, length: 22) %></div>
    <% end %>
    <% if paquete.prepagado_miami? %>
      <%# PR-6b: pill para alertar al cajero que este paquete ya está pagado.
          Si lo seleccionan, se agregará línea simbólica en vez del flete
          completo. %>
      <div class="mt-0.5 inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[10px] font-bold uppercase bg-cec-teal/15 text-cec-teal-dark ring-1 ring-cec-teal/40"
           title="Pagado en Miami — al agregarlo a la pre-factura se cobra solo el monto simbólico">
        ✓ Prepagado Miami
      </div>
    <% end %>
  </td>
  <td class="px-6 py-3 text-sm text-gray-600"><%= paquete.tipo_envio&.nombre || "—" %></td>
  <td class="px-6 py-3 text-right text-sm"><%= paquete.peso_cobrar || "—" %></td>
  <td class="px-6 py-3 text-right text-sm">
    <% if paquete.prepagado_miami? %>
      <span class="text-cec-teal-dark italic">simbólico</span>
    <% elsif flete %>
      L. <%= number_with_precision(flete.precio_libra, precision: 2, delimiter: ",") %>
      <% if flete.concepto.to_s.start_with?("⚠") %>
        <span class="block text-[10px] font-bold text-red-700 uppercase">⚠ sin tarifa cargada</span>
      <% elsif flete.minimo_aplicado %>
        <span class="block text-[10px] text-amber-700 uppercase tracking-wide">mínimo</span>
      <% end %>
    <% end %>
  </td>
  <td class="px-6 py-3 text-right text-sm font-medium">
    <% if paquete.prepagado_miami? %>
      <span class="text-cec-teal-dark">$<%= PreFactura::PREPAGADO_MIAMI_SIMBOLICO %></span>
    <% elsif flete %>
      L. <%= number_with_precision(flete.subtotal, precision: 2, delimiter: ",") %>
    <% end %>
  </td>
</tr>
