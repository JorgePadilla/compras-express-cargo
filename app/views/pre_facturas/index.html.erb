<%= render PageHeaderComponent.new(title: "Pre-Facturas", subtitle: "#{@pre_facturas.total_count} pre-facturas") do |h| %>
  <%# PR-P.11b · Jorge, 2026-10-10: «quitar la de a mano; todo por escaneo».
      La pre-factura nace en la hoja → Auditar → F9/F8, que cobra por
      volumen; F1 va ahí y no hay otra puerta. %>
  <% h.with_action do %>
    <%= render ButtonComponent.new(href: hoja_de_preparacion_path, variant: :primary, icon: "queue-list", shortcut: "F1") do %>
      Preparar pre-factura
    <% end %>
  <% end %>
<% end %>

<div class="mb-6">
  <%= render SearchBarComponent.new(url: pre_facturas_path, placeholder: "Buscar por numero o cliente...", value: params[:q]) %>
</div>

<details class="mb-6 bg-white rounded-lg shadow">
  <summary class="px-6 py-3 cursor-pointer text-sm font-medium text-gray-700 hover:text-cec-navy flex items-center gap-2">
    <%= heroicon "funnel", variant: :outline, options: { class: "w-4 h-4" } %>
    Filtros
  </summary>
  <div class="px-6 py-4 border-t border-gray-200">
    <%= form_tag pre_facturas_path, method: :get, class: "grid grid-cols-1 md:grid-cols-3 gap-4", data: { controller: "f2-clear", f2_clear_submit_value: "true" } do %>
      <% if params[:q].present? %>
        <input type="hidden" name="q" value="<%= params[:q] %>">
      <% end %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Estado</label>
        <%= select_tag :estado, options_for_select(PreFactura::ESTADOS.map { |e| [e.humanize, e] }, params[:estado]),
            include_blank: "— Todos —",
            class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Desde</label>
        <%= date_field_tag :fecha_desde, params[:fecha_desde],
              class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm",
              data: { controller: "flatpickr" } %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Hasta</label>
        <%= date_field_tag :fecha_hasta, params[:fecha_hasta],
              class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm",
              data: { controller: "flatpickr" } %>
      </div>
      <div class="md:col-span-3 flex gap-3">
        <button type="submit" class="px-4 py-2 text-sm font-medium bg-cec-navy text-white rounded-lg hover:bg-cec-navy-light">Aplicar</button>
        <%= link_to "Limpiar", pre_facturas_path, class: "px-4 py-2 text-sm text-gray-600 hover:text-gray-900" %>
      </div>
    <% end %>
  </div>
</details>

<% if @pre_facturas.any? %>
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Numero</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Cliente</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Fecha</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Manifiesto</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Aviso</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Total (LPS)</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @pre_facturas.each do |pf| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap">
                <%= link_to pf.numero, pf, class: "text-sm font-mono font-medium text-cec-navy hover:underline" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="text-sm text-gray-700"><%= pf.cliente.codigo %></span>
                <span class="text-sm text-gray-500 hidden sm:inline ml-1"><%= pf.cliente.nombre_completo %></span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="text-sm text-gray-500"><%= pf.fecha_trabajo&.strftime("%d/%m/%Y") || pf.created_at.strftime("%d/%m/%Y") %></span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="text-sm font-mono text-gray-600"><%= pf.manifiesto&.numero || "—" %></span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <%= render StatusBadgeComponent.new(status: pf.estado) %>
              </td>
              <%# PR-P.11b · En qué anda el aviso al cliente (PR-P.2/P.7): lo
                  mismo que muestra la hoja en «editar», sin otra consulta. %>
              <td class="px-6 py-4 whitespace-nowrap" data-aviso="<%= pf.estado_del_aviso %>">
                <% case pf.estado_del_aviso %>
                <% when :avisada %>
                  <span class="text-sm text-gray-600">Avisada <%= pf.notificado_at.strftime("%d/%m %H:%M") %></span>
                <% when :consolidando %>
                  <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-semibold bg-cec-gold/20 text-cec-navy">Consolidando</span>
                <% when :error %>
                  <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-semibold bg-red-50 text-red-700 ring-1 ring-red-200">Error de aviso</span>
                <% when :programada %>
                  <span class="text-sm text-gray-600">Programada <%= pf.notificar_at.strftime("%d/%m %H:%M") %></span>
                <% else %>
                  <span class="text-sm text-gray-400">—</span>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right">
                <span class="text-sm font-medium text-gray-900">L. <%= number_with_delimiter(pf.total.to_f, precision: 2) %></span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center justify-end gap-2">
                  <%= render RowActionComponent.new(action: :view, href: pf, label: "Ver pre-factura #{pf.numero}") %>
                  <%= render RowActionComponent.new(action: :edit, href: edit_pre_factura_path(pf),
                        disabled: pf.facturado? || pf.anulado?, label: "Editar pre-factura") %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="mt-4"><%= render PaginationComponent.new(collection: @pre_facturas, label: "pre-facturas") %></div>
<% else %>
  <%= render EmptyStateComponent.new(
    title: "No hay pre-facturas",
    description: "Se preparan desde «Preparar pre-factura» → Auditar.",
    icon: "document-text"
  ) %>
<% end %>
