<%# `RP-58` · El mapa de permisos, editable.

    No lleva el estándar táctil de 44 px: Configuración **no está** en la lista
    de pantallas de bodega de `docs/07`. Esto se usa sentado, en una pantalla
    grande, y con muchas casillas a la vez. %>
<%= render PageHeaderComponent.new(
      title: "Permisos por rol",
      subtitle: "Qué pantalla ve cada puesto") %>

<div class="bg-cec-navy/5 dark:bg-gray-800 ring-1 ring-cec-navy/20 dark:ring-gray-700 rounded-lg p-4 mb-6 text-sm">
  <p class="text-gray-800 dark:text-gray-100">
    Las casillas arrancan como las trae el sistema. Lo que cambies queda guardado
    <b>como excepción</b>: si volvés a dejar una casilla como estaba, la excepción se borra sola.
  </p>
  <p class="text-gray-600 dark:text-gray-300 mt-1">
    <b>Administrador no aparece</b> a propósito: entra a todo siempre, y no es algo que se pueda quitar —
    si se pudiera, alguien podría dejarse afuera a sí mismo.
  </p>
  <% if @excepciones.any? %>
    <p class="text-cec-teal-deep dark:text-cec-gold mt-2 font-medium">
      Hay <%= @excepciones.size %> sección(es) fuera de lo que trae el sistema, marcadas con un punto.
    </p>
  <% end %>
</div>

<%= form_with url: permisos_path, method: :patch, local: true do %>
  <%# Un marcador por columna: sin esto, un rol al que se le destilda **todo**
      llega igual que un rol que no vino en el formulario, y el servicio le
      borraría los accesos en vez de negárselos. Es el mismo truco del hidden
      que Rails pone antes de cada checkbox. %>
  <% @roles.each do |rol| %>
    <%= hidden_field_tag "permisos[#{rol}][_presente]", "1", id: "presente_#{rol}" %>
  <% end %>
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead class="bg-gray-50 dark:bg-gray-900 sticky top-0 z-10">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Sección</th>
            <% @roles.each do |rol| %>
              <th class="px-3 py-3 text-center text-[11px] font-mono font-medium text-gray-500 dark:text-gray-400">
                <%= rol.tr("_", " ") %>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
          <% @por_grupo.each do |grupo, secciones| %>
            <tr class="bg-gray-50 dark:bg-gray-900">
              <td colspan="<%= @roles.size + 1 %>"
                  class="px-6 pt-4 pb-1 text-[11px] font-mono font-bold uppercase tracking-widest text-cec-teal-deep dark:text-cec-gold">
                <%= grupo %>
              </td>
            </tr>
            <% secciones.each do |llave, seccion| %>
              <% editable = PermisosDelSistema.editable?(llave) %>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/40">
                <td class="px-6 py-2.5">
                  <span class="text-sm text-gray-800 dark:text-gray-100"><%= seccion[:nombre] %></span>
                  <% if seccion[:ayuda] %>
                    <span class="block text-xs text-gray-500 dark:text-gray-400"><%= seccion[:ayuda] %></span>
                  <% end %>
                  <% unless editable %>
                    <span class="block text-xs text-amber-700 dark:text-amber-500">
                      No se puede mover: darla es regalar todo lo demás.
                    </span>
                  <% end %>
                </td>
                <% @roles.each do |rol| %>
                  <% excepcion = @excepciones[[ rol, llave.to_s ]] %>
                  <% marcada = excepcion ? excepcion.permitido : PermisosDelSistema.politica(rol, llave) %>
                  <td class="px-3 py-2.5 text-center">
                    <% if editable %>
                      <label class="inline-flex items-center justify-center relative">
                        <%= check_box_tag "permisos[#{rol}][#{llave}]", "1", marcada,
                              id: "permiso_#{rol}_#{llave}",
                              class: "rounded border-gray-300 text-cec-teal focus:ring-cec-teal" %>
                        <% if excepcion %>
                          <span class="absolute -top-1 -right-2 w-1.5 h-1.5 rounded-full bg-cec-gold"
                                title="Cambiado a mano — el sistema traía lo contrario"></span>
                        <% end %>
                      </label>
                    <% else %>
                      <span class="text-gray-300 dark:text-gray-600">—</span>
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="px-6 py-4 bg-gray-50 dark:bg-gray-900 border-t border-gray-200 dark:border-gray-700 flex items-center justify-between gap-3">
      <p class="text-xs text-gray-500 dark:text-gray-400">
        Los cambios se aplican en el próximo clic de cada usuario. No hace falta que vuelvan a entrar.
      </p>
      <%= render(ButtonComponent.new(variant: :gold, type: :submit, shortcut: "F10")) { "Guardar permisos" } %>
    </div>
  </div>
<% end %>
