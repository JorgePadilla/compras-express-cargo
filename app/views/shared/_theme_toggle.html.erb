<%# Toggle sun/moon. Requiere helper `theme_preferencia_url`. %>
<% if theme_toggle_available? %>
  <%
    is_dark = current_theme == "dark"
    aria_label = is_dark ? "Cambiar a tema claro" : "Cambiar a tema oscuro"
  %>
  <div data-controller="theme" data-theme-url-value="<%= theme_preferencia_url %>" class="inline-flex">
    <button type="button"
            data-action="click->theme#toggle"
            data-theme-target="button"
            aria-pressed="<%= is_dark %>"
            aria-label="<%= aria_label %>"
            class="inline-flex items-center justify-center w-9 h-9 rounded-lg
                   text-gray-600 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-700
                   foco-cec
                   transition-colors motion-reduce:transition-none">
      <span data-theme-target="iconLight" class="<%= 'hidden' if is_dark %>" aria-hidden="true">
        <%= heroicon "sun", variant: :outline, options: { class: "w-5 h-5" } %>
      </span>
      <span data-theme-target="iconDark" class="<%= 'hidden' unless is_dark %>" aria-hidden="true">
        <%= heroicon "moon", variant: :outline, options: { class: "w-5 h-5" } %>
      </span>
    </button>
  </div>
<% end %>
