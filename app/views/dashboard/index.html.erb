<% content_for :title, "Dashboard" %>

<div class="space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-cec-navy dark:text-gray-100">Dashboard</h1>
    <p class="text-sm text-gray-600 dark:text-gray-400">Bienvenido, <%= Current.user.nombre.presence || Current.user.email_address %> · <%= Date.current.strftime("%d/%m/%Y") %></p>
  </div>

  <%# ── KPIs del día ── %>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 p-4">
      <p class="text-xs font-semibold uppercase text-gray-500 dark:text-gray-400">Ingresos hoy</p>
      <p class="text-2xl font-bold text-cec-teal-dark dark:text-cec-teal-light mt-1">L <%= number_with_delimiter(@ingresos_hoy.to_f.round(2)) %></p>
      <p class="text-[11px] text-gray-400 dark:text-gray-500 mt-1">Semana: L <%= number_with_delimiter(@ingresos_semana.to_f.round(2)) %></p>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 p-4">
      <p class="text-xs font-semibold uppercase text-gray-500 dark:text-gray-400">Paquetes recibidos hoy</p>
      <p class="text-2xl font-bold text-cec-navy dark:text-gray-100 mt-1"><%= @paquetes_recibidos_hoy %></p>
      <p class="text-[11px] text-gray-400 dark:text-gray-500 mt-1">Semana: <%= @paquetes_semana %> · Mes: <%= @paquetes_mes %></p>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 p-4">
      <p class="text-xs font-semibold uppercase text-gray-500 dark:text-gray-400">Entregas hoy</p>
      <p class="text-2xl font-bold text-cec-gold-dark dark:text-cec-gold-light mt-1"><%= @entregas_hoy %></p>
      <p class="text-[11px] text-gray-400 dark:text-gray-500 mt-1"><%= @entregas_en_reparto %> en reparto</p>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 p-4">
      <p class="text-xs font-semibold uppercase text-gray-500 dark:text-gray-400">Pre-alertas hoy</p>
      <p class="text-2xl font-bold text-cec-navy dark:text-gray-100 mt-1"><%= @pre_alertas_hoy %></p>
      <p class="text-[11px] text-gray-400 dark:text-gray-500 mt-1"><%= @tareas_abiertas %> tareas abiertas</p>
    </div>
  </div>

  <%# ── Pipeline operativo ── %>
  <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 p-5">
    <h2 class="text-sm font-bold text-gray-800 dark:text-gray-100 mb-4">Pipeline Operativo</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <div class="rounded-lg bg-cec-navy/5 dark:bg-cec-navy/30 p-3">
        <p class="text-[11px] font-semibold uppercase text-cec-navy dark:text-cec-gold-light">En bodega</p>
        <p class="text-xl font-bold text-cec-navy dark:text-gray-100 mt-0.5"><%= @paquetes_en_bodega %></p>
        <p class="text-[10px] text-gray-500 dark:text-gray-400">Recibidos + empacados</p>
      </div>
      <div class="rounded-lg bg-amber-50 dark:bg-amber-900/30 p-3">
        <p class="text-[11px] font-semibold uppercase text-amber-700 dark:text-amber-300">En tránsito</p>
        <p class="text-xl font-bold text-amber-800 dark:text-amber-100 mt-0.5"><%= @paquetes_en_transito %></p>
        <p class="text-[10px] text-gray-500 dark:text-gray-400">Enviados + aduana</p>
      </div>
      <div class="rounded-lg bg-cec-teal/10 dark:bg-cec-teal/20 p-3">
        <p class="text-[11px] font-semibold uppercase text-cec-teal-dark dark:text-cec-teal-light">Listos entrega</p>
        <p class="text-xl font-bold text-cec-teal-dark dark:text-cec-teal-light mt-0.5"><%= @paquetes_disponibles %></p>
        <p class="text-[10px] text-gray-500 dark:text-gray-400">Disponibles en sucursal</p>
      </div>
      <div class="rounded-lg bg-red-50 dark:bg-red-900/30 p-3">
        <p class="text-[11px] font-semibold uppercase text-red-700 dark:text-red-300">Ventas pendientes</p>
        <p class="text-xl font-bold text-red-800 dark:text-red-100 mt-0.5"><%= @ventas_pendientes %></p>
        <p class="text-[10px] text-gray-500 dark:text-gray-400">Sin pago</p>
      </div>
    </div>
  </div>

  <%# ── Tendencia 7 días ── %>
  <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 p-5">
    <h2 class="text-sm font-bold text-gray-800 dark:text-gray-100 mb-3">Paquetes recibidos · últimos 7 días</h2>
    <% max_val = [@paquetes_7_dias.map { |d| d[:paquetes] }.max, 1].max %>
    <div class="flex items-end gap-2 h-40" role="img" aria-label="Paquetes recibidos en los últimos 7 días">
      <% @paquetes_7_dias.each do |d| %>
        <% pct = (d[:paquetes].to_f / max_val * 100).round %>
        <div class="flex-1 flex flex-col items-center gap-1 group">
          <span class="text-[11px] font-semibold text-gray-600 dark:text-gray-300"><%= d[:paquetes] %></span>
          <div class="w-full bg-cec-teal/80 dark:bg-cec-teal-light hover:bg-cec-teal transition-colors motion-reduce:transition-none"
               style="height: <%= [pct, 2].max %>%;"
               title="<%= d[:label] %>: <%= d[:paquetes] %> paquetes"></div>
          <span class="text-[10px] text-gray-400 dark:text-gray-500"><%= d[:label] %></span>
        </div>
      <% end %>
    </div>
  </div>

  <%# ── Actividad reciente ── %>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
      <div class="px-4 py-3 border-b border-gray-100 dark:border-gray-700 flex items-center justify-between">
        <h3 class="text-sm font-bold text-gray-800 dark:text-gray-100">Paquetes recientes</h3>
        <%= link_to "Ver todos", paquetes_path,
            class: "text-xs text-cec-teal hover:text-cec-teal-dark dark:text-cec-teal-light dark:hover:text-cec-teal font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cec-teal rounded" %>
      </div>
      <div class="divide-y divide-gray-100 dark:divide-gray-700">
        <% @paquetes_recientes.each do |p| %>
          <%= link_to p, class: "flex items-center justify-between px-4 py-2 hover:bg-gray-50 dark:hover:bg-gray-700/50 text-sm focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-cec-teal" do %>
            <div class="min-w-0 flex-1">
              <p class="font-mono text-xs text-gray-500 dark:text-gray-400"><%= p.guia %></p>
              <p class="text-gray-700 dark:text-gray-200 truncate"><%= p.cliente.nombre_completo %> · <%= p.tracking %></p>
            </div>
            <%= render StatusBadgeComponent.new(status: p.estado) %>
          <% end %>
        <% end %>
        <% if @paquetes_recientes.empty? %>
          <p class="px-4 py-6 text-center text-sm text-gray-400 dark:text-gray-500">Sin paquetes aún</p>
        <% end %>
      </div>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
      <div class="px-4 py-3 border-b border-gray-100 dark:border-gray-700 flex items-center justify-between">
        <h3 class="text-sm font-bold text-gray-800 dark:text-gray-100">Ventas recientes</h3>
        <%= link_to "Ver todas", ventas_path,
            class: "text-xs text-cec-teal hover:text-cec-teal-dark dark:text-cec-teal-light dark:hover:text-cec-teal font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cec-teal rounded" %>
      </div>
      <div class="divide-y divide-gray-100 dark:divide-gray-700">
        <% @ventas_recientes.each do |v| %>
          <%= link_to v, class: "flex items-center justify-between px-4 py-2 hover:bg-gray-50 dark:hover:bg-gray-700/50 text-sm focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-cec-teal" do %>
            <div class="min-w-0 flex-1">
              <p class="font-mono text-xs text-gray-500 dark:text-gray-400"><%= v.numero %></p>
              <p class="text-gray-700 dark:text-gray-200 truncate"><%= v.cliente.nombre_completo %></p>
            </div>
            <div class="text-right shrink-0">
              <p class="font-semibold text-cec-navy dark:text-gray-100">L <%= number_with_delimiter(v.total.to_f.round(2)) %></p>
              <p class="text-[10px] text-gray-400 dark:text-gray-500 capitalize"><%= v.estado %></p>
            </div>
          <% end %>
        <% end %>
        <% if @ventas_recientes.empty? %>
          <p class="px-4 py-6 text-center text-sm text-gray-400 dark:text-gray-500">Sin ventas aún</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
