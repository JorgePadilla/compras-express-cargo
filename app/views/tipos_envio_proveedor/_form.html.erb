<%= render layout: "catalogos_manifiesto/formulario", locals: { registro: registro, url: url, tab: "tipos_proveedor" } do |f| %>
  <div>
    <%= f.label :nombre, "Nombre", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :nombre, required: true,
        class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" %>
  </div>
  <div>
    <%= f.label :position, "Posición", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.number_field :position, min: 0,
        class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" %>
  </div>
  <p class="text-xs text-gray-500">Es el servicio del <b>proveedor</b> —«AEREO EXPRESS», «CKM MARITIMO»—, no el nuestro.</p>
<% end %>
