<%= render PageHeaderComponent.new(
      title: "Mi PIN de autorizacion",
      subtitle: "Los 4 digitos con los que autorizas cambios de precio en una pre-factura") %>

<div class="max-w-lg">
  <% if Current.user.pin_digest.blank? %>
    <div class="p-4 rounded-lg bg-amber-50 border border-amber-200 text-sm text-amber-900">
      <p class="font-medium mb-1">Todavia no tenes PIN asignado.</p>
      <p>Pedile a un administrador que te asigne uno desde la pantalla de usuarios. Despues volves aca y lo cambias por uno que solo vos sepas.</p>
    </div>
  <% else %>
    <% if Current.user.pin_sin_cambiar? %>
      <div class="mb-4 p-4 rounded-lg bg-amber-50 border border-amber-200 text-sm text-amber-900">
        <p class="font-medium mb-1">Todavia estas usando el PIN que te asigno el administrador.</p>
        <p>Conviene que lo cambies: mientras no lo hagas, el tambien puede autorizar en tu nombre y el registro de quien autorizo no prueba nada.</p>
      </div>
    <% end %>

    <%= form_with model: Current.user, url: mi_pin_path, method: :patch,
                  class: "bg-white rounded-lg shadow p-6 space-y-4" do |f| %>
      <% if Current.user.errors.any? %>
        <div class="p-3 bg-red-50 text-red-700 border border-red-200 rounded-lg text-sm">
          <%= Current.user.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <div>
        <%= label_tag "user[pin_actual]", "PIN actual", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= password_field_tag "user[pin_actual]", nil, inputmode: "numeric", maxlength: 4,
              autocomplete: "off", required: true,
              class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm tracking-widest
                     focus:ring-cec-teal focus:border-cec-teal" %>
      </div>

      <div>
        <%= f.label :pin, "PIN nuevo (4 digitos)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.password_field :pin, inputmode: "numeric", maxlength: 4, autocomplete: "off",
              required: true, value: nil,
              class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm tracking-widest
                     focus:ring-cec-teal focus:border-cec-teal" %>
      </div>

      <div>
        <%= f.label :pin_confirmation, "Confirmar PIN nuevo", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.password_field :pin_confirmation, inputmode: "numeric", maxlength: 4,
              autocomplete: "off", required: true, value: nil,
              class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm tracking-widest
                     focus:ring-cec-teal focus:border-cec-teal" %>
      </div>

      <div class="flex gap-3 pt-2">
        <button type="submit" class="px-4 py-2 bg-cec-navy text-white rounded-lg hover:bg-cec-navy-light text-sm font-medium">
          Guardar PIN
        </button>
        <%= link_to "Cancelar", root_path, class: "px-4 py-2 text-sm text-gray-600 hover:text-gray-900" %>
      </div>
    <% end %>
  <% end %>
</div>
