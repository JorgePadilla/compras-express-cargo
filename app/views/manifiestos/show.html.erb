<div id="flash-messages"></div>

<%= render PageHeaderComponent.new(title: @manifiesto.numero, subtitle: "Manifiesto") do |header|
  # C30-06 · Con el manifiesto finalizado y todavía reabrible, este botón se
  # esconde: la puerta es el «Editar» del cartel de bloqueado, que abre todo
  # y no solo el encabezado. Dos «Editar» en la misma pantalla haciendo cosas
  # distintas es lo que no tiene que pasar.
  #
  # PR-C30.14 · Este lleva a /edit, que ahora es el manifiesto **entero**
  # (encabezado, San Pedro, casas y paquetes). Con la edición abierta, o con
  # el manifiesto todavía armándose, sale; cerrado y reabrible, no. Desde que
  # los recibidos también se reabren, «cerrado y no reabrible» es solo el
  # interno ya finalizado, y para él queda este, el de C21-06, para corregir
  # el encabezado.
  unless @manifiesto.bloqueado? && @manifiesto.reabrible? && !@manifiesto.edicion_abierta?
    header.with_action do
      render ButtonComponent.new(variant: :outline_navy, href: edit_manifiesto_path(@manifiesto), icon: "pencil-square", shortcut: "F6") do
        "Editar"
      end
    end
  end
  # C21-09 · El manifiesto impreso. Desde C30-05 es también lo que saca
  # «Finalizar e Imprimir» (antes sacaba las 4×6 de los bultos); este botón
  # sirve para re-imprimirlo, antes o después de finalizar.
  #
  # C29-11 · Con `print: true`, como «Imprimir listado» (`C28-02`): abre el
  # diálogo de impresión solo. Sin él la hoja se abría como página y nada
  # más, y Yusef la buscó: *"no tiene el botón de imprimir a la mano… no lo
  # tiró como preview para imprimir"*, mientras que el listado, al lado,
  # *"a éste sí salió bien"*.
  #
  # PR-C29.7 · Y con `cerrar: 1`: la hoja se abre en pestaña nueva, imprime, y
  # al terminar **se cierra**, como las 4×6. Antes quedaba abierta y la ficha
  # se perdía atrás. Jorge: *"una vez se imprime se regresa a la vista
  # previa"*.
  header.with_action do
    render ButtonComponent.new(variant: :outline_navy, href: documento_manifiesto_path(@manifiesto, print: true, cerrar: 1),
                               icon: "printer", target: "_blank", shortcut: "F4") do
      "Imprimir manifiesto"
    end
  end
  # C29-08 · El modal de sonidos, que esta pantalla de escaneo no tenía:
  # acá se elige con qué suena el tipo distinto y la sucursal distinta.
  header.with_back do
    render ButtonComponent.new(variant: :ghost, href: manifiestos_path, icon: "arrow-left", shortcut: "F2") do
      "Volver"
    end
  end
end %>

<%# Manifest details card %>
<div class="bg-white rounded-lg shadow overflow-hidden mb-6">
  <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
    <h2 class="text-lg font-semibold text-gray-800">Detalles del Manifiesto</h2>
    <%= render StatusBadgeComponent.new(status: @manifiesto.estado) %>
  </div>
  <div class="p-6 grid grid-cols-1 md:grid-cols-3 gap-6">
    <div>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Numero</dt>
      <dd class="mt-1 text-sm font-mono font-medium text-cec-navy"><%= @manifiesto.numero %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Empresa</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @manifiesto.empresa_manifiesto&.nombre || "—" %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">T. envío del proveedor</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @manifiesto.tipo_envio_del_proveedor || "—" %></dd>
    </div>
    <%# C21-03: los NUESTROS, que son los que deciden qué paquetes salen. %>
    <div>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">T. envío nuestros</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @manifiesto.tipos_envio_nuestros.presence || "—" %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Consignatario</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @manifiesto.consignatario&.nombre || "—" %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Se entrega en</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @manifiesto.sucursal_entrega&.nombre || "—" %></dd>
    </div>
    <%# C21-11: son varias, y las llena San Pedro Sula después. %>
    <div>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Guías del proveedor</dt>
      <dd class="mt-1 text-sm font-mono text-gray-900"><%= @manifiesto.numeros_de_guia.join(" · ").presence || "—" %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Recibido en Honduras</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= fecha_y_quien(@manifiesto.fecha_aduana, @manifiesto.recibido_hn_por) || "—" %></dd>
    </div>
    <div>
      <%# RP-59 · Lo estampa el sistema al crear, con las iniciales de quien lo
          creó. Los manifiestos viejos que se crearon antes de esto pueden no
          tenerlo, y ahí cae al usuario. %>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Expedido Por</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @manifiesto.expedido_por.presence || @manifiesto.user&.iniciales_display || "—" %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Paquetes</dt>
      <dd class="mt-1 text-sm font-semibold text-gray-900"><%= @manifiesto.cantidad_paquetes %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Peso Total</dt>
      <dd class="mt-1 text-sm font-semibold text-gray-900"><%= @manifiesto.peso_total || 0 %> lbs</dd>
    </div>
    <div>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Fecha Enviado</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @manifiesto.fecha_enviado&.strftime("%d/%m/%Y %H:%M") || "—" %></dd>
    </div>
    <% if @manifiesto.es_prioridad? %>
      <div>
        <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Prioridad</dt>
        <dd class="mt-1"><span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-cec-gold/20 text-cec-navy">ES PRIORIDAD</span></dd>
      </div>
    <% end %>
  </div>
</div>

<%# ── La pantalla sigue el orden del trabajo ────────────────────────────────

    Jorge, mirándola: *"no estoy seguro que siga el orden del flujograma"*, y
    tenía razón — **«Finalizar» estaba arriba de todo lo que hay que hacer
    antes**, y los pasos reales quedaban debajo. La página iba al revés.

    Ahora va: detalles → casas → agregar paquetes → los paquetes → finalizar.

    Los cierres van **arriba y abajo**, que es lo que pidió: *"solo finalizar y
    finalizar e imprimir también debería estar abajo"*. Es la misma razón por la
    que la barra de atajos de `/etiquetar` está en los dos lados —Yusef:
    *"estos botones los dejaste abajo y a veces se ocupan acá arriba"*—: con la
    tabla llena, el de arriba queda a una pantalla de distancia. %>
<div id="manifiesto-acciones-arriba">
  <%= render "manifiestos/acciones", manifiesto: @manifiesto, paquetes: @paquetes %>
</div>

<%# PR-C30.14 · Casas, agregar paquetes, sacarlos y la tabla: lo mismo que
    pinta /edit, del mismo partial. %>
<%= render "manifiestos/contenido", manifiesto: @manifiesto, paquetes: @paquetes %>

<%# Los cierres, otra vez — acá es donde uno **termina**. Con la tabla llena, el
    bloque de arriba queda a una pantalla de distancia. %>
<div id="manifiesto-acciones-abajo" class="mt-6">
  <%= render "manifiestos/acciones", manifiesto: @manifiesto, paquetes: @paquetes %>
</div>

<%= render "shared/bitacora", record: @manifiesto, label: "Manifiesto" %>
