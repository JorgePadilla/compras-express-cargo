<div id="flash-messages"></div>

<%= render PageHeaderComponent.new(title: @manifiesto.numero, subtitle: "Manifiesto") do |header|
  header.with_action do
    render ButtonComponent.new(variant: :secondary, href: edit_manifiesto_path(@manifiesto), icon: "pencil-square", shortcut: "F6") do
      "Editar"
    end
  end
  # C21-09 · El manifiesto impreso. Va aparte de «Finalizar e Imprimir», que
  # saca las etiquetas 4×6 de los bultos: son dos papeles distintos.
  header.with_action do
    render ButtonComponent.new(variant: :secondary, href: documento_manifiesto_path(@manifiesto),
                               icon: "printer", target: "_blank") do
      "Imprimir manifiesto"
    end
  end
  header.with_action do
    render ButtonComponent.new(variant: :ghost, href: manifiestos_path, icon: "arrow-left") do
      "Volver"
    end
  end
end %>

<%# Manifest details card %>
<div class="bg-white rounded-lg shadow overflow-hidden mb-6">
  <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
    <h2 class="text-lg font-semibold text-gray-800">Detalles del Manifiesto</h2>
    <%= render StatusBadgeComponent.new(status: @manifiesto.estado) %>
  </div>
  <div class="p-6 grid grid-cols-1 md:grid-cols-3 gap-6">
    <div>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Numero</dt>
      <dd class="mt-1 text-sm font-mono font-medium text-cec-navy"><%= @manifiesto.numero %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Empresa</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @manifiesto.empresa_manifiesto&.nombre || "—" %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">T. envío del proveedor</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @manifiesto.tipo_envio_del_proveedor || "—" %></dd>
    </div>
    <%# C21-03: los NUESTROS, que son los que deciden qué paquetes salen. %>
    <div>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">T. envío nuestros</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @manifiesto.tipos_envio_nuestros.presence || "—" %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Consignatario</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @manifiesto.consignatario&.nombre || "—" %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Se entrega en</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @manifiesto.sucursal_entrega&.nombre || "—" %></dd>
    </div>
    <%# C21-11: son varias, y las llena San Pedro Sula después. %>
    <div>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Guías del proveedor</dt>
      <dd class="mt-1 text-sm font-mono text-gray-900"><%= @manifiesto.numeros_de_guia.join(" · ").presence || "—" %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Recibido en Honduras</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @manifiesto.fecha_aduana&.strftime("%d/%m/%Y") || "—" %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Expedido Por</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @manifiesto.expedido_por.presence || "—" %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Paquetes</dt>
      <dd class="mt-1 text-sm font-semibold text-gray-900"><%= @manifiesto.cantidad_paquetes %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Peso Total</dt>
      <dd class="mt-1 text-sm font-semibold text-gray-900"><%= @manifiesto.peso_total || 0 %> lbs</dd>
    </div>
    <div>
      <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Fecha Enviado</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @manifiesto.fecha_enviado&.strftime("%d/%m/%Y %H:%M") || "—" %></dd>
    </div>
    <% if @manifiesto.es_prioridad? %>
      <div>
        <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Prioridad</dt>
        <dd class="mt-1"><span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-cec-gold/20 text-cec-navy">ES PRIORIDAD</span></dd>
      </div>
    <% end %>
  </div>
</div>

<%# C21-06 · Los dos cierres de la pantalla vieja: «Solo Finalizar» y
    «Finalizar e Imprimir». Del diagrama de Yusef: *"finalizar e imprimir todos
    los paquetes con el tipo de envío nuestro seleccionado"* → todo a ENVIADO.
    Después el manifiesto queda bloqueado — *"se bloquea para que nadie lo
    toque"*— y solo se abre con el botón de editar. %>
<% if @manifiesto.creado? && @paquetes.any? %>
  <div class="mb-6 flex flex-wrap items-center gap-3">
    <%= render ButtonComponent.new(variant: :primary, icon: "check",
          href: finalizar_manifiesto_path(@manifiesto), method: :patch,
          confirm: "Se finaliza #{@manifiesto.numero}: #{@manifiesto.cantidad_paquetes} paquete(s) pasan a enviado y el manifiesto queda bloqueado. ¿Seguro?") do %>
      Solo Finalizar
    <% end %>
    <% if @manifiesto.cajas.any? %>
      <%= render ButtonComponent.new(variant: :gold, icon: "printer",
            href: finalizar_manifiesto_path(@manifiesto, imprimir: true), method: :patch,
            confirm: "Se finaliza #{@manifiesto.numero} y salen las etiquetas 4×6 de los #{@manifiesto.cajas.size} bulto(s). ¿Seguro?") do %>
        Finalizar e Imprimir
      <% end %>
    <% end %>
    <p class="text-xs text-gray-500">Pasan los paquetes de <b><%= @manifiesto.tipos_envio_nuestros %></b>.</p>
  </div>
<% elsif @manifiesto.bloqueado? %>
  <div class="mb-6 rounded-lg bg-cec-navy/5 ring-1 ring-cec-navy/20 p-4 flex flex-wrap items-center justify-between gap-3">
    <div>
      <p class="text-sm font-medium text-cec-navy">Este manifiesto está finalizado y bloqueado.</p>
      <p class="text-xs text-gray-600 mt-0.5">
        <% if @manifiesto.finalizado_por %>Lo finalizó <%= @manifiesto.finalizado_por.nombre %><% end %>
        <% if @manifiesto.finalizado_at %> el <%= @manifiesto.finalizado_at.strftime("%d/%m/%Y %H:%M") %><% end %>.
        Las guías del proveedor y la fecha de recibido en Honduras se siguen pudiendo llenar.
      </p>
    </div>
    <%= render ButtonComponent.new(variant: :secondary, icon: "pencil-square",
          href: edit_manifiesto_path(@manifiesto)) do %>Editar igual<% end %>
  </div>
<% end %>

<%# Add packages section (only for creado manifests) %>
<% if @manifiesto.creado? %>
  <div class="bg-white rounded-lg shadow overflow-hidden mb-6" data-controller="manifiesto-search"
       data-manifiesto-search-url-value="<%= search_paquetes_path %>"
       data-manifiesto-search-manifiesto-id-value="<%= @manifiesto.id %>">
    <%= render "manifiestos/cajas", manifiesto: @manifiesto %>

<div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-800">Agregar Paquetes</h2>
    </div>
    <div class="p-6">
      <div class="flex gap-3">
        <input type="text" placeholder="Buscar por tracking o número de recepción..."
               data-manifiesto-search-target="input"
               data-action="input->manifiesto-search#search"
               class="flex-1 rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal">
      </div>
      <div data-manifiesto-search-target="results" class="mt-3 hidden">
      </div>
    </div>
  </div>
<% end %>

<%# Packages table %>
<%= turbo_frame_tag "manifiesto-paquetes" do %>
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-800">Paquetes (<%= @paquetes.size %>)</h2>
    </div>

    <% if @paquetes.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tracking</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Cliente</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider hidden md:table-cell">Peso</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
              <% if @manifiesto.creado? %>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
              <% end %>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @paquetes.each do |paquete| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="text-sm font-mono text-gray-700"><%= truncate(paquete.tracking, length: 25) %></span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="text-sm text-gray-700"><%= paquete.cliente.codigo %> — <%= paquete.cliente.nombre_completo %></span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap hidden md:table-cell">
                  <span class="text-sm text-gray-700"><%= paquete.peso_cobrar || "—" %> lbs</span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <%= render StatusBadgeComponent.new(status: paquete.estado, label: estado_de(paquete)) %>
                </td>
                <% if @manifiesto.creado? %>
                  <td class="px-6 py-4 whitespace-nowrap text-right">
                    <%= link_to remove_paquete_manifiesto_path(@manifiesto, paquete_id: paquete.id),
                        data: { turbo_method: :delete, turbo_confirm: "Remover #{paquete.tracking} del manifiesto?" },
                        class: "text-red-400 hover:text-red-600" do %>
                      <%= heroicon "x-mark", variant: :outline, options: { class: "w-5 h-5 inline" } %>
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="p-6 text-center text-sm text-gray-500">
        No hay paquetes en este manifiesto
      </div>
    <% end %>
  </div>
<% end %>

<%= render "shared/bitacora", record: @manifiesto, label: "Manifiesto" %>
