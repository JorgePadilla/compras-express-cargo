<%# C21-04 · Las casas del manifiesto.
    El tamaño pre-definido pre-llena las medidas y el foco salta al peso —
    *"te ponen solo el cursor a peso, porque es lo que le vas a meter a
    ingresar, que es lo que hace falta"*—, pero las medidas quedan editables,
    porque a veces cortan la caja: *"le decimos «EH cortada»"*. %>
<div class="bg-white rounded-lg shadow mb-6" data-controller="caja-manifiesto">
  <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
    <div>
      <h2 class="text-lg font-semibold text-gray-900">Casas del manifiesto</h2>
      <p class="text-xs text-gray-500 mt-0.5">El volumen sale de alto × largo × ancho ÷ 166 — es el reporte por el que cobra el proveedor.</p>
    </div>
    <div class="flex items-center gap-3">
      <span class="text-sm text-gray-500"><%= manifiesto.cajas.size %> bulto(s)</span>
      <% if manifiesto.cajas.any? %>
        <%= render ButtonComponent.new(variant: :secondary, size: :sm, icon: "printer",
              href: etiquetas_manifiesto_cajas_path(manifiesto, print: true),
              target: "_blank") do %>Imprimir las 4×6<% end %>
        <%# C21-01 · La puerta a la pantalla de empacar, que **no tenía ninguna**.
            Existe desde que se armó el módulo, funciona y tiene tests, y hasta
            está en la tabla de pantallas de `docs/07` — pero no se llegaba a
            ella desde ningún lado: había que escribir la URL.

            Va acá y no en el encabezado de la ficha por el orden real del
            trabajo: se arman las casas, se imprimen sus etiquetas, y con esas
            etiquetas en la mano se empaca. El botón está donde está la mano.

            Las dos condiciones salen del contexto y son las correctas: `cajas.any?`
            —la pantalla de empaque no sirve sin casas y ella misma lo dice— y
            `creado?`, porque `show.html.erb` envuelve este partial entero en él. %>
        <%= render ButtonComponent.new(variant: :primary, size: :sm, icon: "qr-code",
              href: manifiesto_empacar_path(manifiesto)) do %>Empacar<% end %>
      <% end %>
    </div>
  </div>

  <div class="p-6 border-b border-gray-200">
    <%= form_with model: [ manifiesto, CajaManifiesto.new ], url: manifiesto_cajas_path(manifiesto),
                  local: true, class: "space-y-4" do |f| %>
      <div>
        <span class="block text-sm font-medium text-gray-700 mb-2">Tamaño</span>
        <% if @tamanos.any? %>
          <%# PR-U5 · Eran chips de `px-3 py-1.5` —unos 30 px— y esto se elige
              parado frente a la caja. Ahora son tarjetas de 44, con el patrón
              y la firma de selección de `docs/07`.

              Debajo del nombre van las medidas del tamaño, que es lo que hace
              falta saber para elegir; «Especificar» no las tiene a propósito y
              lo dice. Al elegir, el cursor sigue yendo al peso — eso ya estaba
              y es lo que pidió Yusef: *"te ponen solo el cursor a peso, porque
              es lo que le vas a meter a ingresar"*. %>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
            <% @tamanos.each do |tamano| %>
              <label class="cursor-pointer group">
                <%= f.radio_button :tamano_caja_id, tamano.id, class: "peer sr-only",
                      data: { caja_manifiesto_target: "tamano",
                              alto: tamano.alto, largo: tamano.largo, ancho: tamano.ancho,
                              action: "change->caja-manifiesto#elegirTamano" } %>
                <span class="block h-full min-h-11 px-3 py-3 rounded-xl border-2 border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800
                             peer-checked:border-cec-gold peer-checked:bg-cec-gold/5 peer-checked:ring-2 peer-checked:ring-cec-gold/30
                             peer-focus-visible:ring-2 peer-focus-visible:ring-cec-teal-deep
                             hover:shadow-lg hover:border-cec-gold/50 transition-all duration-200 text-center">
                  <span class="block font-bold text-base text-cec-navy dark:text-cec-gold"><%= tamano.nombre %></span>
                  <span class="block text-xs font-mono text-gray-500 dark:text-gray-400 mt-0.5">
                    <%= tamano.medidas_completas? ? "#{etiqueta_num(tamano.alto)}×#{etiqueta_num(tamano.largo)}×#{etiqueta_num(tamano.ancho)}" : "a medida" %>
                  </span>
                </span>
              </label>
            <% end %>
          </div>
        <% else %>
          <%# El link solo para quien puede: el portal se fue a Configuración
              (admin-only) el 2026-08-30, y Miami arma manifiestos sin cargar
              catálogos. Mostrárselo sería mandarlo a un redirect. %>
          <p class="text-sm text-gray-500">
            No hay tamaños cargados todavía.
            <% if can_access?(:catalogos_manifiesto) %>
              <%= link_to "Agregalos en Catálogos del Manifiesto", catalogos_manifiesto_path(tab: "tamanos"), class: "text-cec-teal-deep hover:underline" %>.
            <% else %>
              Pedile a un administrador que los cargue en Configuración.
            <% end %>
          </p>
        <% end %>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
        <div>
          <%= f.label :alto, "Alto", class: "block text-sm font-medium text-gray-600 dark:text-gray-300 mb-1" %>
          <%= f.number_field :alto, step: "0.01", min: 0, data: { caja_manifiesto_target: "alto", action: "input->caja-manifiesto#medidaCambiada" },
                class: "block w-full min-h-11 py-3 text-center text-xl font-mono rounded-lg border-gray-300 shadow-sm focus:ring-cec-teal focus:border-cec-teal" %>
        </div>
        <div>
          <%= f.label :largo, "Largo", class: "block text-sm font-medium text-gray-600 dark:text-gray-300 mb-1" %>
          <%= f.number_field :largo, step: "0.01", min: 0, data: { caja_manifiesto_target: "largo", action: "input->caja-manifiesto#medidaCambiada" },
                class: "block w-full min-h-11 py-3 text-center text-xl font-mono rounded-lg border-gray-300 shadow-sm focus:ring-cec-teal focus:border-cec-teal" %>
        </div>
        <div>
          <%= f.label :ancho, "Ancho", class: "block text-sm font-medium text-gray-600 dark:text-gray-300 mb-1" %>
          <%= f.number_field :ancho, step: "0.01", min: 0, data: { caja_manifiesto_target: "ancho", action: "input->caja-manifiesto#medidaCambiada" },
                class: "block w-full min-h-11 py-3 text-center text-xl font-mono rounded-lg border-gray-300 shadow-sm focus:ring-cec-teal focus:border-cec-teal" %>
        </div>
        <div>
          <span class="block text-sm font-medium text-gray-600 dark:text-gray-300 mb-1">Volumen</span>
          <p class="min-h-11 flex items-center justify-center text-xl font-mono text-gray-500 dark:text-gray-400" data-caja-manifiesto-target="volumen">—</p>
        </div>
        <div>
          <%= f.label :peso, "Peso (lbs)", class: "block text-sm font-medium text-gray-600 dark:text-gray-300 mb-1" %>
          <%= f.number_field :peso, step: "0.01", min: 0, data: { caja_manifiesto_target: "peso" },
                class: "block w-full min-h-11 py-3 text-center text-xl font-mono rounded-lg border-gray-300 shadow-sm focus:ring-cec-teal focus:border-cec-teal" %>
        </div>
      </div>

      <div class="flex justify-end">
        <%= render(ButtonComponent.new(variant: :primary, size: :lg, type: :submit, icon: "plus", shortcut: "F5")) { "Agregar caja" } %>
      </div>
    <% end %>
  </div>

  <% if manifiesto.cajas.any? %>
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">#</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Código</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tamaño</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">T. envío</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Medidas</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Volumen</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Peso</th>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Acciones</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% manifiesto.cajas.each_with_index do |caja, i| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 text-sm text-gray-500"><%= i + 1 %></td>
            <td class="px-4 py-3 text-sm font-mono font-medium text-cec-navy"><%= caja.codigo %></td>
            <td class="px-4 py-3 text-sm text-gray-700"><%= caja.tamano_caja&.nombre || "Especificar" %></td>
            <td class="px-4 py-3 text-sm text-gray-500"><%= caja.tipos_envio_adentro.presence || "—" %></td>
            <td class="px-4 py-3 text-sm text-right font-mono text-gray-500"><%= caja.medidas || "—" %></td>
            <td class="px-4 py-3 text-sm text-right font-mono text-gray-700"><%= caja.volumen || "—" %></td>
            <td class="px-4 py-3 text-sm text-right font-mono text-gray-700"><%= caja.peso || "—" %></td>
            <td class="px-4 py-3 text-right">
              <%= render ButtonComponent.new(variant: :secondary, size: :xs, icon: "printer",
                    href: etiqueta_manifiesto_caja_path(manifiesto, caja, print: true),
                    target: "_blank", label: "Imprimir la etiqueta de la caja #{caja.letra}") %>
              <%= render ButtonComponent.new(variant: :danger, size: :xs, icon: "trash",
                    href: manifiesto_caja_path(manifiesto, caja), method: :delete,
                    confirm: "Se elimina la caja #{caja.letra}. La letra no se reusa: si ya imprimiste su etiqueta, esa etiqueta queda sin caja. ¿Seguro?",
                    label: "Eliminar caja #{caja.letra}") %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
