<%# PR-C31.11 · Las pre-facturas del cliente, la última primero. %>
<div class="bg-white dark:bg-gray-800 rounded-lg shadow ring-1 ring-gray-200 dark:ring-gray-700 overflow-hidden">
  <% if @registros.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700" data-solapa="pre_facturas">
        <thead class="bg-gray-50 dark:bg-gray-900/40">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Número</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Fecha</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Estado</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Total</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
          <% @registros.each do |pf| %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
              <td class="px-4 py-3 whitespace-nowrap"><%= enlace_del_cliente(pf.numero, pre_factura_path(pf), :pre_facturas) %></td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400"><%= (pf.fecha_trabajo || pf.created_at).strftime("%d/%m/%Y") %></td>
              <td class="px-4 py-3 whitespace-nowrap"><%= render StatusBadgeComponent.new(status: pf.estado) %></td>
              <td class="px-4 py-3 whitespace-nowrap text-right text-sm font-medium text-gray-900 dark:text-gray-100">
                <%= pf.moneda == "USD" ? "$" : "L." %> <%= number_with_delimiter(pf.total.to_f, precision: 2) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
  <div class="px-4"><%= render PaginationComponent.new(collection: @registros, label: "pre-facturas") %></div>
</div>
