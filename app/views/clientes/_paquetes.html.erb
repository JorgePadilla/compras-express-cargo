<%# PR-C31.11 · Los paquetes del cliente, el último primero. El tracking va
    completo: es lo que SAC le lee al cliente por teléfono (Yusef, 2026-08-18:
    *"para leérselo al cliente"*). %>
<div class="bg-white dark:bg-gray-800 rounded-lg shadow ring-1 ring-gray-200 dark:ring-gray-700 overflow-hidden">
  <% if @registros.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700" data-solapa="paquetes">
        <thead class="bg-gray-50 dark:bg-gray-900/40">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Tracking</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">N° recepción</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Estado</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">T.E.</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Contenido</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Recibido</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
          <% @registros.each do |paquete| %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
              <td class="px-4 py-3 whitespace-nowrap"><%= enlace_del_cliente(paquete.tracking, paquete_path(paquete), :paquetes) %></td>
              <td class="px-4 py-3 whitespace-nowrap font-mono text-xs text-gray-600 dark:text-gray-300"><%= paquete.numero_recepcion_visible.presence || "—" %></td>
              <td class="px-4 py-3 whitespace-nowrap">
                <%= render StatusBadgeComponent.new(status: paquete.estado, label: estado_corto(paquete), title: paquete.estado.to_s.humanize) %>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600 dark:text-gray-300"><%= paquete.tipo_envio&.codigo.presence || paquete.tipo_envio&.nombre || "—" %></td>
              <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-300"><%= paquete.descripcion.presence || "—" %></td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400"><%= (paquete.fecha_recibido_miami || paquete.created_at).strftime("%d/%m/%Y") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
  <div class="px-4"><%= render PaginationComponent.new(collection: @registros, label: "paquetes") %></div>
</div>
