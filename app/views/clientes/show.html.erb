<%# C16-06: el digitador de Miami consulta la ficha y no la edita. El botón se
    va entero (lleva `shortcut: "F6"`, y el atajo global clickea cualquier
    `[data-shortcut]`). %>
<%= render PageHeaderComponent.new(title: @cliente.nombre_completo, subtitle: @cliente.codigo) do |header|
  if can_edit_clientes?
    # C33-05 · *"Es un botón en el perfil de cliente"*: las direcciones del
    # casillero, actualizadas, a su correo. Sin correo no hay a dónde.
    if @cliente.email.present?
      header.with_action do
        render ButtonComponent.new(variant: :secondary, href: enviar_casillero_cliente_path(@cliente), method: :post,
                                   icon: "envelope", confirm: "¿Enviarle a #{@cliente.email} las direcciones de su casillero?") do
          "Enviar casillero"
        end
      end
    end
    header.with_action do
      render ButtonComponent.new(variant: :secondary, href: edit_cliente_path(@cliente), icon: "pencil-square", shortcut: "F6") do
        "Editar"
      end
    end
  end
  header.with_back do
    render ButtonComponent.new(variant: :ghost, href: clientes_path, icon: "arrow-left", shortcut: "F2") do
      "Volver"
    end
  end
end %>

<%# PR-C31.11 · `C31-20`. La vista del cliente para SAC: todo lo suyo, en
    solapas. Yusef: *"si me voy a pre-factura solo me salen las de él, si me voy
    a paquetes solo me salen los de él"*. Las solapas son enlaces (no JS), como en
    Catálogos del Manifiesto: la solapa vive en la URL. %>
<div class="border-b border-gray-200 dark:border-gray-700 mb-6">
  <nav class="-mb-px flex flex-wrap gap-x-6" aria-label="Lo del cliente">
    <% [["resumen", "Resumen", nil],
        ["pre_alertas", "Pre-alertas", @conteos["pre_alertas"]],
        ["paquetes", "Paquetes", @conteos["paquetes"]],
        ["pre_facturas", "Pre-facturas", @conteos["pre_facturas"]],
        ["facturas", "Facturas", @conteos["facturas"]],
        ["correos", "Correos", @conteos["correos"]]].each do |slug, titulo, cuantos| %>
      <% activa = @solapa == slug %>
      <%= link_to cliente_path(@cliente, tab: (slug unless slug == "resumen")),
            class: "whitespace-nowrap border-b-2 py-3 px-1 text-sm font-medium #{activa ? 'border-cec-teal text-cec-teal' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'}",
            aria: { current: (activa ? "page" : nil) } do %>
        <%= titulo %>
        <% if cuantos %>
          <span class="ml-1 text-xs <%= activa ? "text-cec-teal" : "text-gray-400" %>"><%= cuantos %></span>
        <% end %>
      <% end %>
    <% end %>
  </nav>
</div>

<%= render "clientes/#{@solapa}" %>
