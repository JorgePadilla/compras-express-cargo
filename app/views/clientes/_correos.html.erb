<%# PR-C31.11 · Los correos que se le mandaron, y **lo que falló** (Yusef,
    `C31-20`). Sale de `correos_enviados`, que anota `ApplicationMailer`
    (PR-C31.10); lo de antes de esa fecha no quedó en ningún lado. El fallido va
    en rojo y con su error: es lo que SAC le explica al cliente que dice que no
    le llegó nada. %>
<div class="bg-white dark:bg-gray-800 rounded-lg shadow ring-1 ring-gray-200 dark:ring-gray-700 overflow-hidden">
  <% if @registros.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700" data-solapa="correos">
        <thead class="bg-gray-50 dark:bg-gray-900/40">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Fecha</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Asunto</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Para</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Estado</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
          <% @registros.each do |correo| %>
            <tr class="<%= correo.fallido? ? "bg-red-50 dark:bg-red-900/20" : "hover:bg-gray-50 dark:hover:bg-gray-700/50" %>" data-estado="<%= correo.estado %>">
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400"><%= correo.enviado_at.strftime("%d/%m/%Y %H:%M") %></td>
              <td class="px-4 py-3 text-sm text-gray-900 dark:text-gray-100">
                <%= correo.asunto.presence || "—" %>
                <% if correo.fallido? && correo.error.present? %>
                  <p class="mt-1 text-xs font-mono text-red-700 dark:text-red-300 break-all"><%= correo.error %></p>
                <% end %>
              </td>
              <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-300 break-all"><%= correo.para %></td>
              <td class="px-4 py-3 whitespace-nowrap">
                <% if correo.fallido? %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-700 ring-1 ring-red-600/20 dark:bg-red-900/40 dark:text-red-200">Falló</span>
                <% else %>
                  <%= render StatusBadgeComponent.new(status: "enviado", label: "Enviado") %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
  <div class="px-4"><%= render PaginationComponent.new(collection: @registros, label: "correos") %></div>
</div>
