<%# Una fila de paquete del portal.
    PR-C6.44: este partial pasa a pintar TAMBIÉN el `<template>` de las filas
    nuevas, renderizándose con `pap: PreAlertaPaquete.new` e
    `index: "NEW_INDEX"`. Antes el template era HTML escrito a mano, y por eso
    los arreglos llegaban a una de las dos copias. %>
<%= f.fields_for :pre_alerta_paquetes, pap, child_index: index do |pf| %>
  <% atributos_fila = pap.persisted? ? { id: "paquete_row_#{pap.id}" } : { data: { new_record: true } } %>
  <tr class="paquete-row" <%= tag.attributes(atributos_fila) %>>
    <% if pap.persisted? %>
      <%= pf.hidden_field :id %>
    <% end %>
    <td class="px-4 py-2">
      <% if pap.paquete_id.present? %>
        <span class="font-mono text-sm text-gray-700"><%= pap.tracking %></span>
        <%= pf.hidden_field :tracking %>
      <% elsif puede_editar?(pap) %>
        <div data-controller="tracking-input">
          <%= pf.text_field :tracking, placeholder: "Tracking (opcional)",
              pattern: "[A-Za-z0-9\\-]+",
              title: "Solo letras, números y guiones. Sin espacios ni símbolos.",
              data: { tracking_input_target: "input", action: "input->tracking-input#sanitize" },
              class: "block w-full rounded-lg border border-gray-300 px-2 py-1.5 text-sm
                     focus:outline-none focus:ring-2 focus:ring-cec-teal focus:border-cec-teal" %>
          <p data-tracking-input-target="error" class="hidden text-xs text-red-600 dark:text-red-400 mt-1"></p>
        </div>
      <% else %>
        <span class="font-mono text-sm text-gray-700"><%= pap.tracking.presence || "—" %></span>
      <% end %>
    </td>
    <td class="px-4 py-2">
      <% if puede_editar?(pap) %>
        <%= pf.text_field :descripcion, placeholder: "Descripcion",
            class: "block w-full rounded-lg border border-gray-300 px-2 py-1.5 text-sm
                   focus:outline-none focus:ring-2 focus:ring-cec-teal focus:border-cec-teal" %>
      <% else %>
        <span class="text-sm text-gray-700"><%= pap.descripcion.presence || "—" %></span>
      <% end %>
    </td>
    <td class="px-4 py-2">
      <% if puede_editar?(pap) %>
        <%= pf.text_area :instrucciones, placeholder: "Instrucciones", rows: 2,
            class: "block w-full rounded-lg border border-gray-300 px-2 py-1.5 text-sm
                   focus:outline-none focus:ring-2 focus:ring-cec-teal focus:border-cec-teal" %>
      <% else %>
        <span class="text-sm text-gray-700"><%= pap.instrucciones.presence || "—" %></span>
      <% end %>
    </td>
    <td class="px-4 py-2">
      <span class="text-sm text-gray-500"><%= pap.fecha&.strftime("%d/%m/%Y") || "—" %></span>
    </td>
    <td class="px-4 py-2 text-center">
      <% if pap.paquete_id.present? %>
        <%= render StatusBadgeComponent.new(status: pap.paquete.estado) %>
      <% else %>
        <%= render StatusBadgeComponent.new(status: "pre_alerta", label: "Pre Alerta") %>
      <% end %>
    </td>
    <td class="px-4 py-2 text-center">
      <% if !@pre_alerta.finalizado? && pap.persisted? && puede_mover?(pap) %>
        <button type="button"
                data-action="click->pre-alerta-mover#open"
                data-pap-id="<%= pap.id %>"
                data-tracking="<%= pap.tracking %>"
                class="text-cec-teal hover:text-cec-teal-dark text-xs font-medium">
          Mover
        </button>
      <% end %>
    </td>
    <td class="px-4 py-2 text-center">
      <% if puede_eliminar?(pap) %>
        <% es_ultimo_paquete = @pre_alerta.pre_alerta_paquetes.size == 1 %>
        <% sufijo_ultimo = es_ultimo_paquete ? " Es el último paquete: la pre-alerta quedará vacía y será eliminada." : "" %>
        <% if pap.persisted? && !@pre_alerta.consolidando? %>
          <%# Unlinked + not consolidando: server delete %>
          <%= button_to eliminar_paquete_cuenta_pre_alerta_path(@pre_alerta, pre_alerta_paquete_id: pap.id),
                method: :delete, class: "text-red-400 hover:text-red-600",
                data: { turbo_confirm: "¿Eliminar este paquete?#{sufijo_ultimo}" } do %>
            <%= heroicon "trash", variant: :outline, options: { class: "w-4 h-4" } %>
          <% end %>
        <% else %>
          <%# Unlinked + consolidando (or new row): JS-side remove keeps editor state.
              El `_destroy` va SOLO si la fila ya existe en la base, y eso es
              load-bearing: `removePaquete` bifurca según exista ese campo. Si
              existe, marca la fila y llama a `autosave()`; si no, la saca del
              DOM. Una fila recién agregada tiene que tomar el segundo camino —
              con el primero quedaría un <tr> escondido y un PATCH al pedo. %>
          <% if pap.persisted? %>
            <input type="hidden" name="pre_alerta[pre_alerta_paquetes_attributes][<%= index %>][_destroy]" value="0" data-pre-alerta-editor-target="destroyField">
          <% end %>
          <button type="button" data-action="click->pre-alerta-editor#removePaquete"
                  aria-label="Quitar este paquete de la pre-alerta"
                  class="rounded foco-cec text-red-500 hover:text-red-600">
            <%= heroicon "trash", variant: :outline, options: { class: "w-4 h-4" } %>
          </button>
        <% end %>
      <% end %>
    </td>
  </tr>
<% end %>
