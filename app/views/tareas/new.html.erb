<% content_for :title, "Nueva tarea" %>

<div class="max-w-5xl mx-auto space-y-6">
  <div>
    <%= link_to paquete_tareas_path(@paquete), class: "text-xs text-gray-500 hover:text-cec-teal inline-flex items-center gap-1" do %>
      <%= heroicon "arrow-left", variant: :outline, options: { class: "w-3 h-3" } %>
      Volver a tareas
    <% end %>
    <h1 class="text-2xl font-bold text-cec-navy mt-1">Nueva tarea</h1>
    <p class="text-sm text-gray-600">Paquete <span class="font-mono"><%= @paquete.tracking %></span></p>
  </div>

  <%= render "form" %>
</div>
