<% content_for :title, "Editar tarea" %>

<div class="max-w-5xl mx-auto space-y-6">
  <div>
    <%= link_to tareas_volver_path, class: "text-xs text-gray-500 hover:text-cec-teal inline-flex items-center gap-1" do %>
      <%= heroicon "arrow-left", variant: :outline, options: { class: "w-3 h-3" } %>
      <%= @paquete ? "Volver a tareas" : "Volver al cliente" %>
    <% end %>
    <h1 class="text-2xl font-bold text-cec-navy mt-1">Editar tarea</h1>
    <% if @paquete %>
      <p class="text-sm text-gray-600">Paquete <span class="font-mono"><%= @paquete.tracking %></span></p>
    <% elsif @tarea.cliente %>
      <p class="text-sm text-gray-600">
        Cliente <span class="font-mono"><%= @tarea.cliente.codigo %></span> — <%= @tarea.cliente.nombre_completo %>
      </p>
    <% end %>
  </div>

  <%= render "form" %>
</div>
