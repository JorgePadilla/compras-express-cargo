<% content_for :title, "Tareas · #{@paquete.tracking}" %>

<div class="max-w-5xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <%= link_to @paquete, class: "text-xs text-gray-500 hover:text-cec-teal inline-flex items-center gap-1" do %>
        <%= heroicon "arrow-left", variant: :outline, options: { class: "w-3 h-3" } %>
        Volver al paquete
      <% end %>
      <h1 class="text-2xl font-bold text-cec-navy mt-1">Tareas</h1>
      <p class="text-sm text-gray-600">Paquete <span class="font-mono"><%= @paquete.tracking %></span> · <%= @paquete.cliente.nombre %></p>
    </div>
    <%= link_to "Nueva tarea", new_paquete_tarea_path(@paquete),
        class: "bg-cec-teal text-white font-semibold px-4 py-2 rounded-lg text-sm hover:bg-cec-teal-dark transition-colors" %>
  </div>

  <% if @paquete.tareas_pendientes? %>
    <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-sm text-amber-800">
      Este paquete tiene tareas abiertas. No se puede avanzar su estado hasta completarlas todas.
    </div>
  <% end %>

  <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-2 text-left text-xs font-semibold text-gray-600">Título</th>
          <th class="px-4 py-2 text-left text-xs font-semibold text-gray-600">Estado</th>
          <th class="px-4 py-2 text-left text-xs font-semibold text-gray-600">Asignada a</th>
          <th class="px-4 py-2 text-left text-xs font-semibold text-gray-600">Completada</th>
          <th class="px-4 py-2 text-right text-xs font-semibold text-gray-600">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @tareas.each do |tarea| %>
          <tr>
            <td class="px-4 py-3">
              <p class="font-medium text-sm text-gray-800"><%= tarea.titulo %></p>
              <% if tarea.descripcion.present? %>
                <p class="text-xs text-gray-500 mt-0.5"><%= tarea.descripcion %></p>
              <% end %>
            </td>
            <td class="px-4 py-3">
              <% color = { "pendiente" => "bg-gray-100 text-gray-700",
                           "en_proceso" => "bg-amber-100 text-amber-800",
                           "realizada" => "bg-cec-teal/10 text-cec-teal-dark" }[tarea.estado] %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold <%= color %>">
                <%= tarea.estado.humanize %>
              </span>
            </td>
            <td class="px-4 py-3 text-sm text-gray-600">
              <%= tarea.asignado_a&.name || "—" %>
            </td>
            <td class="px-4 py-3 text-xs text-gray-500">
              <% if tarea.completada_en %>
                <%= tarea.completada_en.strftime("%d/%m/%Y %H:%M") %>
                <% if tarea.completado_por %>
                  <br><span class="text-[10px]">por <%= tarea.completado_por.name %></span>
                <% end %>
              <% else %>
                —
              <% end %>
            </td>
            <td class="px-4 py-3 text-right">
              <div class="inline-flex gap-2">
                <% if tarea.pendiente? %>
                  <%= button_to "Iniciar", iniciar_paquete_tarea_path(@paquete, tarea),
                      method: :post,
                      class: "text-xs text-cec-teal hover:text-cec-teal-dark font-semibold" %>
                <% end %>
                <% if tarea.en_proceso? || tarea.pendiente? %>
                  <%= button_to "Completar", completar_paquete_tarea_path(@paquete, tarea),
                      method: :post,
                      class: "text-xs text-cec-teal hover:text-cec-teal-dark font-semibold" %>
                <% end %>
                <% if tarea.realizada? %>
                  <%= button_to "Reabrir", reabrir_paquete_tarea_path(@paquete, tarea),
                      method: :post,
                      class: "text-xs text-gray-500 hover:text-cec-navy font-semibold" %>
                <% end %>
                <%= link_to "Editar", edit_paquete_tarea_path(@paquete, tarea),
                    class: "text-xs text-gray-500 hover:text-cec-navy font-semibold" %>
                <%= button_to "Borrar", paquete_tarea_path(@paquete, tarea),
                    method: :delete,
                    data: { turbo_confirm: "¿Eliminar esta tarea?" },
                    class: "text-xs text-red-500 hover:text-red-700 font-semibold" %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if @tareas.empty? %>
          <tr>
            <td colspan="5" class="px-4 py-8 text-center text-sm text-gray-500">
              Sin tareas asignadas. <%= link_to "Crear la primera", new_paquete_tarea_path(@paquete), class: "text-cec-teal hover:text-cec-teal-dark font-medium" %>.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
