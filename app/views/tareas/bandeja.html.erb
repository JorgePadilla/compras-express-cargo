<%# La bandeja de tareas: lo que mi área tiene abierto.

    PR-C7.40. Hasta acá las tareas solo se veían desde adentro de UN paquete
    (`/paquetes/:id/tareas`) o de UN cliente, o sea que había que saber de
    antemano dónde estaba la tarea para poder verla. Una tarea que nadie va a
    buscar no la ve nadie — y por eso tampoco estaba en el menú: no había a
    dónde apuntar.

    El filtro por área no es cosmético: sale de `Tarea.visibles_para`, la misma
    segmentación que usan las notas permanentes. Un digitador de Miami no tiene
    por qué cargar con la cola de Caja. %>
<% content_for :title, "Tareas" %>

<%# C17-01 · Jorge: *"creo que nos falta formas de agregar tareas"*. La bandeja
    nació para ver y cerrar (PR-C7.40) y mandaba a crear «desde la ficha de un
    paquete o de un cliente». Ahora se crea desde acá: cliente por autocomplete
    y tracking opcional. %>
<%= render PageHeaderComponent.new(
      title: "Tareas",
      subtitle: "#{@tareas.total_count} #{@incluir_realizadas ? 'en total' : 'abiertas'} en tu área") do |header|
  if can_crear_tareas?
    header.with_action do
      render ButtonComponent.new(variant: :gold, href: new_tarea_path, icon: "plus", shortcut: "F7") do
        "Nueva tarea"
      end
    end
  end
end %>

<div class="mb-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
  <%# Los links conservan el otro filtro: apagar uno no puede resetear el otro. %>
  <% if @solo_mias %>
    <%= link_to "Ver las de toda el área", tareas_path(realizadas: params[:realizadas]),
          class: "text-cec-teal hover:text-cec-teal-dark" %>
  <% else %>
    <%= link_to "Ver solo las mías", tareas_path(mias: "1", realizadas: params[:realizadas]),
          class: "text-cec-teal hover:text-cec-teal-dark" %>
  <% end %>

  <span class="text-gray-300 dark:text-gray-600">·</span>

  <% if @incluir_realizadas %>
    <%= link_to "Ver solo las abiertas", tareas_path(mias: params[:mias]),
          class: "text-cec-teal hover:text-cec-teal-dark" %>
  <% else %>
    <%= link_to "Incluir las ya realizadas", tareas_path(mias: params[:mias], realizadas: "1"),
          class: "text-cec-teal hover:text-cec-teal-dark" %>
  <% end %>
</div>

<% if @tareas.any? %>
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow ring-1 ring-gray-200 dark:ring-gray-700 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
        <thead class="bg-gray-50 dark:bg-gray-900">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider">Tarea</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider">Área</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider hidden md:table-cell">De quién</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider hidden lg:table-cell">Asignada a</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider">Estado</th>
            <th class="px-4 py-3 text-right text-xs font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
          <% @tareas.each do |tarea| %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/40">
              <td class="px-4 py-3">
                <p class="font-medium text-sm text-gray-800 dark:text-gray-100"><%= tarea.titulo %></p>
                <% if tarea.descripcion.present? %>
                  <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5"><%= truncate(tarea.descripcion, length: 90) %></p>
                <% end %>
              </td>
              <td class="px-4 py-3">
                <span class="text-xs text-gray-600 dark:text-gray-300"><%= tarea.departamento_label %></span>
              </td>
              <%# A dónde lleva: al paquete si lo tiene, y si no al cliente. Una
                  tarea de /etiquetar nace sin paquete —todavía no existe cuando
                  el operario escanea— y sin este fallback no se podría abrir. %>
              <td class="px-4 py-3 hidden md:table-cell">
                <% if tarea.paquete %>
                  <%= link_to paquete_tareas_path(tarea.paquete), class: "text-sm text-cec-teal hover:text-cec-teal-dark" do %>
                    <span class="font-mono"><%= tarea.paquete.tracking %></span>
                  <% end %>
                  <p class="text-xs text-gray-500 dark:text-gray-400"><%= tarea.paquete.cliente&.nombre_completo %></p>
                <% elsif tarea.cliente %>
                  <%= link_to tarea.cliente.nombre_completo, cliente_path(tarea.cliente),
                        class: "text-sm text-cec-teal hover:text-cec-teal-dark" %>
                  <p class="text-xs text-gray-500 dark:text-gray-400 font-mono"><%= tarea.cliente.codigo %></p>
                <% else %>
                  <span class="text-sm text-gray-500">—</span>
                <% end %>
              </td>
              <td class="px-4 py-3 hidden lg:table-cell">
                <span class="text-sm text-gray-700 dark:text-gray-200">
                  <%= tarea.asignado_a&.nombre || "— sin asignar —" %>
                </span>
              </td>
              <td class="px-4 py-3">
                <% estilo = { "pendiente"  => "bg-gray-100 text-gray-700",
                              "en_proceso" => "bg-amber-100 text-amber-800",
                              "realizada"  => "bg-cec-teal/10 text-cec-teal-dark" }[tarea.estado] %>
                <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium <%= estilo %>">
                  <%= tarea.estado.humanize %>
                </span>
              </td>
              <%# Marcarla hecha desde acá y no solo desde la franja de
                  /etiquetar. Es el mismo endpoint que usa el checkbox de la
                  franja, y `redirect_back` devuelve a la bandeja. Sin esto, una
                  tarea sin paquete —las que nacen en /etiquetar, donde el
                  paquete todavía no existe— solo se podía cerrar si alguien
                  volvía a escanear a ese cliente. %>
              <td class="px-4 py-3 text-right">
                <div class="flex items-center justify-end gap-2">
                  <% unless tarea.realizada? %>
                    <%= render(ButtonComponent.new(variant: :outline_teal, size: :xs, icon: "check",
                          href: completar_tarea_path(tarea), method: :post)) { "Hecha" } %>
                  <% end %>
                  <%# El lápiz va a donde la tarea está pegada, como el link de «De
                      quién»: la ruta anidada si tiene paquete, la top-level si no.
                      Las de cliente no se podían editar desde ningún lado. %>
                  <% if can_gestionar_tareas? %>
                    <%= render RowActionComponent.new(action: :edit,
                          href: tarea.paquete ? edit_paquete_tarea_path(tarea.paquete, tarea) : edit_tarea_path(tarea),
                          label: "Editar tarea") %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="mt-4">
    <%= render PaginationComponent.new(collection: @tareas, label: "tareas") %>
  </div>
<% else %>
  <%= render EmptyStateComponent.new(
        title: @solo_mias ? "No tenés tareas asignadas" : "No hay tareas abiertas en tu área",
        description: can_crear_tareas? ? "Dejá una desde acá, o desde la ficha de un paquete o de un cliente." : "Las tareas las deja el personal desde la bandeja, un paquete o un cliente.",
        icon: "clipboard-document-check") do |empty|
    if can_crear_tareas?
      empty.with_action do
        render ButtonComponent.new(variant: :gold, href: new_tarea_path, icon: "plus", shortcut: "F7") do
          "Nueva tarea"
        end
      end
    end
  end %>
<% end %>
