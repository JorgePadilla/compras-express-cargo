<%# Anidada bajo paquete, o top-level cuando la tarea es del cliente. %>
<% clases_de_campo = "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" %>
<%= form_with model: (@paquete ? [ @paquete, @tarea ] : @tarea), class: "space-y-6 max-w-2xl" do |f| %>
  <% unless @paquete %>
    <% if @tarea.cliente_id.present? %>
      <%# Viene fijo desde la ficha del cliente (`?cliente_id=`), o ya se eligió
          y el form volvió con un error: se muestra a quién apunta. %>
      <%= f.hidden_field :cliente_id %>
      <% if @tarea.cliente %>
        <div>
          <span class="block text-sm font-medium text-gray-700 mb-1">Cliente</span>
          <p class="text-sm text-gray-900 dark:text-gray-100">
            <span class="font-mono"><%= @tarea.cliente.codigo %></span> — <%= @tarea.cliente.nombre_completo %>
          </p>
        </div>
      <% end %>
    <% else %>
      <%# C17-01: `/tareas/new` a secas era un callejón sin salida — el cliente
          solo llegaba por la URL y sin él la tarea no se podía guardar. Mismo
          autocomplete que `pre_alertas/new`; el controller escribe el oculto
          al elegir. %>
      <div data-controller="client-autocomplete" data-client-autocomplete-url-value="<%= buscar_clientes_path %>">
        <%= f.label :cliente_id, "Cliente", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <div class="relative">
          <input type="text" data-client-autocomplete-target="input"
                 data-action="input->client-autocomplete#search
                              keydown->client-autocomplete#onKeydown"
                 placeholder="Buscar por código o nombre..."
                 autocomplete="off"
                 class="<%= clases_de_campo %>">
          <%= f.hidden_field :cliente_id, data: { client_autocomplete_target: "clienteId" } %>
          <div data-client-autocomplete-target="dropdown" class="hidden absolute z-10 w-full mt-1 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-600 rounded-lg shadow-lg max-h-60 overflow-y-auto"></div>
        </div>
        <p data-client-autocomplete-target="nombre" class="mt-1 text-sm text-gray-500 dark:text-gray-400 hidden"></p>
      </div>
    <% end %>

    <% if @tarea.new_record? %>
      <%# El tracking se resuelve en el servidor y la tarea cuelga de ese
          paquete (Caja 1 si es un split). Sin él, queda del cliente. %>
      <div>
        <%= label_tag "tarea_tracking", "Tracking (opcional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= text_field_tag "tarea[tracking]", params.dig(:tarea, :tracking), id: "tarea_tracking",
              placeholder: "Si es de un paquete en particular", autocomplete: "off",
              class: "#{clases_de_campo} font-mono" %>
        <p class="mt-1 text-xs text-gray-500">Con tracking, la tarea queda en ese paquete y puede bloquear su avance. Sin tracking, queda en el cliente.</p>
      </div>
    <% end %>
  <% end %>
  <% if @tarea.errors.any? %>
    <div class="p-4 bg-red-50 rounded-lg text-sm text-red-700">
      <ul class="list-disc list-inside space-y-1">
        <% @tarea.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :titulo, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :titulo, required: true,
        class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" %>
  </div>

  <div>
    <%= f.label :descripcion, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :descripcion, rows: 3,
        class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" %>
  </div>

  <div>
    <%= f.label :asignado_a_id, "Asignar a", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.collection_select :asignado_a_id, @users, :id, :nombre,
        { include_blank: "— Sin asignar —" },
        { class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" } %>
  </div>

  <%# PR-9.a: el departamento decide qué área ve la tarea en la franja de
      contexto. En blanco = la ven todas. %>
  <div>
    <%= f.label :departamento, "Área que debe verla", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.select :departamento,
        Tarea::DEPARTAMENTOS.map { |d| [ Tarea.new(departamento: d).departamento_label, d ] },
        { include_blank: "— Todas las áreas —" },
        { class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" } %>
  </div>

  <div>
    <label class="inline-flex items-start gap-2">
      <%= f.check_box :bloquea_avance, class: "mt-0.5 rounded border-gray-300 text-cec-teal focus:ring-cec-teal" %>
      <span class="text-sm text-gray-700">
        Bloquear el avance del paquete hasta completarla
        <span class="block text-xs text-gray-500">Si está marcada, el paquete no puede pasar al siguiente estado mientras la tarea siga abierta.</span>
      </span>
    </label>
  </div>

  <div>
    <%= f.label :notas, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :notas, rows: 2,
        class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" %>
  </div>

  <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-200">
    <%= link_to "Cancelar (F2)", tareas_volver_path,
        class: "text-sm text-gray-600 hover:text-gray-900", data: { shortcut: "F2" } %>
    <%= f.submit @tarea.persisted? ? "Guardar" : "Crear tarea",
        class: "bg-cec-gold text-cec-navy-dark font-semibold px-4 py-2 rounded-lg text-sm" %>
  </div>
<% end %>
