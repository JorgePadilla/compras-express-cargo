<%= render PageHeaderComponent.new(title: "Entrega Personal", subtitle: "Paquetes traídos físicamente al mostrador") do |header|
  header.with_action do
    tag.span(class: "inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400") do
      safe_join([
        tag.span("Hoy:"),
        tag.span(id: "paquetes-counter", class: "font-bold text-cec-navy dark:text-cec-gold text-lg") { @paquetes_hoy.to_s }
      ])
    end
  end
  header.with_action { render "shared/sonido_config" }
end %>

<div data-controller="entrega-personal audio"
     data-audio-enabled-value="<%= Current.user&.sonido_habilitado != false %>"
     data-audio-volumen-value="<%= Current.user&.sonido_volumen || 60 %>"
     data-action="entrega-personal:success->audio#success
                  click@document->entrega-personal#clickOutsideDropdown">

  <%# Flash messages %>
  <div id="flash-messages" class="mb-4">
    <% if flash[:notice] %>
      <div class="p-3 bg-cec-teal/10 text-cec-teal-dark border border-cec-teal/30 rounded-lg text-sm" data-controller="auto-dismiss"><%= flash[:notice] %></div>
    <% end %>
    <% if flash[:alert] %>
      <div class="p-3 bg-red-50 text-red-700 border border-red-200 rounded-lg text-sm" data-controller="auto-dismiss"><%= flash[:alert] %></div>
    <% end %>
  </div>

  <%# Info banner — explica el flujo al digitador %>
  <div class="mb-4 p-4 bg-cec-navy/5 dark:bg-cec-navy/20 border border-cec-navy/20 dark:border-cec-navy/40 rounded-lg">
    <div class="flex items-start gap-2">
      <%= heroicon "information-circle", variant: :solid, options: { class: "w-5 h-5 text-cec-navy dark:text-cec-gold shrink-0 mt-0.5" } %>
      <div class="text-sm text-gray-700 dark:text-gray-200">
        Este flujo registra paquetes que el cliente trajo en persona al mostrador (sin tracking del courier).
        El sistema genera automáticamente un tracking <span class="font-mono font-semibold">EP-AÑO-SUC-PROV-NNNNNN</span>
        al guardar — no hace falta escanear nada.
      </div>
    </div>
  </div>

  <%# PR-9.b: pantalla partida igual que /etiquetar — formulario izquierda,
      franja de contexto derecha. %>
  <div class="grid grid-cols-1 xl:grid-cols-12 gap-6 items-start">
  <div class="xl:col-span-8">

  <%= form_with model: @paquete, url: entrega_personal_index_path,
                data: { entrega_personal_target: "form" },
                class: "bg-white dark:bg-gray-800 rounded-lg shadow ring-1 ring-gray-200 dark:ring-gray-700 overflow-hidden" do |f| %>
    <% if @paquete.errors.any? %>
      <div class="m-6 p-4 bg-red-50 dark:bg-red-900/30 rounded-lg">
        <div class="flex items-center gap-2 mb-2">
          <%= heroicon "exclamation-triangle", variant: :outline, options: { class: "w-5 h-5 text-red-600" } %>
          <h3 class="text-sm font-medium text-red-800 dark:text-red-200">Se encontraron <%= @paquete.errors.count %> error(es):</h3>
        </div>
        <ul class="list-disc list-inside text-sm text-red-700 dark:text-red-300 space-y-1">
          <% @paquete.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="px-6 py-4 space-y-6">

      <%# Sección 1: Proveedor EP + Sucursal — define el prefijo del tracking %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <%# Yusef: "aqui es proveedor y aqui es el driver" — el proveedor es la
              EMPRESA que mando el paquete ("viene Walmart y te manda el driver").
              El driver es la persona y vive en su propio campo, mas abajo. %>
          <%= f.label :proveedor_id, "Proveedor", class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>
          <% if @proveedores_ep.any? %>
            <%= f.collection_select :proveedor_id, @proveedores_ep, :id, :nombre,
                { include_blank: "— Seleccionar proveedor EP —" },
                { autofocus: true,
                  class: "block w-full rounded-lg border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" } %>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
              ¿Falta un proveedor? Agregalo en <%= link_to "Proveedores", proveedores_path, class: "text-cec-teal hover:underline" %>.
            </p>
          <% else %>
            <p class="text-sm text-amber-700 dark:text-amber-300 italic">
              No hay proveedores de tipo "entrega_personal" configurados.
              Pedile a un admin que los cargue en <%= link_to "Proveedores", proveedores_path, class: "underline" %>.
            </p>
          <% end %>
        </div>
        <div>
          <%= f.label :sucursal_id, "Sucursal de Miami", class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>
          <% if @sucursales_miami.any? %>
            <%= f.collection_select :sucursal_id, @sucursales_miami, :id, :nombre,
                { include_blank: "— Seleccionar sucursal —" },
                { class: "block w-full rounded-lg border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" } %>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Determina el código de sucursal (SMI, etc.) en el tracking generado.</p>
          <% else %>
            <p class="text-sm text-amber-700 dark:text-amber-300 italic">
              No hay sucursales de Miami con código EP configurado.
            </p>
          <% end %>
        </div>
      </div>

      <%# Sección 2: Cliente + Tipo de Envío %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="relative">
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1">Cliente</label>
          <%# PR-C6.32: mismo cableado que /etiquetar — `keydown` es lo que
              habilita flechas y Enter sobre el preseleccionado. Sin él, el
              dropdown solo se podía usar con el mouse. %>
          <input type="text" placeholder="Buscar por código o nombre..."
                 data-entrega-personal-target="clienteInput"
                 data-action="input->entrega-personal#searchCliente
                              keydown->entrega-personal#clienteKeydown"
                 autocomplete="off"
                 class="block w-full rounded-lg border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal">
          <%= f.hidden_field :cliente_id, data: { entrega_personal_target: "clienteId" } %>
          <div data-entrega-personal-target="clienteDropdown"
               class="hidden absolute z-10 mt-1 w-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-600 rounded-lg shadow-lg max-h-60 overflow-y-auto"></div>
          <p data-entrega-personal-target="clienteNombre" class="hidden text-sm font-medium text-gray-700 dark:text-gray-200 mt-1"></p>
        </div>
        <div>
          <%= f.label :tipo_envio_id, "Tipo de Envío", class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>
          <%# PR-C6.41: el cobro solo-volumétrico es por servicio, así que
              cambiar este select puede cambiar el peso a cobrar. El select vive
              fuera del panel de cálculo, por eso el controller de la pantalla
              le reescribe el valor. %>
          <%= f.collection_select :tipo_envio_id, @tipo_envios, :id, :nombre,
              { include_blank: "— Seleccionar —" },
              { data: { action: "change->entrega-personal#cambioTipoEnvio" },
                class: "block w-full rounded-lg border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" } %>
        </div>
      </div>

      <%# Sección 3: Peso, medidas y cálculo — partial compartido con /etiquetar.
          En EP además muestra el valor a pagar (PR-10.b). %>
      <%# `tipo_envio_id` arranca del objeto y no en blanco: en un form nuevo el
          select viene vacío y el `change` lo va a llenar, pero en el re-render
          de un error el select vuelve lleno y ese `change` ya no ocurre — un
          cliente con cobro solo-volumétrico mostraría el peso viejo. %>
      <%= render "shared/peso_medidas_calc", f: f,
            valor_a_pagar: true, cotizador_url: cotizador_path,
            tipo_envio_id: f.object.tipo_envio_id %>

      <%# Sección 4: Contenido + Remitente + Driver %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="md:col-span-2">
          <%= f.label :descripcion, "Contenido", class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>
          <%= f.text_area :descripcion, rows: 2, placeholder: "Descripción del contenido…",
              class: "block w-full rounded-lg border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" %>
        </div>
        <div>
          <%= f.label :remitente, "Remitente / Quien lo envía", class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>
          <%= f.text_field :remitente, placeholder: "Nombre del remitente",
              class: "block w-full rounded-lg border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" %>
        </div>
        <div>
          <%# "Igual otro driver para poner el nombre del driver, en caso de
              tenerlo, por el rótulo." Texto libre y no catálogo: cambia en cada
              entrega — "es donde tiene que ser editable, que es el driver". %>
          <%= f.label :driver, "Driver / Quien lo trajo", class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>
          <%= f.text_field :driver, placeholder: "Nombre del conductor (opcional)",
              class: "block w-full rounded-lg border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" %>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Se imprime en la etiqueta.</p>
        </div>
      </div>

      <%# Sección 5: Pago — pre-pagado en Miami o se cobra en Honduras %>
      <div class="rounded-lg ring-1 ring-cec-teal/30 bg-cec-teal/5 dark:bg-cec-teal/10 dark:ring-cec-teal/40 px-4 py-3">
        <p class="text-sm font-semibold text-cec-teal-dark dark:text-cec-teal-light mb-2">
          <%= heroicon "currency-dollar", variant: :solid, options: { class: "w-4 h-4 inline mr-1" } %>
          Pago
        </p>
        <div class="space-y-2">
          <label class="flex items-start gap-2 cursor-pointer">
            <%= radio_button_tag "paquete[prepagado_miami]", "0", true,
                class: "mt-1 border-gray-300 text-cec-teal focus:ring-cec-teal" %>
            <div>
              <span class="text-sm font-medium text-gray-700 dark:text-gray-200">Cobrar en Honduras al entregar (default)</span>
              <p class="text-xs text-gray-500 dark:text-gray-400">Sigue el flujo normal: PreFactura → Factura cuando llegue.</p>
            </div>
          </label>
          <label class="flex items-start gap-2 cursor-pointer">
            <%= radio_button_tag "paquete[prepagado_miami]", "1", false,
                class: "mt-1 border-gray-300 text-cec-teal focus:ring-cec-teal" %>
            <div>
              <span class="text-sm font-medium text-gray-700 dark:text-gray-200">Pagado aquí en Miami</span>
              <p class="text-xs text-gray-500 dark:text-gray-400">
                Sin factura formal. La etiqueta muestra "PREPAGADO EN MIAMI" y Honduras hace factura simbólica editable al recibir.
              </p>
            </div>
          </label>
        </div>
      </div>

      <%# Sección 6: Notas internas %>
      <div>
        <%= f.label :notas_internas, "Notas Internas", class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>
        <%= f.text_area :notas_internas, rows: 2, placeholder: "Notas internas del paquete…",
            class: "block w-full rounded-lg border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" %>
      </div>

      <%# PR-C6.31: acá vivía un `hidden_field :cantidad_paquetes, value: 1`,
          resto del modal de F9. Como quedaba DESPUÉS del partial compartido,
          había dos campos con el mismo `name` y Rails se quedaba con el
          último: el operario ponía 3 cajas, veía las 3 filas, las llenaba, y
          se grababa **un solo paquete**. Sin error y sin aviso.

          La cantidad ahora se pregunta una sola vez, en el campo visible
          "Cant. Cajas" del partial — igual que en /etiquetar desde que Jorge
          reportó que "el F9 era como confuso". %>
    </div>

    <%# Action bar (PR-7) — ButtonComponent muestra el atajo inline.
        `shortcut_label_only`: esta pantalla ya escucha F2/F9 en su propio
        Stimulus, asi que el handler global no debe tambien clickear el boton
        (PR-10.c — el doble disparo reventaba el <dialog> de cajas). %>
    <div class="px-6 py-4 bg-gray-50 dark:bg-gray-900 border-t border-gray-200 dark:border-gray-700 flex items-center justify-end gap-3">
      <%# render(...) con paréntesis: si no, el bloque `{ "..." }` se asocia a
          ButtonComponent.new (no a render) y el texto se pierde. %>
      <%= render(ButtonComponent.new(variant: :primary, size: :md,
            shortcut: "F2", shortcut_label_only: true,
            data: { action: "click->entrega-personal#clearForm" })) { "Limpiar" } %>
      <%= render(ButtonComponent.new(variant: :gold, size: :md,
            icon: "printer", shortcut: "F9", shortcut_label_only: true,
            data: { action: "click->entrega-personal#submitFormWithPrint" })) { "Guardar + Imprimir" } %>
    </div>
  <% end %>

  </div><%# /columna izquierda %>

    <%# ── Franja de contexto (PR-9.b) ── %>
    <aside class="xl:col-span-4 xl:sticky xl:top-4" data-entrega-personal-target="panel"
           data-panel-url="<%= panel_contexto_path %>">
      <%= turbo_frame_tag "panel_contexto", src: panel_contexto_path, loading: :lazy do %>
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow ring-1 ring-gray-200 dark:ring-gray-700 px-4 py-10 text-center">
          <p class="text-sm text-gray-400 dark:text-gray-500">Cargando contexto…</p>
        </div>
      <% end %>
    </aside>
  </div><%# /grid %>

<%# PR-C6.31: acá vivía el modal "¿Cuántas cajas?" que abría F9. Preguntaba
    lo mismo que el campo visible "Cant. Cajas" del formulario, arrancando
    siempre en 1 y pisando lo que el operario ya había escrito. Es el mismo
    modal que se sacó de /etiquetar cuando Jorge dijo que "el F9 era como
    confuso". Ahora F9 es solo guardar e imprimir. %>

  <%# Turbo stream events container %>
  <div id="entrega-personal-events"></div>
</div>
