<%# C21-08 · El envoltorio de los cuatro formularios de catálogo: errores,
    botonera y las teclas de siempre. Los campos propios de cada uno llegan por
    bloque, así el envoltorio no se copia cuatro veces. %>
<%= form_with model: registro, url: url, local: true,
              class: "space-y-4 bg-white rounded-lg shadow p-6" do |f| %>
  <% if registro.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-3 text-sm text-red-700">
      <ul class="list-disc list-inside">
        <% registro.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= yield f %>

  <label class="flex items-center gap-2">
    <%= f.check_box :activo, class: "rounded border-gray-300 text-cec-teal focus:ring-cec-teal" %>
    <span class="text-sm font-medium text-gray-700">Activo</span>
  </label>

  <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-200">
    <%= link_to "Cancelar (F2)", catalogos_manifiesto_path(tab: tab),
        class: "text-sm text-gray-600 hover:text-gray-900", data: { shortcut: "F2" } %>
    <%= render(ButtonComponent.new(variant: :gold, type: :submit, shortcut: "F10")) { registro.persisted? ? "Guardar" : "Crear" } %>
  </div>
<% end %>
