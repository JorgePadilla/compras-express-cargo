<%# C21-08 · «Que todo esté ahí, porque así uno no tiene que andar buscando».
    Cuatro catálogos, una sola pantalla. Las solapas son enlaces (no JS): el
    estado vive en la URL, así que volver de crear o editar cae en la solapa
    correcta sin que nadie recuerde nada. %>
<%= render PageHeaderComponent.new(title: "Catálogos del Manifiesto",
                                   subtitle: "Las listas que llena el manifiesto: quién lo mueve, a quién va, y en qué cajas") %>

<div class="border-b border-gray-200 mb-6">
  <nav class="-mb-px flex flex-wrap gap-x-6" aria-label="Catálogos">
    <% [["empresas", "Empresas proveedoras", @empresas.size],
        ["tipos_proveedor", "Tipo de envío del proveedor", @tipos_proveedor.size],
        ["consignatarios", "Consignatarios", @consignatarios.size],
        ["tamanos", "Tamaños de caja", @tamanos.size]].each do |slug, titulo, cuantos| %>
      <% activa = @solapa == slug %>
      <%= link_to catalogos_manifiesto_path(tab: slug),
            class: "whitespace-nowrap border-b-2 py-3 px-1 text-sm font-medium #{activa ? 'border-cec-teal text-cec-teal' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'}",
            aria: { current: (activa ? "page" : nil) } do %>
        <%= titulo %>
        <span class="ml-1 text-xs <%= activa ? "text-cec-teal" : "text-gray-400" %>"><%= cuantos %></span>
      <% end %>
    <% end %>
  </nav>
</div>

<% case @solapa
   when "empresas" %>
  <%= render "catalogos_manifiesto/empresas" %>
<% when "tipos_proveedor" %>
  <%= render "catalogos_manifiesto/tipos_proveedor" %>
<% when "consignatarios" %>
  <%= render "catalogos_manifiesto/consignatarios" %>
<% when "tamanos" %>
  <%= render "catalogos_manifiesto/tamanos" %>
<% end %>
