<!DOCTYPE html>
<html lang="es" class="h-full <%= html_theme_class %>" data-theme="<%= current_theme %>">
  <head>
    <script>
      (function() {
        var t = document.documentElement.dataset.theme;
        if (t === "auto" && window.matchMedia("(prefers-color-scheme: dark)").matches) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
    <title><%= content_for(:title) || "Compras Express Cargo" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="UTF-8">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <% u = Current.user %>
  <% sidebar_collapsed_init = u ? (u.sidebar_collapsed && !u.sidebar_pinned) : true %>
  <% sidebar_pinned_init    = u ? u.sidebar_pinned    : false %>
  <% sidebar_position_init  = u ? u.sidebar_position  : "left" %>
  <% body_classes = [
       "h-full bg-slate-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100",
       (sidebar_collapsed_init ? "sidebar-collapsed" : nil),
       (sidebar_pinned_init    ? "sidebar-pinned"    : nil),
       (sidebar_position_init == "right" ? "sidebar-right" : nil)
     ].compact.join(" ") %>
  <body class="<%= body_classes %>" data-controller="keyboard-shortcuts">
    <% if authenticated? %>
      <div class="flex h-full">
        <%# ========== SIDEBAR ==========
            Hover-expand: arranca colapsado (w-16) en desktop. Hover quita
            `is-collapsed` → expande a w-64. Si está pinned, no auto-colapsa.
            Cuando expanded sin pin, queda fixed con shadow para overlay
            sobre el main. Mobile: comportamiento drawer con -translate-x-full. %>
        <aside id="sidebar"
          data-controller="sidebar"
          data-sidebar-url-value="<%= preferencia_sidebar_path %>"
          data-sidebar-collapsed-value="<%= sidebar_collapsed_init %>"
          data-sidebar-pinned-value="<%= sidebar_pinned_init %>"
          data-sidebar-position-value="<%= sidebar_position_init %>"
          data-action="mouseenter->sidebar#expand mouseleave->sidebar#collapse"
          class="fixed inset-y-0 left-0 z-40 w-64 sidebar-gradient text-white
                 transform -translate-x-full transition-all duration-200 ease-out
                 lg:translate-x-0 lg:z-30 flex flex-col
                 <%= sidebar_collapsed_init ? 'is-collapsed lg:w-16' : 'lg:w-64' %>
                 <%= sidebar_pinned_init    ? 'is-pinned'   : '' %>
                 <%= sidebar_position_init == 'right' ? 'is-right lg:left-auto lg:right-0' : '' %>
                 <%= sidebar_pinned_init ? 'lg:static' : 'lg:fixed lg:shadow-2xl lg:shadow-cec-navy/30' %>"
          data-sidebar-target="menu">

          <%# Logo: expandido muestra texto completo; colapsado muestra
              un badge circular gold con "CEC" centrado para dar
              jerarquía visual al top del rail. %>
          <div class="border-b border-white/10 transition-all duration-200">
            <%= link_to root_path, class: "block" do %>
              <%# Expanded label %>
              <div class="sidebar-label p-4">
                <h1 class="text-xl font-bold text-white whitespace-nowrap">Compras Express</h1>
                <p class="text-xs text-gray-400 whitespace-nowrap">Sistema de Carga</p>
              </div>
              <%# Collapsed badge %>
              <div class="sidebar-icon-only hidden p-3 flex justify-center">
                <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-cec-gold-gradient text-cec-navy-dark font-bold text-xs shadow-md ring-2 ring-white/10">
                  CEC
                </span>
              </div>
            <% end %>
          </div>

          <%# Navigation %>
          <nav class="flex-1 overflow-y-auto py-4">
            <%= render "layouts/sidebar_admin" %>
          </nav>

          <%# Footer: usuario + acciones (pin / position toggle / logout) %>
          <div class="p-3 border-t border-white/10 space-y-2">
            <div class="text-xs text-gray-400 sidebar-label whitespace-nowrap overflow-hidden">
              <%= Current.user.nombre_completo %>
              <span class="block text-gray-500"><%= Current.user.rol.humanize %></span>
            </div>

            <%# Wrapper con clase `sidebar-footer-buttons` — el CSS
                colapsado lo cambia a `flex-col` para apilar los 3
                botones verticalmente en el rail de 64px. %>
            <div class="sidebar-footer-buttons flex items-center justify-between gap-1">
              <%# Pin/unpin — oculto cuando colapsado para liberar el rail.
                  Accesible al expandir (hover o pinned). %>
              <button type="button"
                      data-action="click->sidebar#togglePin"
                      data-sidebar-target="pinIcon"
                      class="sidebar-collapsed-hide p-1.5 rounded-md text-gray-300 hover:text-white hover:bg-white/10 transition-colors"
                      title="<%= sidebar_pinned_init ? 'Desfijar sidebar' : 'Fijar sidebar' %>"
                      aria-pressed="<%= sidebar_pinned_init %>">
                <%= heroicon "bookmark", variant: :solid, options: { class: "w-4 h-4 sidebar-pin-on hidden" } %>
                <%= heroicon "bookmark", variant: :outline, options: { class: "w-4 h-4 sidebar-pin-off" } %>
              </button>

              <%# Toggle position left/right — oculto cuando colapsado. %>
              <button type="button"
                      data-action="click->sidebar#togglePosition"
                      data-sidebar-target="positionIcon"
                      class="sidebar-collapsed-hide p-1.5 rounded-md text-gray-300 hover:text-white hover:bg-white/10 transition-colors"
                      title="<%= sidebar_position_init == 'right' ? 'Mover a la izquierda' : 'Mover a la derecha' %>">
                <%= heroicon "arrows-right-left", variant: :outline, options: { class: "w-4 h-4" } %>
              </button>

              <%# Logout %>
              <%= link_to session_path, data: { turbo_method: :delete },
                  class: "flex-1 flex items-center justify-center gap-2 p-1.5 rounded-md text-red-400 hover:text-red-300 hover:bg-red-500/10 text-sm transition-colors",
                  title: "Cerrar sesión" do %>
                <%= heroicon "arrow-right-start-on-rectangle", variant: :outline, options: { class: "w-4 h-4 shrink-0" } %>
                <span class="sidebar-label">Salir</span>
              <% end %>
            </div>
          </div>
        </aside>

        <%# Backdrop (mobile) %>
        <div class="fixed inset-0 bg-black/50 z-30 hidden lg:hidden"
          data-sidebar-target="backdrop"
          data-action="click->sidebar#close">
        </div>

        <%# ========== MAIN CONTENT ==========
            Compensa el ancho del sidebar pinned con margin (ml-64 izq o
            mr-64 der). Cuando NO está pinned, el sidebar es overlay y el
            margin es solo el ancho de los íconos colapsados (16). %>
        <main class="flex-1 flex flex-col min-h-screen overflow-x-hidden transition-all duration-200
                     <%= 'lg:ml-16'  if sidebar_position_init == 'left'  && !sidebar_pinned_init %>
                     <%= 'lg:ml-64'  if sidebar_position_init == 'left'  && sidebar_pinned_init %>
                     <%= 'lg:mr-16'  if sidebar_position_init == 'right' && !sidebar_pinned_init %>
                     <%= 'lg:mr-64'  if sidebar_position_init == 'right' && sidebar_pinned_init %>">
          <%# Top bar (mobile) %>
          <header class="bg-white dark:bg-gray-800 shadow-sm px-4 py-3 flex items-center justify-between lg:hidden">
            <button data-action="click->sidebar#toggle" class="text-gray-600 dark:text-gray-200 p-1" aria-label="Menu">
              <%= heroicon "bars-3", variant: :outline, options: { class: "w-6 h-6" } %>
            </button>
            <span class="font-bold text-cec-navy dark:text-cec-gold">CEC</span>
            <%= render "shared/theme_toggle" %>
          </header>
          <%# Theme toggle desktop — fixed top-right %>
          <div class="hidden lg:flex justify-end px-6 pt-4">
            <%= render "shared/theme_toggle" %>
          </div>

          <%# Page content %>
          <div class="flex-1 p-4 md:p-6 lg:p-8">
            <% if notice = flash[:notice] %>
              <div class="mb-4 p-3 bg-cec-teal/10 text-cec-teal-dark border border-cec-teal/30 dark:bg-cec-teal/20 dark:text-cec-teal-light dark:border-cec-teal/50 rounded-xl text-sm flex items-center gap-2"
                   role="status" aria-live="polite" data-controller="auto-dismiss">
                <%= heroicon "check-circle", variant: :mini, options: { class: "w-5 h-5 shrink-0", "aria-hidden" => "true" } %>
                <span><%= notice %></span>
              </div>
            <% end %>
            <% if alert = flash[:alert] %>
              <div class="mb-4 p-3 bg-red-50 text-red-700 border border-red-200 dark:bg-red-900/40 dark:text-red-200 dark:border-red-800 rounded-xl text-sm flex items-center gap-2"
                   role="alert" data-controller="auto-dismiss">
                <%= heroicon "exclamation-circle", variant: :mini, options: { class: "w-5 h-5 shrink-0", "aria-hidden" => "true" } %>
                <span><%= alert %></span>
              </div>
            <% end %>

            <%= yield %>
          </div>
        </main>
      </div>
    <% else %>
      <%= yield %>
    <% end %>

    <%= render "shared/confirm_modal" %>
  </body>
</html>
