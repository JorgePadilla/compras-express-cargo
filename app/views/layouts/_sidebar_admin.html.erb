<ul class="space-y-1 px-3">
  <%= sidebar_link "Home", root_path, icon: "home" %>

  <%# PR-C7.36: el mostrador de Miami tiene bloque propio. Las tres las autoriza
      `can_access?` al mismo par de roles (supervisor_miami, digitador_miami);
      Pre-Alertas y Paquetes los ve cualquiera, y por eso se quedan en Logistica.
      El guard viejo preguntaba por :etiquetar, :manifiestos, :pre_alertas y
      :paquetes — se habia olvidado de :entrega_personal, aunque su link vivia
      adentro. No se notaba porque los tres permisos de Miami van juntos. %>
  <% bloque_miami = can_access?(:etiquetar) || can_access?(:entrega_personal) || can_access?(:manifiestos) %>
  <% if bloque_miami %>
    <%= sidebar_section "Miami" do %>
      <%= sidebar_link "Etiquetar", etiquetar_path, icon: "tag" if can_access?(:etiquetar) %>
      <%= sidebar_link "Entrega Personal", new_entrega_personal_path, icon: "user-plus" if can_access?(:entrega_personal) %>
      <%= sidebar_link "Manifiestos", manifiestos_path, icon: "cube" if can_access?(:manifiestos) %>
      <%# C16-06 · Yusef, leyendo este bloque: *"falta Clientes para Miami, para
          que ellos lo puedan ver… a veces buscan un cliente para tratar de
          encontrar cuál es el número correcto"*. El link suelto de abajo ya lo
          tenían, pero leyeron el bloque y pararon. Acá va, y el suelto se queda
          para los roles que no tienen mostrador. %>
      <%= sidebar_link "Clientes", clientes_path, icon: "users" if can_access?(:clientes) %>
    <% end %>
  <% end %>

  <% if can_access?(:pre_alertas) || can_access?(:paquetes) %>
    <%= sidebar_section "Logistica" do %>
      <%= sidebar_link "Pre-Alertas", pre_alertas_path, icon: "bell-alert" if can_access?(:pre_alertas) %>
      <%= sidebar_link "Todos los Paquetes", paquetes_path, icon: "archive-box" if can_access?(:paquetes) %>
    <% end %>
  <% end %>

  <% if can_access?(:pre_facturas) || can_access?(:ventas) || can_access?(:notas_debito) || can_access?(:notas_credito) || can_access?(:cotizaciones) || can_access?(:financiamientos) %>
    <%= sidebar_section "Facturacion y Cobro" do %>
      <%= sidebar_link "Pre-Facturas", pre_facturas_path, icon: "document-text" if can_access?(:pre_facturas) %>
      <%= sidebar_link "Cotizaciones", cotizaciones_path, icon: "clipboard-document-list" if can_access?(:cotizaciones) %>
      <%= sidebar_link "Facturas", ventas_path, icon: "currency-dollar" if can_access?(:ventas) %>
      <%= sidebar_link "Recibos", recibos_path, icon: "receipt-percent" if can_access?(:recibos) %>
      <%= sidebar_link "Notas de Debito", notas_debito_path, icon: "document-plus" if can_access?(:notas_debito) %>
      <%= sidebar_link "Notas de Credito", notas_credito_path, icon: "document-minus" if can_access?(:notas_credito) %>
      <%= sidebar_link "Financiamientos", financiamientos_path, icon: "banknotes" if can_access?(:financiamientos) %>
    <% end %>
  <% end %>

  <%= sidebar_link "Clientes", clientes_path, icon: "users" if can_access?(:clientes) && !bloque_miami %>

  <%# PR-C7.40: la bandeja de tareas. Jorge: *"veo que falta la parte de tareas…
      faltan los links del menú"*. La pantalla no estaba porque no existía ruta
      global: solo se veían las de UN paquete o las de UN cliente. Va suelta y no
      en una sección de área porque las tareas cruzan las áreas — cada una trae
      su departamento y `visibles_para` ya filtra lo que a uno le toca. %>
  <% if can_access?(:tareas) %>
    <%= sidebar_link "Tareas", tareas_path, icon: "clipboard-document-check" %>
  <% end %>

  <% if can_access?(:entregas) %>
    <%= sidebar_link "Entregas", entregas_path, icon: "truck" %>
  <% end %>

  <% if can_access?(:caja) %>
    <%= sidebar_section "Caja Diaria" do %>
      <%= sidebar_link "Mi Dia", caja_path, icon: "calculator" %>
      <%= sidebar_link "Ingresos", ingresos_caja_path, icon: "arrow-trending-up" %>
      <%= sidebar_link "Egresos", egresos_caja_path, icon: "arrow-trending-down" %>
      <%= sidebar_link "Historial", historial_caja_path, icon: "clock" %>
    <% end %>
  <% end %>

  <%# El bloque de Marketing queda oculto hasta que exista el módulo: los tres
      links apuntaban a "#" y no hacían nada. Se reactiva en la Fase 7, igual
      que sus cards del dashboard. %>

  <%# PR-13.d: la bitácora de lo que un supervisor autorizó. La ven los mismos
      que pueden autorizar — sin pantalla donde mirarlo, el PIN es solo
      fricción en el mostrador. %>
  <% if Current.user&.rol_autorizante? %>
    <%= sidebar_section "Control" do %>
      <%= sidebar_link "Autorizaciones", autorizaciones_path, icon: "key" %>
    <% end %>
  <% end %>

  <% if admin? %>
    <%= sidebar_section "Configuracion" do %>
      <%= sidebar_link "Usuarios", users_path, icon: "user-group" %>
      <%= sidebar_link "Sucursales", sucursales_path, icon: "building-storefront" %>
      <%# PR-C7.12: "Categorias de Precio" se fue de acá. Jorge: "no le veo mucho
          valor". Sonaba a lo mismo que la línea de arriba y era un CRUD de un
          campo; los grupos de clientes se administran dentro de la Tabla de
          Servicios, que es donde vive su precio. %>
      <%= sidebar_link "Tabla de Servicios", servicios_path, icon: "currency-dollar" %>
      <%= sidebar_link "Tarifas de Recolecta", tarifas_recolecta_path, icon: "map-pin" %>
      <%= sidebar_link "Servicios Extra", servicios_extra_path, icon: "puzzle-piece" %>
      <%= sidebar_link "Proveedores", proveedores_path, icon: "shopping-bag" %>
      <%= sidebar_link "Motivos de Retención", motivos_retencion_path, icon: "hand-raised" %>
      <%= sidebar_link "Motivos de Envío por Política", motivos_envio_politica_path, icon: "paper-airplane" %>
      <%= sidebar_link "Plantillas Notas Cliente", plantillas_notas_cliente_path, icon: "clipboard" %>
      <%= sidebar_link "Plantillas Descripción", plantillas_descripcion_path, icon: "tag" %>
      <%= sidebar_link "Empresa", empresa_path, icon: "building-office-2" %>
      <%= sidebar_link "Tasa de Cambio", tasa_cambio_path, icon: "currency-dollar" %>
      <%# "Reportes" apuntaba a "#" — se agrega cuando exista (Fase 6). %>
    <% end %>
  <% end %>
</ul>
