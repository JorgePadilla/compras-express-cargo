<% content_for :title, "Sucursales" %>

<%= render PageHeaderComponent.new(title: "Sucursales", subtitle: "Administra ubicaciones de recepcion") do |header|
  header.with_action do
    render(ButtonComponent.new(variant: :primary, href: new_sucursal_path, icon: "plus", data: { shortcut: "F7" })) do
      raw('Nueva sucursal <span class="ml-1 text-[10px] opacity-70">(F7)</span>')
    end
  end
end %>

<div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
    <thead class="bg-gray-50 dark:bg-gray-900">
      <tr>
        <th class="px-4 py-2 text-left text-xs font-semibold text-gray-600 dark:text-gray-300">Código</th>
        <th class="px-4 py-2 text-left text-xs font-semibold text-gray-600 dark:text-gray-300">Nombre</th>
        <th class="px-4 py-2 text-left text-xs font-semibold text-gray-600 dark:text-gray-300">Ubicación</th>
        <th class="px-4 py-2 text-left text-xs font-semibold text-gray-600 dark:text-gray-300">Prefijo recepción</th>
        <th class="px-4 py-2 text-right text-xs font-semibold text-gray-600 dark:text-gray-300">Paquetes</th>
        <th class="px-4 py-2 text-center text-xs font-semibold text-gray-600 dark:text-gray-300">Estado</th>
        <th class="px-4 py-2 text-right text-xs font-semibold text-gray-600 dark:text-gray-300">Acciones</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
      <% @sucursales.each do |s| %>
        <tr>
          <td class="px-4 py-3 font-mono text-sm text-gray-700 dark:text-gray-200"><%= s.codigo %></td>
          <td class="px-4 py-3 text-sm text-gray-800 dark:text-gray-100 font-medium"><%= s.nombre %></td>
          <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-400"><%= s.ubicacion&.humanize || "—" %><% if s.pais.present? %> · <%= s.pais %><% end %></td>
          <td class="px-4 py-3 font-mono text-xs text-gray-500 dark:text-gray-400"><%= s.codigo_recepcion_prefix %>-XXXXXX</td>
          <td class="px-4 py-3 text-right text-sm text-gray-600 dark:text-gray-300"><%= s.paquetes.count %></td>
          <td class="px-4 py-3 text-center">
            <% if s.activo %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-cec-teal/10 text-cec-teal-dark ring-1 ring-cec-teal/30 dark:bg-cec-teal/20 dark:text-cec-teal-light">Activa</span>
            <% else %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-gray-100 text-gray-600 ring-1 ring-gray-200 dark:bg-gray-700 dark:text-gray-300 dark:ring-gray-600">Inactiva</span>
            <% end %>
          </td>
          <td class="px-4 py-3 text-right">
            <div class="inline-flex items-center gap-2">
              <%= link_to "Editar", edit_sucursal_path(s), class: "text-xs text-cec-teal hover:text-cec-teal-dark dark:text-cec-teal-light font-semibold" %>
              <%= button_to "Borrar", sucursal_path(s), method: :delete,
                  data: { turbo_confirm: "¿Eliminar la sucursal #{s.nombre}?" },
                  class: "text-xs text-red-500 hover:text-red-700 font-semibold" %>
            </div>
          </td>
        </tr>
      <% end %>
      <% if @sucursales.empty? %>
        <tr><td colspan="7" class="px-4 py-8 text-center text-sm text-gray-500">Sin sucursales registradas.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>
