<%= form_with model: @sucursal, class: "space-y-6 max-w-2xl" do |f| %>
  <% if @sucursal.errors.any? %>
    <div class="p-4 bg-red-50 dark:bg-red-900/30 rounded-lg text-sm text-red-700 dark:text-red-200">
      <ul class="list-disc list-inside space-y-1">
        <% @sucursal.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= f.label :codigo, "Código corto", class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>
      <%= f.text_field :codigo, required: true, maxlength: 8,
          placeholder: "Ej. MIA, SPS, TGU",
          class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" %>
      <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Identificador único corto en mayúsculas. Con él se arma el número de recepción (R<%= @sucursal.codigo.presence || "MIA" %><%= Date.current.strftime("%y%m") %>000001).</p>
    </div>

    <div>
      <%= f.label :nombre, class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>
      <%= f.text_field :nombre, required: true,
          placeholder: "Ej. Miami, Zeron SPS, Humuya TGU",
          class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" %>
    </div>

    <%# PR-D3.b: codigo_ep para tracking auto de paquetes ENTREGA PERSONAL %>
    <div>
      <%= f.label :codigo_ep, "Código EP (3 letras)", class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>
      <%= f.text_field :codigo_ep, maxlength: 3,
          placeholder: "Ej. SMI, SZR, SHU",
          class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm font-mono uppercase focus:ring-cec-teal focus:border-cec-teal" %>
      <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Se usa en el tracking auto de paquetes ENTREGA PERSONAL (ej. EP-2026-SMI-AMZ-000001).</p>
    </div>

    <div>
      <%= f.label :ubicacion, class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>
      <%= f.select :ubicacion, Sucursal::UBICACIONES.map { |u| [u.humanize, u] },
          { include_blank: "— Sin especificar —" },
          class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" %>
    </div>

    <div>
      <%= f.label :pais, "País", class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>
      <%= f.text_field :pais,
          class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" %>
    </div>

    <div class="flex items-center gap-3 pt-6">
      <%= f.check_box :activo, class: "rounded border-gray-300 text-cec-teal focus:ring-cec-teal" %>
      <%= f.label :activo, "Sucursal activa", class: "text-sm font-medium text-gray-700 dark:text-gray-200" %>
    </div>

    <%# A dónde va la carga si nadie dice lo contrario.
        Yusef: *"esa de San Pedro Sula hay que eliminarlo, porque es el
        default"*. Miami deja de recibir el aviso de bolsa para esta sucursal —
        el 80% de la carga se queda ahí, y un aviso que sale siempre deja de
        leerse. Cuando abran otra y se corra el peso, se cambia acá. %>
    <div class="md:col-span-2 flex items-start gap-3 rounded-lg ring-1 ring-gray-200 dark:ring-gray-700 px-3 py-2">
      <%= f.check_box :retiro_por_defecto, class: "mt-0.5 rounded border-gray-300 text-cec-teal focus:ring-cec-teal" %>
      <span>
        <%= f.label :retiro_por_defecto, "Es la sucursal de retiro por defecto",
              class: "block text-sm font-medium text-gray-700 dark:text-gray-200" %>
        <span class="block text-xs text-gray-500 dark:text-gray-400">
          A Miami no se le avisa la bolsa cuando la caja va acá: es a donde va casi todo.
          El aviso queda para las demás, que es cuando sirve.
        </span>
      </span>
    </div>

    <%# C18-02 · Dónde se recibe carga, que no es dónde se entrega. Yusef:
        *"debería ser las sucursales donde recibimos carga… en este momento
        solo es Miami; futuramente Los Ángeles, Panamá, México"*. Es lo que
        /etiquetar y /entrega_personal ofrecen al abrir sesión. %>
    <div class="md:col-span-2 flex items-start gap-3 rounded-lg ring-1 ring-gray-200 dark:ring-gray-700 px-3 py-2">
      <%= f.check_box :recibe_carga, class: "mt-0.5 rounded border-gray-300 text-cec-teal focus:ring-cec-teal" %>
      <span>
        <%= f.label :recibe_carga, "Acá se recibe carga",
              class: "block text-sm font-medium text-gray-700 dark:text-gray-200" %>
        <span class="block text-xs text-gray-500 dark:text-gray-400">
          Aparece al abrir sesión en Etiquetar y en Entrega Personal. Hoy Miami; el día que
          abran Los Ángeles, Panamá o México, se marca acá y ya está.
        </span>
      </span>
    </div>

    <%# Seguimiento de C18-02 (2026-08-27). Con dos que reciben, el orden por
        nombre ponía «DF México» antes que «Miami» y le robaba el default al
        admin de Honduras. Esta es la que queda preseleccionada si el usuario
        no tiene sucursal propia (/users). Solo puede haber una. %>
    <div class="md:col-span-2 flex items-start gap-3 rounded-lg ring-1 ring-gray-200 dark:ring-gray-700 px-3 py-2">
      <%= f.check_box :recepcion_por_defecto, class: "mt-0.5 rounded border-gray-300 text-cec-teal focus:ring-cec-teal" %>
      <span>
        <%= f.label :recepcion_por_defecto, "Es la sucursal de recepción por defecto",
              class: "block text-sm font-medium text-gray-700 dark:text-gray-200" %>
        <span class="block text-xs text-gray-500 dark:text-gray-400">
          La que queda preseleccionada al abrir sesión en Etiquetar y Entrega Personal cuando el
          usuario no tiene una sucursal asignada. Solo una: marcar esta desmarca la otra.
        </span>
      </span>
    </div>
  </div>

  <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-200 dark:border-gray-700">
    <%= link_to "Cancelar (F2)", sucursales_path,
        class: "text-sm text-gray-600 hover:text-gray-900 dark:text-gray-300",
        data: { shortcut: "F2" } %>
    <%= f.submit "#{@sucursal.persisted? ? 'Guardar' : 'Crear sucursal'} (F10)",
        class: "bg-cec-gold text-cec-navy-dark font-semibold px-4 py-2 rounded-lg text-sm",
        data: { shortcut: "F10" } %>
  </div>
<% end %>
