<%# C21-01 · La pantalla de empacar: el «pip pip pip».
    Yusef, mostrando la bodega en vivo: *"ahí están empacando, mirá… y aquí es
    donde hace falta, es el pip pip pip"*.

    El operario mira la pistola, no la pantalla, así que lo que decide es el
    sonido: verde si entró, error si el tipo de servicio no concuerda con el del
    manifiesto —*"si el tipo de servicio no concuerda con el de la caja, pita"*—
    y un tercero si no encontró nada. Con el aviso de tipo distinto sale el botón
    de **omitir**, que la Fase 12 pidió con esas palabras: *"para no trabar la
    operación cuando algo no cuadra"*. %>
<div data-controller="empaque audio"
     data-empaque-escanear-url-value="<%= @caja ? manifiesto_escanear_empaque_path(@manifiesto, @caja) : "" %>"
     data-empaque-omitir-url-value="<%= @caja ? manifiesto_omitir_empaque_path(@manifiesto, @caja) : "" %>"
     data-action="empaque:ok->audio#success
                  empaque:tipoDistinto->audio#error
                  empaque:noEncontrado->audio#alert
                  empaque:yaEmpacado->audio#alert">

  <%= render PageHeaderComponent.new(title: "Empacar — #{@manifiesto.numero}",
                                     subtitle: "Escaneá cada paquete al meterlo a la caja") do |h| %>
    <% h.with_back do %>
      <%= render ButtonComponent.new(href: manifiesto_path(@manifiesto), variant: :secondary, icon: "arrow-left", shortcut: "F2") do %>
        Volver al manifiesto
      <% end %>
    <% end %>
  <% end %>

  <% if @cajas.none? %>
    <%= render EmptyStateComponent.new(title: "Este manifiesto no tiene casas todavía",
          description: "Armá al menos una caja en el manifiesto para poder empacar en ella.", icon: "cube") %>
  <% else %>
    <div class="bg-white rounded-lg shadow mb-6 p-6">
      <span class="block text-base font-medium text-gray-700 dark:text-gray-200 mb-3">¿En qué caja estás empacando?</span>
      <%# PR-U5 · Eran chips de `px-3 py-2` —unos 34 px— y esto se toca con el
          dedo, en la bodega, con la pistola en la otra mano. Ahora la letra se
          lee de lejos y el bloque entero es el área de toque.

          Sigue siendo `link_to` y no una tarjeta `peer sr-only`: elegir caja
          **navega**, no es un campo del formulario.

          Ojo con el lint de botones: al pasar de `px-3 py-2` a `p-4` dejó de
          contarse como botón crudo —el contador exige `px-` y `py-` juntos— y
          hubo que sacar la entrada del presupuesto. El link no se fue; cambió
          la forma de sus clases. %>
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-6 gap-3">
        <% @cajas.each do |caja| %>
          <% activa = caja == @caja %>
          <%= link_to manifiesto_empacar_path(@manifiesto, caja_id: caja.id),
                class: "min-h-11 p-4 rounded-xl border-2 flex flex-col items-center gap-1 text-center transition foco-cec " \
                       "#{activa ? 'border-cec-gold bg-cec-gold/5 ring-2 ring-cec-gold/30' : 'border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 hover:shadow-lg hover:border-cec-gold/50'}" do %>
            <span class="text-3xl font-bold leading-none text-cec-navy dark:text-cec-gold"><%= caja.letra %></span>
            <span class="font-mono text-xs text-gray-500 dark:text-gray-400"><%= caja.codigo %></span>
            <span class="text-xs text-gray-600 dark:text-gray-300"><%= caja.paquetes.size %> pqt</span>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow mb-6 p-6">
      <%= label_tag :codigo_empaque, "Escaneá el paquete", class: "block text-base font-medium text-gray-700 dark:text-gray-200 mb-1" %>
      <%= text_field_tag :codigo_empaque, nil,
            placeholder: "Escanear la etiqueta del paquete…",
            autocomplete: "off", autofocus: true,
            data: { empaque_target: "codigo", action: "keydown->empaque#teclado" },
            class: "block w-full min-h-11 py-4 text-xl rounded-lg border-gray-300 shadow-sm font-mono focus:ring-cec-teal focus:border-cec-teal" %>
      <p class="text-xs text-gray-500 mt-1">
        Va a la caja <b><%= @caja.letra %></b> — <span class="font-mono"><%= @caja.codigo %></span>.
        El manifiesto lleva <b><%= @manifiesto.tipos_envio_nuestros %></b>.
      </p>

      <div data-empaque-target="aviso" class="hidden mt-4 rounded-lg p-3 text-sm"></div>
    </div>

    <div class="bg-white rounded-lg shadow overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-900">En la caja <%= @caja.letra %></h2>
      </div>
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Recepción</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tracking</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Cliente</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tipo</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200" data-empaque-target="filas">
          <% @paquetes.each do |p| %>
            <tr>
              <td class="px-6 py-3 text-sm font-mono text-cec-navy"><%= p.numero_recepcion_visible %></td>
              <td class="px-6 py-3 text-sm font-mono text-gray-500"><%= p.tracking %></td>
              <td class="px-6 py-3 text-sm text-gray-700"><%= p.cliente&.nombre_completo %></td>
              <td class="px-6 py-3 text-sm text-gray-500"><%= p.tipo_envio&.nombre %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if @paquetes.none? %>
        <p class="px-6 py-8 text-center text-sm text-gray-500">Todavía no hay paquetes en esta caja.</p>
      <% end %>
    </div>
  <% end %>
</div>
