<%# Lo que esta categoría cobra de verdad, leído de `tarifas`.
    Yusef: "la categoría de precio confunde con la tabla de servicios". Esta
    pantalla dejó de tener precios propios —eran columnas que no cobraban nada, y
    encima rotuladas en lempiras cuando los números eran dólares— y pasó a
    mostrar, en solo lectura, lo que la cascada de precios va a aplicarle a sus
    clientes. Editar sigue siendo cosa de /servicios: una sola pantalla cobra. %>
<% tarifas = categoria.tarifas_vigentes %>

<% if tarifas.any? %>
  <ul class="space-y-0.5">
    <% tarifas.each do |t| %>
      <li class="text-sm text-gray-700 dark:text-gray-200">
        <span class="font-medium"><%= t.tipo_envio&.codigo&.upcase %></span>
        <span class="font-mono"><%= tarifa_precio(t) %></span>
        <span class="text-xs text-gray-500 dark:text-gray-400"><%= tarifa_tramo(t) %></span>
        <% if t.sucursal %>
          <span class="text-xs text-cec-navy dark:text-cec-gold">· solo <%= t.sucursal.codigo %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="text-sm text-gray-500 dark:text-gray-400 italic">
    Sin tarifas propias: sus clientes pagan el <strong>precio de lista</strong>.
  </p>
<% end %>
