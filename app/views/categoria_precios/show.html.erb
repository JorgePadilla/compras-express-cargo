<%= render PageHeaderComponent.new(title: @categoria.nombre,
      subtitle: "Categoría de precio — agrupa clientes") do |h| %>
  <% h.with_action do %>
    <%= render ButtonComponent.new(href: servicios_path, variant: :secondary, icon: "currency-dollar") do %>
      Editar precios
    <% end %>
  <% end %>
  <% h.with_action do %>
    <%= render ButtonComponent.new(href: edit_categoria_precio_path(@categoria), variant: :primary, icon: "pencil-square", data: { shortcut: "F6" }) do %>
      Renombrar
    <% end %>
  <% end %>
<% end %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
  <div class="lg:col-span-2 bg-white dark:bg-gray-800 rounded-lg shadow ring-1 ring-gray-200 dark:ring-gray-700 p-6">
    <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-3">
      Qué cobra esta categoría
    </h3>
    <%= render "tarifas_resumen", categoria: @categoria %>
    <p class="mt-4 text-xs text-gray-500 dark:text-gray-400">
      Se edita en la <%= link_to "Tabla de Servicios", servicios_path, class: "text-cec-teal-deep dark:text-cec-teal-light underline" %>.
      Un cliente con precio propio le gana a su categoría.
    </p>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-lg shadow ring-1 ring-gray-200 dark:ring-gray-700 p-6">
    <dl class="text-sm space-y-3">
      <div>
        <dt class="text-gray-500 dark:text-gray-400">Clientes asignados</dt>
        <dd class="font-medium text-lg text-gray-900 dark:text-gray-100"><%= @categoria.clientes.count %></dd>
      </div>
    </dl>
  </div>
</div>
