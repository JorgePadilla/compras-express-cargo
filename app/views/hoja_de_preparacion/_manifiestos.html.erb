<%# ── 2 · Los manifiestos ──────────────────────────────────────────────
    *"Solo le van a aparecer los que ya fueron recibidos"*, en aduana, y
    *"cuando… lo terminamos, desaparece de los pendientes"*
    (`Manifiesto.para_hoja`). Si falta una caja, el manifiesto se queda y la
    tarjeta lo dice (`C28-14`). %>
<%# PR-P.11a · «Sin manifiesto oficial» va como una tarjeta más, al final. %>
<% hay_sin_manifiesto = @hoja.editar? ? @pre_facturas_sin_manifiesto.any? : @sin_manifiesto_total.positive? %>
<section class="bg-white dark:bg-gray-800 rounded-lg shadow p-6" data-paso="2">
  <div class="flex items-baseline gap-3 mb-4">
    <span class="shrink-0 w-7 h-7 rounded-full bg-cec-navy/10 text-cec-navy dark:bg-cec-gold/20 dark:text-cec-gold
                 flex items-center justify-center text-sm font-bold">2</span>
    <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100">
      <%= @hoja.editar? ? "Manifiestos con pre-facturas para corregir" : "¿De qué manifiestos?" %>
    </h2>
  </div>

  <% if @hoja.editar? && (@manifiestos.any? || hay_sin_manifiesto) %>
    <%# PR-P.7 · Todas las programadas que se listan, de un tirón. %>
    <div class="mb-4 rounded-lg bg-gray-50 dark:bg-gray-900 p-4">
      <p class="text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">Cambiar la hora del aviso de todas las programadas de abajo</p>
      <%= render "hoja_de_preparacion/reprogramar", manifiesto: nil %>
    </div>
  <% end %>

  <%= hidden_field_tag "hoja[manifiesto_ids][]", "", id: nil %>
  <%# Igual que el vacío de arriba: sin él, destildar «Sin manifiesto oficial»
      no mandaría nada y la sesión se quedaría con la de antes. %>
  <%= hidden_field_tag "hoja[sin_manifiesto]", "0", id: nil %>
  <% if @hoja.nuevas? && @hoja.tipo_envio_ids.empty? %>
    <p class="text-sm text-gray-500 dark:text-gray-400">Elegí arriba los servicios y apretá «Ver manifiestos».</p>
  <% elsif @manifiestos.empty? && !hay_sin_manifiesto %>
    <p class="text-sm text-gray-500 dark:text-gray-400">
      <%= @hoja.editar? ? "No hay pre-facturas sin avisar para corregir." : "No hay manifiestos en aduana con carga sin pre-facturar de esos servicios." %>
    </p>
  <% else %>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
      <% @manifiestos.each do |m| %>
        <% total = @total_por_manifiesto[m.id].to_i %>
        <% hechos = @prefacturados_por_manifiesto[m.id].to_i %>
        <% faltan = @faltan_cajas[m.id].to_i %>
        <div class="rounded-xl border-2 border-gray-200 dark:border-gray-700 p-4 has-[:checked]:border-cec-gold has-[:checked]:bg-cec-gold/5"
             data-manifiesto="<%= m.numero %>">
          <label class="flex items-start gap-3 <%= "cursor-pointer" if @hoja.nuevas? %>">
            <% if @hoja.nuevas? %>
              <%= check_box_tag "hoja[manifiesto_ids][]", m.id, @hoja.manifiesto_ids.include?(m.id),
                    id: "hoja_manifiesto_#{m.id}", class: "mt-1 rounded border-gray-300 text-cec-navy focus:ring-cec-teal" %>
            <% end %>
            <span class="flex-1">
              <span class="flex flex-wrap items-center gap-2">
                <span class="font-mono font-bold text-cec-navy dark:text-cec-gold"><%= m.numero %></span>
                <%= render StatusBadgeComponent.new(status: m.estado) %>
                <% if faltan.positive? %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-red-50 text-red-700 ring-1 ring-red-200">
                    <%= faltan > 1 ? "faltan #{faltan} cajas" : "falta 1 caja" %>
                  </span>
                <% end %>
              </span>
              <span class="block text-sm text-gray-700 dark:text-gray-200 mt-1"><%= m.tipos_envio_nuestros.presence || "—" %></span>
              <span class="block text-xs text-gray-500 dark:text-gray-400 mt-0.5">
                <%= hechos %> de <%= total %> paquetes pre-facturados
              </span>
            </span>
          </label>

          <% if @hoja.editar? %>
            <%# PR-P.7 · Cada una con su estado del aviso y lo que se le puede
                hacer antes de que salga. Lo que P.2 anota cuando el barrido
                no pudo avisar (una tarea que bloquea, sin correo) se ve acá:
                si no, la pre-factura se quedaría trabada en silencio. %>
            <ul class="mt-3 divide-y divide-gray-100 dark:divide-gray-700 border-t border-gray-100 dark:border-gray-700">
              <% @pre_facturas_por_manifiesto.fetch(m.id, []).each do |pf| %>
                <%= render "hoja_de_preparacion/pre_factura_editable", pf: pf %>
              <% end %>
            </ul>
            <%# PR-P.7 · La hora del aviso, para todas las programadas de este
                manifiesto de un tirón: *"el marítimo lo notificamos a las 2
                de la tarde"*. Un formulario aparte, no el de la hoja. %>
            <%= render "hoja_de_preparacion/reprogramar", manifiesto: m %>
          <% end %>
        </div>
      <% end %>

      <% if hay_sin_manifiesto %>
        <%# PR-P.11a · RP-85 · Lo que no vino en un manifiesto oficial —viejos,
            capeados, los que andan en un interno—. Antes solo entraba por la
            pre-factura a mano; ahora se audita escaneando como lo demás. %>
        <div class="rounded-xl border-2 border-dashed border-gray-300 dark:border-gray-600 p-4 has-[:checked]:border-cec-gold has-[:checked]:bg-cec-gold/5"
             data-sin-manifiesto>
          <label class="flex items-start gap-3 <%= "cursor-pointer" if @hoja.nuevas? %>">
            <% if @hoja.nuevas? %>
              <%= check_box_tag "hoja[sin_manifiesto]", "1", @hoja.sin_manifiesto?,
                    id: "hoja_sin_manifiesto", class: "mt-1 rounded border-gray-300 text-cec-navy focus:ring-cec-teal" %>
            <% end %>
            <span class="flex-1">
              <span class="font-bold text-cec-navy dark:text-cec-gold">Sin manifiesto oficial</span>
              <span class="block text-xs text-gray-500 dark:text-gray-400 mt-0.5">
                <% if @hoja.nuevas? %>
                  <%= @sin_manifiesto_total %> paquete<%= "s" if @sin_manifiesto_total != 1 %> en Honduras sin manifiesto oficial
                <% else %>
                  Auditadas con carga que no vino en un manifiesto oficial
                <% end %>
              </span>
            </span>
          </label>
          <% if @hoja.editar? %>
            <ul class="mt-3 divide-y divide-gray-100 dark:divide-gray-700 border-t border-gray-100 dark:border-gray-700">
              <% @pre_facturas_sin_manifiesto.each do |pf| %>
                <%= render "hoja_de_preparacion/pre_factura_editable", pf: pf %>
              <% end %>
            </ul>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</section>
