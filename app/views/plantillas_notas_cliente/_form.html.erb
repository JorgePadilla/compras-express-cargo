<%= form_with model: plantilla, local: true,
              class: "space-y-4 bg-white rounded-lg shadow p-6" do |f| %>
  <% if plantilla.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-3 text-sm text-red-700">
      <ul class="list-disc list-inside">
        <% plantilla.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :titulo, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :titulo, required: true,
        class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" %>
    <p class="mt-1 text-xs text-gray-500">Aparece como botón en el picker del paquete.</p>
  </div>

  <div>
    <%= f.label :texto, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :texto, rows: 5, required: true,
        class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" %>
    <p class="mt-1 text-xs text-gray-500">Se inserta en el campo "Notas al Cliente" del paquete cuando el operador la elige.</p>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :position, "Posición", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :position, min: 0,
          class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" %>
    </div>
    <div class="flex items-end">
      <label class="flex items-center gap-2">
        <%= f.check_box :activo, class: "rounded border-gray-300 text-cec-teal focus:ring-cec-teal" %>
        <span class="text-sm font-medium text-gray-700">Activa</span>
      </label>
    </div>
  </div>

  <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-200">
    <%= link_to "Cancelar (F2)", plantillas_notas_cliente_path,
        class: "text-sm text-gray-600 hover:text-gray-900",
        data: { shortcut: "F2" } %>
    <%= f.submit "#{plantilla.persisted? ? 'Guardar' : 'Crear'} (F10)",
        class: "inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium bg-cec-gold text-cec-navy-dark hover:bg-cec-gold-dark transition-colors cursor-pointer",
        data: { shortcut: "F10" } %>
  </div>
<% end %>
