<% content_for :title, "Re-empaque · #{@paquete.tracking}" %>

<div class="max-w-3xl mx-auto space-y-6">
  <div>
    <%= link_to paquete_reempaques_path(@paquete), class: "text-xs text-gray-500 hover:text-cec-teal inline-flex items-center gap-1" do %>
      <%= heroicon "arrow-left", variant: :outline, options: { class: "w-3 h-3" } %>
      Volver
    <% end %>
    <h1 class="text-2xl font-bold text-cec-navy mt-1">Re-empaque</h1>
    <p class="text-sm text-gray-600">
      Paquete <span class="font-mono"><%= @paquete.tracking %></span> ·
      <%= @reempaque.realizado_en&.strftime("%d/%m/%Y %H:%M") %> ·
      <%= @reempaque.hecho_por&.nombre || "—" %>
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
      <h3 class="text-sm font-semibold text-gray-800 mb-3">Antes</h3>
      <dl class="space-y-1 text-sm">
        <div class="flex justify-between"><dt class="text-gray-500">Alto</dt><dd><%= @reempaque.alto_antes %></dd></div>
        <div class="flex justify-between"><dt class="text-gray-500">Largo</dt><dd><%= @reempaque.largo_antes %></dd></div>
        <div class="flex justify-between"><dt class="text-gray-500">Ancho</dt><dd><%= @reempaque.ancho_antes %></dd></div>
        <div class="flex justify-between"><dt class="text-gray-500">Peso</dt><dd><%= @reempaque.peso_antes %> lbs</dd></div>
        <div class="flex justify-between border-t border-gray-100 pt-1 mt-1"><dt class="text-gray-500">Peso volumétrico</dt><dd><%= @reempaque.peso_volumetrico_antes || "—" %> lbs</dd></div>
        <div class="flex justify-between"><dt class="text-gray-500">Peso a cobrar</dt><dd class="font-semibold"><%= @reempaque.peso_cobrar_antes %> lbs</dd></div>
      </dl>
    </div>

    <div class="bg-cec-teal/5 rounded-xl border border-cec-teal/20 p-5">
      <h3 class="text-sm font-semibold text-cec-teal-dark mb-3">Después</h3>
      <dl class="space-y-1 text-sm">
        <div class="flex justify-between"><dt class="text-gray-500">Alto</dt><dd><%= @reempaque.alto_despues %></dd></div>
        <div class="flex justify-between"><dt class="text-gray-500">Largo</dt><dd><%= @reempaque.largo_despues %></dd></div>
        <div class="flex justify-between"><dt class="text-gray-500">Ancho</dt><dd><%= @reempaque.ancho_despues %></dd></div>
        <div class="flex justify-between"><dt class="text-gray-500">Peso</dt><dd><%= @reempaque.peso_despues %> lbs</dd></div>
        <div class="flex justify-between border-t border-cec-teal/20 pt-1 mt-1"><dt class="text-gray-500">Peso volumétrico</dt><dd><%= @reempaque.peso_volumetrico_despues || "—" %> lbs</dd></div>
        <div class="flex justify-between"><dt class="text-gray-500">Peso a cobrar</dt><dd class="font-semibold"><%= @reempaque.peso_cobrar_despues %> lbs</dd></div>
      </dl>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
    <h3 class="text-sm font-semibold text-gray-800 mb-3">Ahorro</h3>
    <div class="grid grid-cols-2 gap-4 text-sm">
      <div>
        <p class="text-xs text-gray-500">Peso volumétrico ahorrado</p>
        <p class="text-xl font-bold <%= @reempaque.ahorro_volumetrico.positive? ? "text-cec-teal" : "text-gray-500" %>">
          <%= @reempaque.ahorro_volumetrico %> lbs
        </p>
      </div>
      <div>
        <p class="text-xs text-gray-500">Peso a cobrar reducido</p>
        <p class="text-xl font-bold <%= @reempaque.ahorro_peso_cobrar.positive? ? "text-cec-teal" : "text-gray-500" %>">
          <%= @reempaque.ahorro_peso_cobrar %> lbs
        </p>
      </div>
    </div>
  </div>

  <% if @reempaque.notas.present? %>
    <div class="bg-gray-50 rounded-xl p-4">
      <h3 class="text-xs font-semibold text-gray-500 uppercase mb-1">Notas</h3>
      <p class="text-sm text-gray-700 whitespace-pre-line"><%= @reempaque.notas %></p>
    </div>
  <% end %>
</div>
