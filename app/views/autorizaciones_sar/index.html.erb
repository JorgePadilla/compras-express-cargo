<%# PR-F1.3 · Fase 15. Los puntos de emisión arriba —de dónde sale cada
    factura— y las autorizaciones abajo, con cuánto les queda. %>
<%= render PageHeaderComponent.new(title: "Facturación SAR", subtitle: "Puntos de emisión y autorizaciones (CAI)") do |h| %>
  <% h.with_action do %>
    <%= render ButtonComponent.new(href: new_autorizacion_sar_path, variant: :primary, icon: "plus", shortcut: "F1") do %>
      Nueva autorización
    <% end %>
  <% end %>
<% end %>

<%= render "autorizaciones_sar/salud", salud: @salud %>

<%= render FormSectionComponent.new(title: "Puntos de emisión",
                                    subtitle: "Uno por sucursal que factura: el EEE-PPP del número de factura.",
                                    densidad: :compacta, class: "mb-6") do %>
  <div class="overflow-x-auto -mx-4 sm:-mx-5">
  <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
    <thead class="bg-gray-50 dark:bg-gray-800">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Sucursal</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Establecimiento-Punto</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Estado</th>
        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Acciones</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
      <% @puntos.each do |punto| %>
        <tr>
          <td class="px-6 py-3 text-sm font-medium text-gray-900 dark:text-gray-100"><%= punto.sucursal.nombre %></td>
          <td class="px-6 py-3 text-sm font-mono text-gray-700 dark:text-gray-200"><%= punto.prefijo %></td>
          <td class="px-6 py-3 text-sm">
            <% if punto.activo? %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-cec-teal/10 text-cec-teal-deep dark:text-cec-teal">Activo</span>
            <% else %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600 dark:bg-gray-700 dark:text-gray-300">Inactivo</span>
            <% end %>
          </td>
          <td class="px-6 py-3 text-right text-sm">
            <%= render RowActionComponent.new(action: :edit, href: edit_punto_de_emision_path(punto), label: "Editar punto #{punto.prefijo}") %>
          </td>
        </tr>
      <% end %>
      <% @sucursales_sin_punto.each do |sucursal| %>
        <tr>
          <td class="px-6 py-3 text-sm font-medium text-gray-900 dark:text-gray-100"><%= sucursal.nombre %></td>
          <td class="px-6 py-3 text-sm text-gray-500 dark:text-gray-400" colspan="2">Sin punto de emisión: no puede facturar.</td>
          <td class="px-6 py-3 text-right text-sm">
            <%= render ButtonComponent.new(href: new_punto_de_emision_path(sucursal_id: sucursal.id), variant: :secondary, size: :sm, icon: "plus") do %>
              Crear punto
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  </div>
<% end %>

<% if @autorizaciones.any? %>
  <%= render FormSectionComponent.new(title: "Autorizaciones",
                                      subtitle: "El CAI, el rango autorizado y la fecha límite de emisión, por punto y tipo de documento.",
                                      densidad: :compacta) do %>
    <div class="overflow-x-auto -mx-4 sm:-mx-5">
      <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
        <thead class="bg-gray-50 dark:bg-gray-800">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Sucursal</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Tipo</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">CAI</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Rango</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Usados</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Fecha límite</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
          <% @autorizaciones.each do |a| %>
            <% usados = a.documentos_usados(@ultimos[[ a.punto_de_emision_id, a.tipo_documento ]]) %>
            <tr>
              <td class="px-4 py-3 text-sm text-gray-900 dark:text-gray-100"><%= a.punto_de_emision.sucursal.nombre %></td>
              <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-200"><%= a.tipo_nombre %></td>
              <td class="px-4 py-3 text-xs font-mono text-gray-700 dark:text-gray-200 break-all"><%= a.cai %></td>
              <td class="px-4 py-3 text-xs font-mono text-gray-700 dark:text-gray-200 whitespace-nowrap">
                <%= a.numero(a.rango_inicio) %><br><%= a.numero(a.rango_fin) %>
              </td>
              <td class="px-4 py-3 text-sm text-right tabular-nums text-gray-700 dark:text-gray-200">
                <%= number_with_delimiter(usados) %> / <%= number_with_delimiter(a.capacidad) %>
              </td>
              <td class="px-4 py-3 text-sm whitespace-nowrap">
                <span class="text-gray-700 dark:text-gray-200"><%= l(a.fecha_limite_emision, format: "%d/%m/%Y") %></span>
                <div class="mt-1 flex gap-1"><%= render "autorizaciones_sar/estado", autorizacion: a %></div>
              </td>
              <td class="px-4 py-3 text-right text-sm">
                <%= render RowActionComponent.new(action: :view, href: autorizacion_sar_path(a), label: "Ver autorización #{a.cai}") %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% else %>
  <%= render EmptyStateComponent.new(title: "No hay autorizaciones cargadas",
                                     description: "Sin un CAI vigente no se puede emitir ninguna factura. Cargá la que dio la SAR para cada punto de emisión.",
                                     icon: "shield-check") %>
<% end %>
