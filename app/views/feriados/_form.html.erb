<% campo = "block w-full rounded-lg border-gray-300 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" %>
<% etiqueta = "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>
<%= form_with model: feriado, local: true do |f| %>
  <% if feriado.errors.any? %>
    <div class="mb-4 rounded-lg bg-red-50 dark:bg-red-900/20 ring-1 ring-red-200 dark:ring-red-800 p-4">
      <ul class="list-disc list-inside text-sm text-red-800 dark:text-red-200">
        <% feriado.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <%= render FormSectionComponent.new(title: "Feriado",
                                      subtitle: "Ese día no cuenta como hábil para la posible fecha de entrega. Si cae en sábado, tampoco cuenta.") do |section| %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= f.label :fecha, "Fecha", class: etiqueta %>
        <%= f.date_field :fecha, required: true, class: campo, data: { controller: "flatpickr" } %>
      </div>

      <div>
        <%= f.label :nombre, "Nombre", class: etiqueta %>
        <%= f.text_field :nombre, required: true, placeholder: "Semana Morazánica", class: campo %>
      </div>
    </div>

    <% section.with_footer do %>
      <%= link_to "Cancelar", feriados_path,
                  class: "text-sm text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white self-center" %>
      <%= render(ButtonComponent.new(variant: :gold, size: :lg, type: :submit, shortcut: "F8")) { "Guardar" } %>
    <% end %>
  <% end %>
<% end %>
