<%= form_with model: paquete, class: "space-y-6", html: { id: "paquete-edit-form" } do |f| %>
  <% if paquete.errors.any? %>
    <div class="p-4 bg-red-50 rounded-lg">
      <div class="flex items-center gap-2 mb-2">
        <%= heroicon "exclamation-triangle", variant: :outline, options: { class: "w-5 h-5 text-red-600" } %>
        <h3 class="text-sm font-medium text-red-800">
          Se encontraron <%= paquete.errors.count %> error(es) al guardar:
        </h3>
      </div>
      <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
        <% paquete.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-3 grid grid-cols-1 md:grid-cols-3 gap-3">
      <div class="md:col-span-2">
        <%= f.label :tracking, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :tracking, required: true,
            class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm font-mono
                   focus:ring-cec-teal focus:border-cec-teal" %>
      </div>
      <div>
        <%= f.label :tracking_secundario, "Tracking secundario (opcional)",
            class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :tracking_secundario,
            placeholder: "2do tracking (si aplica)",
            class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm font-mono
                   focus:ring-cec-teal focus:border-cec-teal" %>
        <p class="text-[11px] text-gray-500 mt-1">Cuando el proveedor da 2 tracking numbers para el mismo paquete.</p>
      </div>
    </div>

    <div>
      <%= f.label :estado, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <% if can_change_estado_paquete? %>
        <%= f.select :estado, Paquete.estados.keys.map { |e| [e.humanize, e] },
            {},
            { class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                     focus:ring-cec-teal focus:border-cec-teal" } %>
      <% else %>
        <%# PR-D7.b: roles operativos no pueden cambiar estado manualmente. %>
        <div class="block w-full rounded-lg border border-gray-200 bg-gray-50 text-sm text-gray-600 px-3 py-2">
          <%= paquete.estado&.humanize %>
        </div>
        <p class="text-[11px] text-gray-500 mt-1">Solo supervisores o admin pueden cambiar el estado.</p>
        <%= f.hidden_field :estado %>
      <% end %>
    </div>

    <div>
      <%= f.label :tipo_envio_id, "Tipo de Envio", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.collection_select :tipo_envio_id, @tipo_envios, :id, :nombre,
          { include_blank: "— Seleccionar —" },
          { class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                   focus:ring-cec-teal focus:border-cec-teal" } %>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1">Carrier</label>
      <%= f.text_field :expedido_por, list: "carriers-list-edit",
          placeholder: "FedEx, UPS, USPS, DHL…",
          class: "block w-full rounded-lg border-gray-300 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100 shadow-sm text-sm
                 focus:ring-cec-teal focus:border-cec-teal" %>
      <datalist id="carriers-list-edit">
        <% @carriers.each do |carrier| %>
          <option value="<%= carrier.nombre %>">
        <% end %>
      </datalist>
      <p class="mt-1 text-xs text-gray-500 dark:text-gray-400 italic">
        Si escribís un carrier nuevo se agrega al catálogo automáticamente.
      </p>
    </div>

    <%# PR-D3.a: autocomplete contra el catálogo de proveedores. %>
    <div data-controller="proveedor-autocomplete"
         data-proveedor-autocomplete-url-value="<%= buscar_proveedores_path %>"
         class="relative">
      <%= f.label :proveedor_id, "Proveedor", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <% sel = paquete.proveedor %>
      <input type="text"
             value="<%= sel&.nombre || paquete[:proveedor].to_s %>"
             placeholder="Amazon, Walmart, Driver Juan…"
             autocomplete="off"
             data-proveedor-autocomplete-target="input"
             data-action="input->proveedor-autocomplete#search"
             class="block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal">
      <%= f.hidden_field :proveedor_id,
          data: { proveedor_autocomplete_target: "proveedorId" } %>
      <div data-proveedor-autocomplete-target="dropdown"
           class="hidden absolute z-10 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-64 overflow-auto"></div>
      <span data-proveedor-autocomplete-target="nombre"
            class="<%= sel ? '' : 'hidden ' %>mt-1 block text-xs text-gray-500 font-mono">
        <%= "(#{sel.codigo})" if sel %>
      </span>
    </div>

    <%# PR-D3.c (UX rev 2026-05-02): Tercero — cliente final cuando
        CEC le maneja la carga a otra empresa pequeña.
        Layout reorganizado: input con icono lupa flex-alineado +
        pill de "tercero seleccionado" debajo cuando aplica. %>
    <div class="lg:col-span-3"
         data-controller="tercero-search"
         data-tercero-search-url-value="<%= buscar_clientes_path %>">
      <% tercero_sel = paquete.tercero %>

      <%# Header del campo: label izquierda + descripción + clear button derecha %>
      <div class="flex items-center justify-between mb-1.5">
        <div class="flex items-center gap-2">
          <%= f.label :tercero_id, "Tercero",
              class: "text-sm font-medium text-gray-700 dark:text-gray-200" %>
          <span class="text-[11px] text-gray-400 dark:text-gray-500 italic">
            cliente final, si aplica
          </span>
        </div>
        <button type="button"
                data-tercero-search-target="clearButton"
                data-action="tercero-search#clear"
                class="<%= tercero_sel ? '' : 'hidden ' %>inline-flex items-center gap-1 text-xs text-gray-500 hover:text-red-600 transition-colors">
          <%= heroicon "x-mark", variant: :outline, options: { class: "w-3.5 h-3.5" } %>
          <span>Quitar</span>
        </button>
      </div>

      <%# Input con icono lupa flex-alineado dentro del input (no absolute hardcoded) %>
      <div class="relative">
        <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400">
          <%= heroicon "magnifying-glass", variant: :outline, options: { class: "w-4 h-4" } %>
        </span>
        <input type="text"
               value="<%= tercero_sel ? "#{tercero_sel.codigo} — #{tercero_sel.nombre_completo}" : '' %>"
               placeholder="Buscar tercero por código o nombre…"
               autocomplete="off"
               data-tercero-search-target="input"
               data-action="input->tercero-search#search"
               class="block w-full pl-10 pr-3 py-2.5 rounded-lg border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal">
        <%= f.hidden_field :tercero_id, data: { tercero_search_target: "terceroId" } %>

        <%# Dropdown ancla al input %>
        <div data-tercero-search-target="dropdown"
             class="hidden absolute z-20 mt-1 w-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-xl max-h-72 overflow-auto"></div>
      </div>

      <%# Selected state: pill con datos del tercero asignado %>
      <% if tercero_sel %>
        <div class="mt-2 inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-cec-purple/10 dark:bg-cec-purple/20 ring-1 ring-cec-purple/30">
          <%= heroicon "user-group", variant: :solid, options: { class: "w-3.5 h-3.5 text-cec-purple-dark dark:text-cec-purple-light" } %>
          <span class="text-[10px] uppercase tracking-wider font-bold text-cec-purple-dark dark:text-cec-purple-light">Asignado:</span>
          <span class="font-mono text-xs text-cec-navy dark:text-cec-gold"><%= tercero_sel.codigo %></span>
          <span class="text-xs text-gray-700 dark:text-gray-200"><%= tercero_sel.nombre_completo %></span>
        </div>
      <% end %>

      <p class="mt-2 text-[11px] text-gray-500 dark:text-gray-400">
        Usa esto cuando le manejas la carga a una empresa pequeña que tiene su propio cliente final.
      </p>
    </div>

    <div>
      <%= f.label :peso, "Peso (lbs)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :peso, step: 0.01, min: 0,
          class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                 focus:ring-cec-teal focus:border-cec-teal" %>
    </div>

    <div class="grid grid-cols-3 gap-2">
      <div>
        <%= f.label :alto, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :alto, step: 0.01, min: 0,
            class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                   focus:ring-cec-teal focus:border-cec-teal" %>
      </div>
      <div>
        <%= f.label :largo, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :largo, step: 0.01, min: 0,
            class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                   focus:ring-cec-teal focus:border-cec-teal" %>
      </div>
      <div>
        <%= f.label :ancho, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :ancho, step: 0.01, min: 0,
            class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                   focus:ring-cec-teal focus:border-cec-teal" %>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :cantidad_productos, "Cant. Productos", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :cantidad_productos, min: 0,
            class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                   focus:ring-cec-teal focus:border-cec-teal" %>
      </div>
      <div>
        <%= f.label :cantidad_paquetes, "Cant. Paquetes", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :cantidad_paquetes, min: 0,
            class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                   focus:ring-cec-teal focus:border-cec-teal" %>
      </div>
    </div>

    <div class="lg:col-span-2">
      <%= f.label :descripcion, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :descripcion, rows: 2,
          class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                 focus:ring-cec-teal focus:border-cec-teal" %>
    </div>

    <div>
      <%= f.label :remitente, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :remitente,
          class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                 focus:ring-cec-teal focus:border-cec-teal" %>
    </div>

    <%# ── Estado de vinculación: Pre-Alerta y Pre-Factura ─────────────
        Display read-only — el flag boolean se preserva via hidden field.
        Si el paquete tiene pre-alertas o pre-factura, mostramos link directo. %>
    <div class="lg:col-span-3 grid grid-cols-1 md:grid-cols-2 gap-3">
      <% pap = paquete.pre_alerta_paquetes.includes(:pre_alerta).first %>
      <div class="px-3 py-2 rounded-lg bg-gray-50 dark:bg-gray-800/50 ring-1 ring-gray-200 dark:ring-gray-700">
        <span class="block text-[10px] font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Pre-Alerta</span>
        <% if pap&.pre_alerta %>
          <%= link_to pap.pre_alerta.numero_documento, pre_alerta_path(pap.pre_alerta),
              class: "font-mono text-sm font-medium text-cec-navy dark:text-cec-gold hover:underline" %>
          <span class="text-xs text-gray-600 dark:text-gray-300 ml-1">— <%= pap.pre_alerta.titulo %></span>
        <% else %>
          <span class="text-sm text-gray-500 italic">Sin pre-alerta</span>
        <% end %>
        <%# Mantener compat con el flag boolean existente. %>
        <%= f.hidden_field :pre_alerta, value: paquete.pre_alerta %>
      </div>
      <div class="px-3 py-2 rounded-lg bg-gray-50 dark:bg-gray-800/50 ring-1 ring-gray-200 dark:ring-gray-700">
        <span class="block text-[10px] font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Pre-Factura</span>
        <% if paquete.pre_factura_id %>
          <%= link_to paquete.pre_factura.numero, pre_factura_path(paquete.pre_factura),
              class: "font-mono text-sm font-medium text-cec-navy dark:text-cec-gold hover:underline" %>
        <% else %>
          <span class="text-sm text-gray-500 italic">Sin pre-factura</span>
        <% end %>
        <%# pre_factura es columna boolean (no la asociación FK). Hidden field
            preserva el valor existente para que el form submit no lo borre. %>
        <%= hidden_field_tag "paquete[pre_factura]",
            (ActiveModel::Type::Boolean.new.cast(paquete[:pre_factura]) ? "1" : "0"),
            id: "paquete_pre_factura_flag" %>
      </div>
    </div>

    <%# ── Checkboxes con modal: Cambio de Servicio, Retener Miami, Recolecta ── %>
    <div class="lg:col-span-3 grid grid-cols-1 md:grid-cols-3 gap-3">

      <%# Cambio de Servicio — modal: nuevo tipo + razón. %>
      <div data-controller="checkbox-modal"
           class="px-3 py-2 rounded-lg ring-1 ring-gray-200 dark:ring-gray-700 hover:bg-amber-50 dark:hover:bg-amber-900/20 transition-colors">
        <label class="flex items-center gap-2 cursor-pointer">
          <%= f.check_box :solicito_cambio_servicio,
              data: { checkbox_modal_target: "checkbox", action: "change->checkbox-modal#onChange" },
              class: "rounded border-gray-300 text-amber-600 focus:ring-amber-500" %>
          <span class="text-sm font-medium text-gray-700 dark:text-gray-200">Cambio de Servicio</span>
          <% if paquete.solicito_cambio_servicio? %>
            <span class="ml-auto text-[10px] uppercase tracking-wider font-bold px-1.5 py-0.5 rounded bg-amber-100 text-amber-900">activo</span>
          <% end %>
        </label>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Genera cargo automático en pre-factura.</p>

        <dialog data-checkbox-modal-target="dialog"
                aria-labelledby="modal-cambio-servicio-title"
                style="margin: auto" class="rounded-xl p-0 w-[32rem] max-w-[95vw] backdrop:bg-black/40 ring-1 ring-amber-300">
          <div class="bg-amber-50 px-5 py-3 border-b border-amber-200">
            <h3 id="modal-cambio-servicio-title" class="text-base font-semibold text-amber-900">Cambio de Servicio</h3>
          </div>
          <div class="p-5 space-y-4 bg-white">
            <p class="text-sm text-gray-700">
              El cliente solicitó cambio de servicio. Confirmá el nuevo tipo de envío.
              Pre-Factura agregará automáticamente la línea con el cargo correspondiente.
            </p>
            <div>
              <%= f.label :tipo_envio_id, "Nuevo Tipo de Envío", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.collection_select :tipo_envio_id, @tipo_envios, :id, :nombre,
                    { include_blank: "— Mantener actual —" },
                    { class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-amber-500 focus:border-amber-500" } %>
            </div>
            <p class="text-[11px] text-gray-600 italic">
              Si querés agregar la razón del cambio, escribila en
              <strong>Notas Internas</strong> (campo abajo del formulario).
            </p>
          </div>
          <div class="flex items-center justify-end gap-2 px-5 py-3 bg-gray-50 border-t border-gray-200">
            <button type="button" data-action="checkbox-modal#cancel"
                    class="px-3 py-1.5 text-sm text-gray-600 hover:text-gray-900">Cancelar</button>
            <button type="button" data-action="checkbox-modal#confirm"
                    class="px-3 py-1.5 text-sm font-medium bg-amber-600 text-white rounded-lg hover:bg-amber-700">Confirmar</button>
          </div>
        </dialog>
      </div>

      <%# Retener en Miami — modal: motivos[] + nota. %>
      <div data-controller="checkbox-modal"
           class="px-3 py-2 rounded-lg ring-1 ring-gray-200 dark:ring-gray-700 hover:bg-amber-50 dark:hover:bg-amber-900/20 transition-colors">
        <label class="flex items-center gap-2 cursor-pointer">
          <%= f.check_box :retener_miami,
              data: { checkbox_modal_target: "checkbox", action: "change->checkbox-modal#onChange" },
              class: "rounded border-gray-300 text-amber-600 focus:ring-amber-500" %>
          <span class="text-sm font-medium text-gray-700 dark:text-gray-200">Retener en Miami</span>
          <% if paquete.retener_miami? %>
            <span class="ml-auto text-[10px] uppercase tracking-wider font-bold px-1.5 py-0.5 rounded bg-amber-100 text-amber-900">activo</span>
          <% end %>
        </label>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Especificá motivo(s) de la retención.</p>

        <dialog data-checkbox-modal-target="dialog"
                aria-labelledby="modal-retener-miami-title"
                style="margin: auto" class="rounded-xl p-0 w-[32rem] max-w-[95vw] backdrop:bg-black/40 ring-1 ring-amber-300">
          <div class="bg-amber-50 px-5 py-3 border-b border-amber-200">
            <h3 id="modal-retener-miami-title" class="text-base font-semibold text-amber-900">Retener en Miami</h3>
          </div>
          <div class="p-5 space-y-4 bg-white">
            <div>
              <span class="block text-sm font-medium text-gray-700 mb-1">Motivos</span>
              <% motivos = MotivoRetencion.activos.ordered %>
              <% if motivos.any? %>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  <% motivos.each do |m| %>
                    <label class="flex items-start gap-2 text-sm text-gray-800">
                      <%= check_box_tag "paquete[motivo_retencion_ids][]", m.id,
                          paquete.motivo_retencion_ids.include?(m.id),
                          class: "mt-0.5 rounded border-amber-300 text-amber-600 focus:ring-amber-500" %>
                      <span><%= m.nombre %></span>
                    </label>
                  <% end %>
                </div>
                <%= hidden_field_tag "paquete[motivo_retencion_ids][]", "" %>
              <% else %>
                <p class="text-xs text-amber-700 italic">No hay motivos configurados todavía.</p>
              <% end %>
            </div>
            <div>
              <%= f.label :notas_retencion, "Notas de retención (detalle del caso)",
                  class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.text_area :notas_retencion, rows: 3,
                  placeholder: "Detalle adicional. Obligatorio si no seleccionaste motivo.",
                  class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-amber-500 focus:border-amber-500" %>
            </div>
          </div>
          <div class="flex items-center justify-end gap-2 px-5 py-3 bg-gray-50 border-t border-gray-200">
            <button type="button" data-action="checkbox-modal#cancel"
                    class="px-3 py-1.5 text-sm text-gray-600 hover:text-gray-900">Cancelar</button>
            <button type="button" data-action="checkbox-modal#confirm"
                    class="px-3 py-1.5 text-sm font-medium bg-amber-600 text-white rounded-lg hover:bg-amber-700">Confirmar</button>
          </div>
        </dialog>
      </div>

      <%# Solicitó Recolecta — modal: zona + monto + moneda. %>
      <div data-controller="checkbox-modal"
           class="px-3 py-2 rounded-lg ring-1 ring-gray-200 dark:ring-gray-700 hover:bg-cec-teal/5 transition-colors">
        <label class="flex items-center gap-2 cursor-pointer">
          <%= f.check_box :recolecta_solicitada,
              data: { checkbox_modal_target: "checkbox", action: "change->checkbox-modal#onChange" },
              class: "rounded border-gray-300 text-cec-teal focus:ring-cec-teal" %>
          <span class="text-sm font-medium text-gray-700 dark:text-gray-200">Solicitó Recolecta</span>
          <% if paquete.recolecta_solicitada? %>
            <span class="ml-auto text-[10px] uppercase tracking-wider font-bold px-1.5 py-0.5 rounded bg-cec-teal/10 text-cec-teal-dark">
              <%= paquete.recolecta_monto.present? ? "#{paquete.recolecta_moneda} #{number_with_delimiter(paquete.recolecta_monto.to_f, precision: 2)}" : "activa" %>
            </span>
          <% end %>
        </label>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Elegí la zona / tarifa.</p>

        <dialog data-checkbox-modal-target="dialog"
                aria-labelledby="modal-recolecta-title"
                style="margin: auto" class="rounded-xl p-0 w-[32rem] max-w-[95vw] backdrop:bg-black/40 ring-1 ring-cec-teal/40">
          <div class="bg-cec-teal/10 px-5 py-3 border-b border-cec-teal/20">
            <h3 id="modal-recolecta-title" class="text-base font-semibold text-cec-navy dark:text-cec-gold">Solicitó Recolecta</h3>
          </div>
          <div class="p-5 space-y-4 bg-white">
            <div>
              <%= f.label :tarifa_recolecta_id, "Zona / Tarifa", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.collection_select :tarifa_recolecta_id, @tarifas_recolecta, :id, :to_s,
                    { include_blank: "— Sin tarifa del catálogo —" },
                    { class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" } %>
              <p class="mt-1 text-xs text-gray-500 italic">Al elegir, monto y moneda se autocompletan al guardar.</p>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <%= f.label :recolecta_monto, "Monto", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= f.number_field :recolecta_monto, step: "0.01", min: 0,
                    placeholder: "—",
                    class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" %>
              </div>
              <div>
                <%= f.label :recolecta_moneda, "Moneda", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= f.select :recolecta_moneda, [ %w[USD USD], %w[LPS LPS] ],
                      { include_blank: "—" },
                      { class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" } %>
              </div>
            </div>
            <p class="text-xs text-gray-600 italic">Se cobra automáticamente en la pre-factura.</p>
          </div>
          <div class="flex items-center justify-end gap-2 px-5 py-3 bg-gray-50 border-t border-gray-200">
            <button type="button" data-action="checkbox-modal#cancel"
                    class="px-3 py-1.5 text-sm text-gray-600 hover:text-gray-900">Cancelar</button>
            <button type="button" data-action="checkbox-modal#confirm"
                    class="px-3 py-1.5 text-sm font-medium bg-cec-teal text-white rounded-lg hover:bg-cec-teal-dark">Confirmar</button>
          </div>
        </dialog>
      </div>
    </div>

    <div class="lg:col-span-3">
      <%= f.label :notas_internas, "Notas Internas (solo equipo CEC)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :notas_internas, rows: 2,
          class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                 focus:ring-cec-teal focus:border-cec-teal" %>
    </div>

    <%# PR-D2: notas categorizadas %>
    <div class="lg:col-span-3"
         data-controller="plantilla-picker"
         data-plantilla-picker-target-selector-value="#paquete_notas_al_cliente">
      <div class="flex items-baseline justify-between mb-1">
        <%= f.label :notas_al_cliente, "Notas al Cliente (visibles al cliente)", class: "block text-sm font-medium text-gray-700" %>
        <% plantillas_activas = PlantillaNotaCliente.activas.ordered %>
        <% if plantillas_activas.any? %>
          <span class="text-[11px] text-gray-500">Plantillas:</span>
        <% end %>
      </div>
      <% if plantillas_activas.any? %>
        <div class="flex flex-wrap gap-1.5 mb-2">
          <% plantillas_activas.each do |plantilla| %>
            <button type="button"
                    data-action="plantilla-picker#insert"
                    data-text="<%= plantilla.texto %>"
                    class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium
                           bg-cec-teal/10 text-cec-teal hover:bg-cec-teal/20 transition-colors cursor-pointer">
              <%= plantilla.titulo %>
            </button>
          <% end %>
        </div>
      <% end %>
      <%= f.text_area :notas_al_cliente, rows: 2,
          placeholder: "Mensaje que el cliente verá en su portal / pre-factura.",
          class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                 focus:ring-cec-teal focus:border-cec-teal" %>
    </div>

    <div class="lg:col-span-3">
      <%= f.label :notas_consolidacion, "Notas de Consolidación", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :notas_consolidacion, rows: 2,
          placeholder: "Se llena automáticamente desde la pre-alerta consolidada al vincular.",
          class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                 focus:ring-cec-teal focus:border-cec-teal" %>
    </div>

    <%# El panel de Motivos de Retención + Notas de Retención vive ahora
        dentro del modal del checkbox "Retener en Miami" (más arriba). %>
  </div>

  <%# PR-D7.m: edición manual de fechas (solo admin / supervisor).
      `_by_user_id` se actualiza automáticamente en el modelo.
      Toda edición queda auditada via paper_trail; el timeline marca
      con badge "modificada" automáticamente. %>
  <% if can_change_estado_paquete? %>
    <div class="border-t border-gray-200 dark:border-gray-700 pt-6 mt-6">
      <div class="flex items-center gap-2 mb-2">
        <%= heroicon "calendar-days", variant: :solid, options: { class: "w-5 h-5 text-cec-navy dark:text-cec-gold" } %>
        <h3 class="text-base font-semibold text-gray-800 dark:text-gray-100">Editar Fechas</h3>
        <span class="text-[10px] font-semibold uppercase tracking-wider text-gray-500 bg-gray-100 dark:bg-gray-700 px-2 py-0.5 rounded-full">admin / supervisor</span>
      </div>
      <div class="flex items-start gap-2 mb-4 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-lg p-3 text-xs text-amber-800 dark:text-amber-200">
        <%= heroicon "exclamation-triangle", variant: :solid, options: { class: "w-4 h-4 shrink-0 mt-px" } %>
        <span>Las fechas que modifiques registrarán tus iniciales y aparecerán con badge <strong>"modificada"</strong> en la línea de tiempo. Toda edición queda auditada.</span>
      </div>

      <%
        # icon = heroicon del paso del timeline; with_time = mostrar selector de hora.
        fechas_config = [
          [:fecha_solicito_recolecta,  "Solicitud Recolecta",   "phone-arrow-up-right", false],
          [:fecha_pre_alerta,          "Pre-Alerta",            "bell-alert",           true],
          [:fecha_recibido_miami,      "Recibido en Miami",     "inbox-arrow-down",     true],
          [:fecha_empacado,            "Empacado",              "cube",                 true],
          [:fecha_enviado,             "Enviado a HND",         "paper-airplane",       true],
          [:fecha_aduana,              "Aduana",                "shield-check",         true],
          [:fecha_consolidando,        "Consolidando",          "archive-box",          true],
          [:fecha_disponible,          "Disponible Entrega",    "check-badge",          true],
          [:fecha_posible_entrega,     "Fecha Posible Entrega", "calendar",             false],
          [:fecha_en_reparto,          "En Reparto",            "truck",                true],
          [:fecha_entregado,           "Entregado",             "hand-thumb-up",        true]
        ]
      %>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <% fechas_config.each do |attr, label, icon, with_time| %>
          <% current_value = paquete.send(attr) %>
          <% display_value = current_value&.strftime(with_time ? "%Y-%m-%d %H:%M" : "%Y-%m-%d") %>
          <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-3 hover:border-cec-teal/40 hover:shadow-sm transition">
            <div class="flex items-center gap-2 mb-2">
              <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-cec-navy/10 dark:bg-cec-gold/15 text-cec-navy dark:text-cec-gold shrink-0">
                <%= heroicon icon, variant: :solid, options: { class: "w-3.5 h-3.5" } %>
              </span>
              <%= f.label attr, label, class: "text-xs font-semibold text-gray-700 dark:text-gray-200 uppercase tracking-wider" %>
            </div>
            <div class="relative" data-controller="flatpickr" data-flatpickr-time-value="<%= with_time %>">
              <%= f.text_field attr,
                  value: display_value,
                  placeholder: with_time ? "DD/MM/AAAA HH:MM" : "DD/MM/AAAA",
                  autocomplete: "off",
                  data: { flatpickr_target: "input" },
                  class: "block w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 shadow-sm text-sm py-2 pl-3 pr-9 focus:ring-cec-teal focus:border-cec-teal" %>
              <button type="button"
                      data-action="click->flatpickr#clear"
                      title="Limpiar fecha"
                      class="absolute inset-y-0 right-0 flex items-center px-2.5 text-gray-400 hover:text-red-500 focus:outline-none">
                <%= heroicon "x-mark", variant: :solid, options: { class: "w-4 h-4" } %>
              </button>
            </div>
            <% by_user_id = paquete.send("#{attr}_by_user_id") %>
            <% if by_user_id && (u = User.find_by(id: by_user_id)) %>
              <p class="mt-2 text-[11px] text-gray-500 dark:text-gray-400 flex items-center gap-1">
                <%= heroicon "user", variant: :outline, options: { class: "w-3 h-3" } %>
                <span>Por:</span>
                <span class="font-mono font-semibold text-gray-700 dark:text-gray-200"><%= u.iniciales_display %></span>
                <span class="text-gray-400 truncate">(<%= u.nombre %>)</span>
              </p>
            <% else %>
              <p class="mt-2 text-[11px] italic text-gray-400 dark:text-gray-500">Sin registro</p>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-200">
    <%= link_to "Cancelar (F2)", paquete_path(paquete),
        class: "text-sm text-gray-600 hover:text-gray-900",
        data: { shortcut: "F2" } %>
    <%= f.submit "Guardar Cambios (F10)",
        class: "inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium
               bg-cec-gold text-cec-navy-dark hover:bg-cec-gold-dark transition-colors cursor-pointer",
        data: { shortcut: "F10" } %>
  </div>
<% end %>
