<%= form_with model: paquete, class: "space-y-6" do |f| %>
  <% if paquete.errors.any? %>
    <div class="p-4 bg-red-50 rounded-lg">
      <div class="flex items-center gap-2 mb-2">
        <%= heroicon "exclamation-triangle", variant: :outline, options: { class: "w-5 h-5 text-red-600" } %>
        <h3 class="text-sm font-medium text-red-800">
          Se encontraron <%= paquete.errors.count %> error(es) al guardar:
        </h3>
      </div>
      <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
        <% paquete.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-3">
      <p class="text-sm text-gray-500 mb-1">Guia: <span class="font-mono font-medium text-cec-navy"><%= paquete.guia %></span></p>
    </div>

    <div class="lg:col-span-3">
      <%= f.label :tracking, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :tracking, required: true,
          class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm font-mono
                 focus:ring-cec-teal focus:border-cec-teal" %>
    </div>

    <div>
      <%= f.label :estado, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :estado, Paquete.estados.keys.map { |e| [e.humanize, e] },
          {},
          { class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                   focus:ring-cec-teal focus:border-cec-teal" } %>
    </div>

    <div>
      <%= f.label :tipo_envio_id, "Tipo de Envio", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.collection_select :tipo_envio_id, @tipo_envios, :id, :nombre,
          { include_blank: "— Seleccionar —" },
          { class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                   focus:ring-cec-teal focus:border-cec-teal" } %>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1">Carrier</label>
      <%= f.text_field :expedido_por, list: "carriers-list-edit",
          placeholder: "FedEx, UPS, USPS, DHL…",
          class: "block w-full rounded-lg border-gray-300 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100 shadow-sm text-sm
                 focus:ring-cec-teal focus:border-cec-teal" %>
      <datalist id="carriers-list-edit">
        <% @carriers.each do |carrier| %>
          <option value="<%= carrier.nombre %>">
        <% end %>
      </datalist>
      <p class="mt-1 text-xs text-gray-500 dark:text-gray-400 italic">
        Si escribís un carrier nuevo se agrega al catálogo automáticamente.
      </p>
    </div>

    <%# PR-D3.a: autocomplete contra el catálogo de proveedores. %>
    <div data-controller="proveedor-autocomplete"
         data-proveedor-autocomplete-url-value="<%= buscar_proveedores_path %>"
         class="relative">
      <%= f.label :proveedor_id, "Proveedor", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <% sel = paquete.proveedor %>
      <input type="text"
             value="<%= sel&.nombre || paquete[:proveedor].to_s %>"
             placeholder="Amazon, Walmart, Driver Juan…"
             autocomplete="off"
             data-proveedor-autocomplete-target="input"
             data-action="input->proveedor-autocomplete#search"
             class="block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal">
      <%= f.hidden_field :proveedor_id,
          data: { proveedor_autocomplete_target: "proveedorId" } %>
      <div data-proveedor-autocomplete-target="dropdown"
           class="hidden absolute z-10 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-64 overflow-auto"></div>
      <span data-proveedor-autocomplete-target="nombre"
            class="<%= sel ? '' : 'hidden ' %>mt-1 block text-xs text-gray-500 font-mono">
        <%= "(#{sel.codigo})" if sel %>
      </span>
    </div>

    <%# PR-D3.c (UX rev 2026-05-02): Tercero — cliente final cuando
        CEC le maneja la carga a otra empresa pequeña.
        Layout reorganizado: input con icono lupa flex-alineado +
        pill de "tercero seleccionado" debajo cuando aplica. %>
    <div class="lg:col-span-3"
         data-controller="tercero-search"
         data-tercero-search-url-value="<%= buscar_clientes_path %>">
      <% tercero_sel = paquete.tercero %>

      <%# Header del campo: label izquierda + descripción + clear button derecha %>
      <div class="flex items-center justify-between mb-1.5">
        <div class="flex items-center gap-2">
          <%= f.label :tercero_id, "Tercero",
              class: "text-sm font-medium text-gray-700 dark:text-gray-200" %>
          <span class="text-[11px] text-gray-400 dark:text-gray-500 italic">
            cliente final, si aplica
          </span>
        </div>
        <button type="button"
                data-tercero-search-target="clearButton"
                data-action="tercero-search#clear"
                class="<%= tercero_sel ? '' : 'hidden ' %>inline-flex items-center gap-1 text-xs text-gray-500 hover:text-red-600 transition-colors">
          <%= heroicon "x-mark", variant: :outline, options: { class: "w-3.5 h-3.5" } %>
          <span>Quitar</span>
        </button>
      </div>

      <%# Input con icono lupa flex-alineado dentro del input (no absolute hardcoded) %>
      <div class="relative">
        <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400">
          <%= heroicon "magnifying-glass", variant: :outline, options: { class: "w-4 h-4" } %>
        </span>
        <input type="text"
               value="<%= tercero_sel ? "#{tercero_sel.codigo} — #{tercero_sel.nombre_completo}" : '' %>"
               placeholder="Buscar tercero por código o nombre…"
               autocomplete="off"
               data-tercero-search-target="input"
               data-action="input->tercero-search#search"
               class="block w-full pl-10 pr-3 py-2.5 rounded-lg border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal">
        <%= f.hidden_field :tercero_id, data: { tercero_search_target: "terceroId" } %>

        <%# Dropdown ancla al input %>
        <div data-tercero-search-target="dropdown"
             class="hidden absolute z-20 mt-1 w-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-xl max-h-72 overflow-auto"></div>
      </div>

      <%# Selected state: pill con datos del tercero asignado %>
      <% if tercero_sel %>
        <div class="mt-2 inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-cec-purple/10 dark:bg-cec-purple/20 ring-1 ring-cec-purple/30">
          <%= heroicon "user-group", variant: :solid, options: { class: "w-3.5 h-3.5 text-cec-purple-dark dark:text-cec-purple-light" } %>
          <span class="text-[10px] uppercase tracking-wider font-bold text-cec-purple-dark dark:text-cec-purple-light">Asignado:</span>
          <span class="font-mono text-xs text-cec-navy dark:text-cec-gold"><%= tercero_sel.codigo %></span>
          <span class="text-xs text-gray-700 dark:text-gray-200"><%= tercero_sel.nombre_completo %></span>
        </div>
      <% end %>

      <p class="mt-2 text-[11px] text-gray-500 dark:text-gray-400">
        Usa esto cuando le manejas la carga a una empresa pequeña que tiene su propio cliente final.
      </p>
    </div>

    <div>
      <%= f.label :peso, "Peso (lbs)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :peso, step: 0.01, min: 0,
          class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                 focus:ring-cec-teal focus:border-cec-teal" %>
    </div>

    <div class="grid grid-cols-3 gap-2">
      <div>
        <%= f.label :alto, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :alto, step: 0.01, min: 0,
            class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                   focus:ring-cec-teal focus:border-cec-teal" %>
      </div>
      <div>
        <%= f.label :largo, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :largo, step: 0.01, min: 0,
            class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                   focus:ring-cec-teal focus:border-cec-teal" %>
      </div>
      <div>
        <%= f.label :ancho, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :ancho, step: 0.01, min: 0,
            class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                   focus:ring-cec-teal focus:border-cec-teal" %>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :cantidad_productos, "Cant. Productos", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :cantidad_productos, min: 0,
            class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                   focus:ring-cec-teal focus:border-cec-teal" %>
      </div>
      <div>
        <%= f.label :cantidad_paquetes, "Cant. Paquetes", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :cantidad_paquetes, min: 0,
            class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                   focus:ring-cec-teal focus:border-cec-teal" %>
      </div>
    </div>

    <div class="lg:col-span-2">
      <%= f.label :descripcion, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :descripcion, rows: 2,
          class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                 focus:ring-cec-teal focus:border-cec-teal" %>
    </div>

    <div>
      <%= f.label :remitente, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :remitente,
          class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                 focus:ring-cec-teal focus:border-cec-teal" %>
    </div>

    <div class="lg:col-span-3 flex flex-wrap gap-6">
      <div class="flex items-center gap-2">
        <%= f.check_box :pre_alerta, class: "rounded border-gray-300 text-cec-teal focus:ring-cec-teal" %>
        <%= f.label :pre_alerta, "Pre-Alerta", class: "text-sm font-medium text-gray-700" %>
      </div>
      <%# La columna boolean `pre_factura` tiene un name clash con el
          belongs_to :pre_factura (FK). Usamos check_box_tag para
          leer/escribir la columna directamente sin pasar por el
          accessor de la asociación. %>
      <div class="flex items-center gap-2">
        <%= hidden_field_tag "paquete[pre_factura]", "0" %>
        <%= check_box_tag "paquete[pre_factura]", "1",
            ActiveModel::Type::Boolean.new.cast(paquete[:pre_factura]),
            id: "paquete_pre_factura_flag",
            class: "rounded border-gray-300 text-cec-teal focus:ring-cec-teal" %>
        <label for="paquete_pre_factura_flag" class="text-sm font-medium text-gray-700">Pre-Factura</label>
      </div>
      <div class="flex items-center gap-2">
        <%= f.check_box :solicito_cambio_servicio, class: "rounded border-gray-300 text-cec-teal focus:ring-cec-teal" %>
        <%= f.label :solicito_cambio_servicio, "Cambio de Servicio", class: "text-sm font-medium text-gray-700" %>
      </div>
      <div class="flex items-center gap-2">
        <%= f.check_box :retener_miami, class: "rounded border-gray-300 text-cec-teal focus:ring-cec-teal" %>
        <%= f.label :retener_miami, "Retener en Miami", class: "text-sm font-medium text-gray-700" %>
      </div>
      <div class="flex items-center gap-2">
        <%= f.check_box :recolecta_solicitada, class: "rounded border-gray-300 text-cec-teal focus:ring-cec-teal" %>
        <%= f.label :recolecta_solicitada, "Solicitó Recolecta", class: "text-sm font-medium text-gray-700 dark:text-gray-200" %>
      </div>
    </div>

    <%# PR-D6.a: cuando se marca "Solicitó Recolecta", aparece la zona
        del catálogo. Al elegir una tarifa, el monto y la moneda se
        autocompletan; el cajero puede sobreescribir manualmente. %>
    <div class="lg:col-span-3 grid grid-cols-1 md:grid-cols-3 gap-4 p-4 rounded-lg bg-gray-50 dark:bg-gray-800/50 ring-1 ring-gray-200 dark:ring-gray-700">
      <div>
        <%= f.label :tarifa_recolecta_id, "Zona / Tarifa de Recolecta", class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>
        <%= f.collection_select :tarifa_recolecta_id, @tarifas_recolecta, :id, :to_s,
              { include_blank: "— Sin tarifa del catálogo —" },
              { class: "block w-full rounded-lg border-gray-300 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" } %>
        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400 italic">Al elegir, el monto y moneda se autocompletan.</p>
      </div>
      <div>
        <%= f.label :recolecta_monto, "Monto Recolecta", class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>
        <%= f.number_field :recolecta_monto, step: "0.01", min: 0,
            placeholder: "—",
            class: "block w-full rounded-lg border-gray-300 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" %>
      </div>
      <div>
        <%= f.label :recolecta_moneda, "Moneda", class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>
        <%= f.select :recolecta_moneda, [ %w[USD USD], %w[LPS LPS] ],
              { include_blank: "—" },
              { class: "block w-full rounded-lg border-gray-300 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" } %>
      </div>
    </div>

    <div class="lg:col-span-3">
      <%= f.label :notas_internas, "Notas Internas (solo equipo CEC)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :notas_internas, rows: 2,
          class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                 focus:ring-cec-teal focus:border-cec-teal" %>
    </div>

    <%# PR-D2: notas categorizadas %>
    <div class="lg:col-span-3"
         data-controller="plantilla-picker"
         data-plantilla-picker-target-selector-value="#paquete_notas_al_cliente">
      <div class="flex items-baseline justify-between mb-1">
        <%= f.label :notas_al_cliente, "Notas al Cliente (visibles al cliente)", class: "block text-sm font-medium text-gray-700" %>
        <% plantillas_activas = PlantillaNotaCliente.activas.ordered %>
        <% if plantillas_activas.any? %>
          <span class="text-[11px] text-gray-500">Plantillas:</span>
        <% end %>
      </div>
      <% if plantillas_activas.any? %>
        <div class="flex flex-wrap gap-1.5 mb-2">
          <% plantillas_activas.each do |plantilla| %>
            <button type="button"
                    data-action="plantilla-picker#insert"
                    data-text="<%= plantilla.texto %>"
                    class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium
                           bg-cec-teal/10 text-cec-teal hover:bg-cec-teal/20 transition-colors cursor-pointer">
              <%= plantilla.titulo %>
            </button>
          <% end %>
        </div>
      <% end %>
      <%= f.text_area :notas_al_cliente, rows: 2,
          placeholder: "Mensaje que el cliente verá en su portal / pre-factura.",
          class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                 focus:ring-cec-teal focus:border-cec-teal" %>
    </div>

    <div class="lg:col-span-3">
      <%= f.label :notas_consolidacion, "Notas de Consolidación", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :notas_consolidacion, rows: 2,
          placeholder: "Se llena automáticamente desde la pre-alerta consolidada al vincular.",
          class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                 focus:ring-cec-teal focus:border-cec-teal" %>
    </div>

    <div class="lg:col-span-3 rounded-lg border border-amber-200 bg-amber-50 p-4 space-y-3">
      <div>
        <%= f.label :motivos_retencion, "Motivos de Retención",
            class: "block text-sm font-medium text-amber-900 mb-1" %>
        <p class="text-xs text-amber-700 mb-2">Selecciona uno o varios cuando el paquete se retiene en bodega.</p>
        <% motivos = MotivoRetencion.activos.ordered %>
        <% if motivos.any? %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <% motivos.each do |m| %>
              <label class="flex items-start gap-2 text-sm text-amber-900">
                <%= check_box_tag "paquete[motivo_retencion_ids][]", m.id,
                    paquete.motivo_retencion_ids.include?(m.id),
                    class: "mt-0.5 rounded border-amber-300 text-amber-600 focus:ring-amber-500" %>
                <span><%= m.nombre %></span>
              </label>
            <% end %>
          </div>
          <%= hidden_field_tag "paquete[motivo_retencion_ids][]", "" %>
        <% else %>
          <p class="text-xs text-amber-700 italic">No hay motivos configurados todavía.</p>
        <% end %>
      </div>
      <div>
        <%= f.label :notas_retencion, "Notas de Retención (detalle del caso)",
            class: "block text-sm font-medium text-amber-900 mb-1" %>
        <%= f.text_area :notas_retencion, rows: 2,
            placeholder: "Detalle adicional. Obligatorio si no seleccionaste motivo y el estado es 'retenido'.",
            class: "block w-full rounded-lg border-amber-300 shadow-sm text-sm bg-white
                   focus:ring-amber-500 focus:border-amber-500" %>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-200">
    <%= link_to "Cancelar (F2)", paquete_path(paquete),
        class: "text-sm text-gray-600 hover:text-gray-900",
        data: { shortcut: "F2" } %>
    <%= f.submit "Guardar Cambios (F10)",
        class: "inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium
               bg-cec-gold text-cec-navy-dark hover:bg-cec-gold-dark transition-colors cursor-pointer",
        data: { shortcut: "F10" } %>
  </div>
<% end %>
