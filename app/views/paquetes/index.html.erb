<%= render PageHeaderComponent.new(title: "Todos los Paquetes", subtitle: "#{@paquetes.total_count} paquetes") do |header|
  current_params = request.query_parameters
  header.with_action do
    render ButtonComponent.new(variant: :secondary, href: export_paquetes_path(current_params.merge(format: :xlsx)), icon: "arrow-down-tray") do
      "Excel"
    end
  end
  header.with_action do
    render ButtonComponent.new(variant: :secondary, href: export_paquetes_path(current_params.merge(format: :pdf)), icon: "document-arrow-down") do
      "PDF"
    end
  end
end %>

<%# Barra de busqueda global (refinada: tracking, numero_recepcion, guia, cliente, contenido, tipo envio, manifiesto) %>
<div class="mb-4">
  <%= render SearchBarComponent.new(
    url: paquetes_path,
    placeholder: "Buscar por tracking, número recepción, cliente, contenido, tipo envío o manifiesto...",
    value: params[:q]
  ) %>
</div>

<%# Color legend %>
<div class="mb-4 flex flex-wrap gap-3 text-xs text-gray-700 dark:text-gray-300">
  <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-cec-teal/10 border border-cec-teal/30"></span> Pre-Alerta</span>
  <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-blue-100 border border-blue-200"></span> Pre-Factura</span>
  <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-amber-100 border border-amber-200"></span> Cambio Servicio</span>
  <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-amber-50 border border-amber-200"></span> Retener Miami</span>
</div>

<%# Panel de filtros avanzados %>
<% active_filters_count = [
  Array(params[:estados]).reject(&:blank?).any?,
  Array(params[:tipo_envio_ids]).reject(&:blank?).any?,
  Array(params[:sucursal_ids]).reject(&:blank?).any?,
  params[:fecha_desde].present?, params[:fecha_hasta].present?,
  params[:solo_facturados] == "1", params[:incluir_facturados] == "0",
  params[:sin_prealerta] == "1",
  params[:incluir_3_12_meses] == "1", params[:incluir_mas_1_ano] == "1"
].count(true) %>

<details class="mb-6 bg-white dark:bg-gray-800 rounded-lg shadow" <%= "open" if active_filters_count.positive? %>>
  <summary class="px-6 py-3 cursor-pointer text-sm font-medium text-gray-700 dark:text-gray-200 hover:text-cec-navy dark:hover:text-cec-gold flex items-center gap-2">
    <%= heroicon "funnel", variant: :outline, options: { class: "w-4 h-4" } %>
    Filtros avanzados
    <% if active_filters_count.positive? %>
      <span class="bg-cec-navy text-white text-xs px-2 py-0.5 rounded-full"><%= active_filters_count %></span>
    <% end %>
  </summary>
  <div class="px-6 py-4 border-t border-gray-200 dark:border-gray-700">
    <%= form_tag paquetes_path, method: :get, class: "space-y-5" do %>
      <% if params[:q].present? %>
        <%= hidden_field_tag :q, params[:q] %>
      <% end %>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <%# Tipo envio multi-select %>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">Tipo de envío</label>
          <div class="grid grid-cols-2 gap-2">
            <% @tipo_envios.each do |te| %>
              <label class="flex items-center gap-2 text-xs text-gray-700 dark:text-gray-200">
                <%= check_box_tag "tipo_envio_ids[]", te.id, Array(params[:tipo_envio_ids]).include?(te.id.to_s),
                    class: "rounded border-gray-300 text-cec-teal focus:ring-cec-teal" %>
                <span class="font-mono uppercase"><%= te.codigo %></span>
                <span class="text-gray-500 dark:text-gray-400 truncate"><%= te.nombre %></span>
              </label>
            <% end %>
          </div>
        </div>

        <%# Sucursal multi-select %>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">Sucursal</label>
          <div class="grid grid-cols-1 gap-2">
            <% @sucursales.each do |s| %>
              <label class="flex items-center gap-2 text-xs text-gray-700 dark:text-gray-200">
                <%= check_box_tag "sucursal_ids[]", s.id, Array(params[:sucursal_ids]).include?(s.id.to_s),
                    class: "rounded border-gray-300 text-cec-teal focus:ring-cec-teal" %>
                <span class="font-mono"><%= s.codigo %></span>
                <span class="text-gray-500 dark:text-gray-400"><%= s.nombre %></span>
              </label>
            <% end %>
          </div>
        </div>

        <%# Rango de fechas %>
        <div class="space-y-2">
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1">Desde</label>
            <%= date_field_tag :fecha_desde, params[:fecha_desde],
                class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal",
                data: { controller: "flatpickr" } %>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1">Hasta</label>
            <%= date_field_tag :fecha_hasta, params[:fecha_hasta],
                class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal",
                data: { controller: "flatpickr" } %>
          </div>
        </div>
      </div>

      <%# Estado multi-select ocupa full width por ser ~15 opciones %>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">Estado del paquete</label>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
          <% @estados_paquete.each do |est| %>
            <label class="flex items-center gap-2 text-xs text-gray-700 dark:text-gray-200">
              <%= check_box_tag "estados[]", est, Array(params[:estados]).include?(est),
                  class: "rounded border-gray-300 text-cec-teal focus:ring-cec-teal" %>
              <span><%= est.humanize %></span>
            </label>
          <% end %>
        </div>
      </div>

      <%# Quick toggles %>
      <div class="flex flex-wrap gap-4 pt-2 border-t border-gray-100 dark:border-gray-700">
        <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-200">
          <%= check_box_tag :solo_facturados, "1", params[:solo_facturados] == "1", class: "rounded border-gray-300 text-cec-teal focus:ring-cec-teal" %>
          Solo facturados
        </label>
        <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-200">
          <%= check_box_tag :incluir_facturados, "0", params[:incluir_facturados] == "0", class: "rounded border-gray-300 text-cec-teal focus:ring-cec-teal" %>
          Excluir facturados
        </label>
        <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-200">
          <%= check_box_tag :sin_prealerta, "1", params[:sin_prealerta] == "1", class: "rounded border-gray-300 text-cec-teal focus:ring-cec-teal" %>
          Sin pre-alerta
        </label>
        <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-200">
          <%= check_box_tag :incluir_3_12_meses, "1", params[:incluir_3_12_meses] == "1", class: "rounded border-gray-300 text-cec-teal focus:ring-cec-teal" %>
          Incluir 3-12 meses
        </label>
        <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-200">
          <%= check_box_tag :incluir_mas_1_ano, "1", params[:incluir_mas_1_ano] == "1", class: "rounded border-gray-300 text-cec-teal focus:ring-cec-teal" %>
          Incluir &gt; 1 año
        </label>
      </div>

      <div class="flex gap-3 pt-2">
        <button type="submit" class="px-4 py-2 text-sm font-medium bg-cec-navy text-white rounded-lg hover:bg-cec-navy-light">Aplicar filtros</button>
        <%= link_to "Limpiar", paquetes_path, class: "px-4 py-2 text-sm text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white" %>
      </div>
    <% end %>
  </div>
</details>

<% if @paquetes.any? %>
  <div data-controller="bulk-selection">
    <%# Barra flotante con acciones bulk (aparece cuando count > 0) %>
    <div data-bulk-selection-target="bar"
         class="hidden sticky top-0 z-10 mb-3 bg-cec-navy text-white rounded-lg shadow-lg px-4 py-3 flex flex-wrap items-center justify-between gap-3">
      <div class="text-sm">
        <span data-bulk-selection-target="counter">0</span> paquete(s) seleccionado(s)
      </div>
      <div class="flex items-center gap-2">
        <%= form_tag bulk_print_paquetes_path, method: :post, class: "inline" do %>
          <div data-bulk-selection-target="idsField"></div>
          <button type="submit" class="bg-white text-cec-navy font-semibold px-3 py-1.5 rounded text-xs hover:bg-gray-100">Imprimir</button>
        <% end %>
        <%= form_tag bulk_export_paquetes_path, method: :post, class: "inline" do %>
          <div data-bulk-selection-target="idsField"></div>
          <%= hidden_field_tag :formato, "xlsx" %>
          <button type="submit" class="bg-white text-cec-navy font-semibold px-3 py-1.5 rounded text-xs hover:bg-gray-100">Excel</button>
        <% end %>
        <%= form_tag bulk_export_paquetes_path, method: :post, class: "inline" do %>
          <div data-bulk-selection-target="idsField"></div>
          <%= hidden_field_tag :formato, "pdf" %>
          <button type="submit" class="bg-white text-cec-navy font-semibold px-3 py-1.5 rounded text-xs hover:bg-gray-100">PDF</button>
        <% end %>
        <button type="button" data-action="click->bulk-selection#clear" class="text-white/70 hover:text-white text-xs underline">Limpiar</button>
      </div>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-lg shadow overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 text-sm">
          <thead class="bg-gray-50 dark:bg-gray-900">
            <tr>
              <th class="px-3 py-3 text-left text-[10px] font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider">
                <input type="checkbox" data-bulk-selection-target="selectAll"
                       data-action="change->bulk-selection#toggleAll"
                       class="rounded border-gray-300 text-cec-teal focus:ring-cec-teal"
                       aria-label="Seleccionar todos">
              </th>
            <th class="px-3 py-3 text-left text-[10px] font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider">F. recibido</th>
            <th class="px-3 py-3 text-left text-[10px] font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider">F. disponible</th>
            <th class="px-3 py-3 text-left text-[10px] font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider">N° recepción</th>
            <th class="px-3 py-3 text-left text-[10px] font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider">Tracking</th>
            <th class="px-3 py-3 text-left text-[10px] font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider">Cliente</th>
            <th class="px-3 py-3 text-left text-[10px] font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider">Estado</th>
            <th class="px-3 py-3 text-center text-[10px] font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider">T.E.</th>
            <th class="px-3 py-3 text-center text-[10px] font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider">Cons.</th>
            <th class="px-3 py-3 text-left text-[10px] font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider">Contenido</th>
            <th class="px-3 py-3 text-center text-[10px] font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider" title="Pre-Alerta">PA</th>
            <th class="px-3 py-3 text-center text-[10px] font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider" title="Pre-Factura">PF</th>
            <th class="px-3 py-3 text-center text-[10px] font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider" title="Factura">FA</th>
            <th class="px-3 py-3 text-center text-[10px] font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider">Ed.</th>
            <th class="px-3 py-3 text-center text-[10px] font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider">Bo.</th>
            <th class="px-3 py-3 text-center text-[10px] font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider">Im.</th>
          </tr>
        </thead>
        <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-100 dark:divide-gray-700">
          <% @paquetes.each do |paquete| %>
            <%
              row_class = if paquete.retener_miami?
                "bg-amber-50 dark:bg-amber-900/20"
              elsif paquete.solicito_cambio_servicio?
                "bg-amber-100/60 dark:bg-amber-900/30"
              elsif paquete.pre_factura?
                "bg-blue-50 dark:bg-blue-900/20"
              elsif paquete.pre_alerta?
                "bg-cec-teal/5 dark:bg-cec-teal/10"
              else
                ""
              end
              pa = paquete.pre_alerta_paquetes.first&.pre_alerta
              pf = paquete.pre_factura
              fa = paquete.venta
              is_consolidado = paquete.consolidado?
            %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 <%= row_class %>">
              <td class="px-3 py-2">
                <input type="checkbox" value="<%= paquete.id %>"
                       data-bulk-selection-target="row"
                       data-action="change->bulk-selection#toggleRow"
                       class="rounded border-gray-300 text-cec-teal focus:ring-cec-teal">
              </td>
              <td class="px-3 py-2 whitespace-nowrap text-xs text-gray-600 dark:text-gray-300">
                <%= paquete.fecha_recibido_miami&.strftime("%d/%m/%Y") || paquete.created_at.strftime("%d/%m/%Y") %>
              </td>
              <td class="px-3 py-2 whitespace-nowrap text-xs text-gray-600 dark:text-gray-300">
                <%= paquete.fecha_disponible&.strftime("%d/%m/%Y") || "—" %>
              </td>
              <td class="px-3 py-2 whitespace-nowrap">
                <span class="font-mono text-xs font-semibold text-cec-navy dark:text-cec-gold"><%= paquete.numero_recepcion || paquete.guia %></span>
              </td>
              <td class="px-3 py-2 whitespace-nowrap">
                <%= link_to truncate(paquete.tracking, length: 18), paquete, class: "font-mono text-xs text-gray-700 dark:text-gray-200 hover:underline" %>
              </td>
              <td class="px-3 py-2 whitespace-nowrap">
                <p class="text-xs font-medium text-gray-800 dark:text-gray-100 truncate max-w-[180px]"><%= paquete.cliente.nombre_completo %></p>
                <p class="text-[10px] text-gray-500 font-mono"><%= paquete.cliente.codigo %></p>
              </td>
              <td class="px-3 py-2 whitespace-nowrap">
                <%= render StatusBadgeComponent.new(status: paquete.estado) %>
                <% if paquete.disponible_entrega? && paquete.sucursal %>
                  <p class="text-[10px] text-gray-500 dark:text-gray-400 mt-0.5">en <%= paquete.sucursal.nombre %></p>
                <% end %>
              </td>
              <td class="px-3 py-2 whitespace-nowrap text-center">
                <span class="font-mono text-[10px] font-bold text-cec-navy dark:text-cec-gold-light"><%= paquete.tipo_envio&.codigo&.upcase || "—" %></span>
              </td>
              <td class="px-3 py-2 whitespace-nowrap text-center">
                <% if is_consolidado %>
                  <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-semibold bg-cec-teal/10 text-cec-teal-dark dark:bg-cec-teal/20 dark:text-cec-teal-light">Cons.</span>
                <% else %>
                  <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-semibold bg-gray-100 text-gray-500 dark:bg-gray-700 dark:text-gray-400">—</span>
                <% end %>
              </td>
              <td class="px-3 py-2 whitespace-normal max-w-[200px]">
                <span class="text-xs text-gray-600 dark:text-gray-300 line-clamp-2"><%= paquete.descripcion.presence || "—" %></span>
              </td>
              <td class="px-3 py-2 text-center">
                <% if pa %>
                  <%= link_to cuenta_pre_alerta_path(pa), class: "inline-flex text-cec-teal dark:text-cec-teal-light hover:text-cec-teal-dark", title: "Ver Pre-Alerta #{pa.numero_documento}" do %>
                    <%= heroicon "bell-alert", variant: :solid, options: { class: "w-4 h-4" } %>
                  <% end %>
                <% else %>
                  <span class="inline-flex text-gray-300 dark:text-gray-600" title="Sin pre-alerta"><%= heroicon "bell-alert", variant: :outline, options: { class: "w-4 h-4" } %></span>
                <% end %>
              </td>
              <td class="px-3 py-2 text-center">
                <% if pf %>
                  <%= link_to pre_factura_path(pf), class: "inline-flex text-cec-teal dark:text-cec-teal-light hover:text-cec-teal-dark", title: "Ver Pre-Factura" do %>
                    <%= heroicon "document-text", variant: :solid, options: { class: "w-4 h-4" } %>
                  <% end %>
                <% else %>
                  <span class="inline-flex text-gray-300 dark:text-gray-600" title="Sin pre-factura"><%= heroicon "document-text", variant: :outline, options: { class: "w-4 h-4" } %></span>
                <% end %>
              </td>
              <td class="px-3 py-2 text-center">
                <% if fa %>
                  <%= link_to venta_path(fa), class: "inline-flex text-cec-teal dark:text-cec-teal-light hover:text-cec-teal-dark", title: "Ver Factura #{fa.numero}" do %>
                    <%= heroicon "currency-dollar", variant: :solid, options: { class: "w-4 h-4" } %>
                  <% end %>
                <% else %>
                  <span class="inline-flex text-gray-300 dark:text-gray-600" title="Sin factura"><%= heroicon "currency-dollar", variant: :outline, options: { class: "w-4 h-4" } %></span>
                <% end %>
              </td>
              <td class="px-3 py-2 text-center">
                <%= link_to edit_paquete_path(paquete), class: "inline-flex text-gray-400 hover:text-cec-navy dark:hover:text-cec-gold", title: "Editar" do %>
                  <%= heroicon "pencil-square", variant: :outline, options: { class: "w-4 h-4" } %>
                <% end %>
              </td>
              <td class="px-3 py-2 text-center">
                <% if admin? %>
                  <span class="inline-flex text-gray-300 dark:text-gray-600" title="Borrar (próximo PR)">
                    <%= heroicon "trash", variant: :outline, options: { class: "w-4 h-4" } %>
                  </span>
                <% end %>
              </td>
              <td class="px-3 py-2 text-center">
                <%= link_to label_paquete_path(paquete), target: "_blank", class: "inline-flex text-gray-400 hover:text-cec-navy dark:hover:text-cec-gold", title: "Imprimir etiqueta" do %>
                  <%= heroicon "printer", variant: :outline, options: { class: "w-4 h-4" } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    </div>
  </div>

  <div class="mt-4">
    <%= paginate @paquetes %>
  </div>
<% else %>
  <%= render EmptyStateComponent.new(
    title: params[:q].present? || active_filters_count.positive? ? "No se encontraron paquetes" : "No hay paquetes registrados",
    description: params[:q].present? || active_filters_count.positive? ? "Intenta con otros filtros." : "Los paquetes apareceran aqui cuando se etiqueten.",
    icon: "archive-box"
  ) %>
<% end %>
