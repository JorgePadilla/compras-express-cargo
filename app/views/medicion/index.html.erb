<%# C26-02 · Medición: la estación de San Pedro.

    Se escanea el **warehouse receipt** de la etiqueta que Miami le pegó a la
    caja. La pantalla contesta con tres cosas, que es lo que Jorge corrigió de
    la primera versión: *"me tiene que avisar cómo está en la pre-alerta y cómo
    ingresó en Miami… los cuadritos: lo que está y lo que falta"*.

      · lo que el **cliente declaró** en la pre-alerta;
      · cómo la **ingresó Miami** (puede no coincidir, y esa diferencia importa);
      · la **grilla del grupo**: un cuadrito por caja, con su estado.

    Se miden todas, y al completar el grupo salen **todas las stickers juntas**.
    Si falta alguna y hay que pasar igual, el modal rojo lo dice y se pasa
    —*"se pone una alerta y se pasa"*—, con el sello de quién y qué faltaba. %>
<div data-controller="medicion audio"
     <%= tag.attributes(atributos_de_audio) %>
     data-medicion-escanear-url-value="<%= escanear_medicion_index_path %>"
     data-medicion-panel-url-value="<%= panel_medicion_index_path %>"
     <%# La URL de la etiqueta la manda el servidor con cada medición; este
         template es el respaldo de «Reimprimir» y, de paso, la puerta que
         `pantallas_en_el_menu_test` exige para una ruta anidada. %>
     data-medicion-etiqueta-url-template-value="<%= etiqueta_medicion_path(id: "ID", print: true) %>"
     <%# Las clases de cada estado del cuadrito viven acá y no en el JS: Tailwind
         escanea los `.erb` para saber qué clases compilar, y una clase que solo
         existe dentro de un string de JavaScript **no se compila**. %>
     data-medicion-clases-value='<%= {
           medida:       "border-cec-teal bg-cec-teal/10 text-cec-teal-dark",
           aqui:         "border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800",
           en_camino:    "border-amber-300 bg-amber-50 text-amber-900",
           esperada:     "border-dashed border-gray-300 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 opacity-60",
           seleccionada: "border-cec-gold bg-cec-gold/30 ring-4 ring-cec-gold/60 shadow-lg text-cec-navy dark:text-cec-gold"
         }.to_json %>'
     data-action="medicion:ok->audio#success
                  medicion:unir->audio#alert
                  medicion:grupoCompleto->audio#success
                  medicion:yaMedido->audio#notify
                  medicion:atencion->audio#notify
                  medicion:problema->audio#error
                  medicion:guardado->audio#success
                  medicion:fallo->audio#error">

  <%= render PageHeaderComponent.new(title: "Medición", subtitle: "Escaneá el warehouse receipt, pesá y medí. Si el cliente está uniendo, acá ves lo que falta.") do |h| %>
    <% h.with_action { render "shared/sonido_config" } %>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
      <%# ── a · la pistola ─────────────────────────────────────────────── %>
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
        <%= label_tag :codigo_medicion, "Escaneá el warehouse receipt de la etiqueta de Miami", class: "block text-base font-medium text-gray-700 dark:text-gray-200 mb-1" %>
        <%= text_field_tag :codigo_medicion, nil, autofocus: true, autocomplete: "off",
              placeholder: "RMI0002026000042-2 (o el tracking)",
              data: { medicion_target: "codigo", action: "keydown->medicion#teclado" },
              class: "block w-full min-h-14 text-2xl font-mono rounded-lg border-gray-300 shadow-sm focus:ring-cec-teal focus:border-cec-teal" %>
        <p class="mt-2 text-sm text-gray-500 dark:text-gray-400" data-medicion-target="aviso">Enter escanea. Los errores salen en rojo, grande.</p>
      </div>

      <%# ── b · los dos lados del dato ─────────────────────────────────── %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 hidden" data-medicion-target="dosLados">
        <%# Lo que el cliente declaró. %>
        <div class="rounded-lg ring-1 ring-gray-200 dark:ring-gray-700 p-4 hidden" data-medicion-target="panelPreAlerta">
          <p class="text-xs uppercase tracking-wider font-semibold text-gray-500 dark:text-gray-400">Lo que declaró el cliente</p>
          <p class="mt-1 font-mono font-bold text-cec-navy dark:text-cec-gold" data-medicion-target="paNumero"></p>
          <p class="text-sm text-gray-800 dark:text-gray-100" data-medicion-target="paTitulo"></p>
          <p class="text-sm text-gray-500 dark:text-gray-400" data-medicion-target="paDetalle"></p>
          <p class="mt-1 text-sm text-amber-800 dark:text-amber-400 font-medium" data-medicion-target="paBanderas"></p>
          <p class="mt-1 text-sm text-gray-600 dark:text-gray-300 whitespace-pre-line" data-medicion-target="paNotas"></p>
        </div>

        <%# Cómo lo ingresó Miami. %>
        <div class="rounded-lg ring-1 ring-gray-200 dark:ring-gray-700 p-4 hidden" data-medicion-target="panelMiami">
          <p class="text-xs uppercase tracking-wider font-semibold text-gray-500 dark:text-gray-400">Cómo ingresó Miami</p>
          <p class="mt-1 font-mono font-bold text-cec-navy dark:text-cec-gold" data-medicion-target="miamiWr"></p>
          <p class="text-sm text-gray-800 dark:text-gray-100" data-medicion-target="miamiDetalle"></p>
          <p class="text-sm text-gray-500 dark:text-gray-400" data-medicion-target="miamiDescripcion"></p>
          <p class="mt-1 text-sm text-red-700 font-medium hidden" data-medicion-target="miamiRetenido">Retenido en Miami</p>
        </div>
      </div>

      <%# ── c · la grilla del grupo ────────────────────────────────────── %>
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6 hidden" data-medicion-target="grupo">
        <div class="flex flex-wrap items-baseline justify-between gap-2 mb-3">
          <p class="text-lg font-bold text-gray-800 dark:text-gray-100" data-medicion-target="grupoTitulo"></p>
          <p class="text-sm text-gray-500 dark:text-gray-400" data-medicion-target="grupoSello"></p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-6 gap-3" data-medicion-target="grilla"></div>
        <%# Reimprimir vive **una sola vez**, en el panel de la caja con su
            tecla. Acá estaba repetido, y con el otro camino —el que tenía el
            bug de imprimir una sola. %>
        <div class="mt-4 flex flex-wrap gap-3">
          <%= render(ButtonComponent.new(variant: :danger, size: :md, label: "Facturar lo que hay, sin el grupo completo",
                data: { medicion_target: "facturarParcial", action: "medicion#abrirExcepcion" }, class: "hidden")) { "Facturar lo que hay" } %>
        </div>

        <%# El cuadrito vive en el ERB y no en el JS: el markup se lee acá, y
            Tailwind ve sus clases. El JS solo lo clona y lo llena. %>
        <template data-medicion-target="plantillaCuadrito">
          <%# El nombre accesible arranca genérico y el JS lo reemplaza por el
              warehouse receipt de la caja: un botón cuyo texto llega por JS nace
              mudo para el lector de pantalla. %>
          <button type="button" data-action="medicion#elegirCaja" aria-label="Elegir esta caja para medirla"
                  class="w-full min-h-11 p-3 rounded-xl border-2 flex flex-col items-center gap-0.5 text-center transition foco-cec">
            <span class="text-[10px] font-bold tracking-wider text-cec-navy dark:text-cec-gold" data-campo="marca"></span>
            <span class="font-mono text-sm font-bold leading-tight" data-campo="wr"></span>
            <span class="text-[11px] text-gray-500 dark:text-gray-400" data-campo="caja"></span>
            <span class="text-[11px] font-medium" data-campo="estado"></span>
            <span class="text-[11px] font-mono text-gray-600 dark:text-gray-300" data-campo="peso"></span>
          </button>
        </template>
      </div>

      <%# ── d · la caja y sus números ──────────────────────────────────── %>
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6 hidden" data-medicion-target="panel">
        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
          <span class="text-2xl font-mono font-bold text-cec-navy dark:text-cec-gold" data-medicion-target="codigoCaja"></span>
          <span class="text-sm font-mono text-gray-500" data-medicion-target="tracking"></span>
          <span class="text-sm text-gray-500" data-medicion-target="caja"></span>
        </div>
        <p class="mt-1 text-lg text-gray-800 dark:text-gray-100" data-medicion-target="cliente"></p>
        <p class="text-sm text-gray-500 dark:text-gray-400"><span data-medicion-target="tipoEnvio"></span> · <span data-medicion-target="descripcion"></span></p>
        <p class="mt-2 text-sm text-amber-800 dark:text-amber-400 hidden" data-medicion-target="previa"></p>

        <div class="mt-5" data-medicion-target="form" data-action="keydown->medicion#formKeydown"
             data-controller="calc-volumetrico">
          <%# C26-18 · La misma disposición que /etiquetar. Jorge, el 2026-09-08:
              *"como estaban en etiquetar están bien, lo podés copiar a
              medición"*. O sea: el peso con su rótulo aparte, y las tres
              medidas juntas bajo un solo rótulo —que es como se leen y como se
              teclean—, en el orden de `CajasPesoMedidasComponent::DIMENSIONES`,
              que es la única lista de dimensiones del repo.

              Los `name` y los targets no cambian: el Stimulus sigue leyendo
              `peso`, `alto`, `largo` y `ancho` por separado. %>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <%= label_tag "medicion_peso", "Peso real (lbs)", class: "block text-sm font-medium text-gray-600 dark:text-gray-300 mb-1" %>
              <%= number_field_tag "medicion_peso", nil, step: "0.01", min: 0, inputmode: "decimal",
                    data: { medicion_target: "peso", calc_volumetrico_target: "peso", action: "input->calc-volumetrico#recalcular" },
                    class: "block w-full min-h-12 text-xl font-mono text-center rounded-lg border-gray-300 shadow-sm focus:ring-cec-teal focus:border-cec-teal" %>
            </div>
            <div>
              <span class="block text-sm font-medium text-gray-600 dark:text-gray-300 mb-1">Medidas (pulgadas)</span>
              <div class="grid grid-cols-3 gap-2">
                <% CajasPesoMedidasComponent::DIMENSIONES.each do |dim| %>
                  <%= number_field_tag "medicion_#{dim}", nil, step: "0.01", min: 0, inputmode: "decimal",
                        placeholder: dim.to_s, "aria-label": "#{dim.to_s.capitalize} en pulgadas",
                        data: { medicion_target: dim.to_s, calc_volumetrico_target: dim.to_s, action: "input->calc-volumetrico#recalcular" },
                        class: "block w-full min-h-12 text-xl font-mono text-center rounded-lg border-gray-300 shadow-sm focus:ring-cec-teal focus:border-cec-teal" %>
                <% end %>
              </div>
              <p class="mt-1 text-[11px] text-gray-400">alto × largo × ancho</p>
            </div>
          </div>
          <div class="mt-3 grid grid-cols-3 gap-3 text-center text-sm text-gray-600 dark:text-gray-300">
            <div><span class="block text-xs uppercase tracking-wide">VLBS</span><span class="text-lg font-mono font-bold" data-calc-volumetrico-target="vlbs">—</span></div>
            <div><span class="block text-xs uppercase tracking-wide">Cobra</span><span class="text-lg font-mono font-bold" data-calc-volumetrico-target="pesoCobrar">—</span></div>
            <div><span class="block text-xs uppercase tracking-wide">Pies³</span><span class="text-lg font-mono font-bold" data-calc-volumetrico-target="pies">—</span></div>
            <span class="hidden" data-calc-volumetrico-target="in3"></span>
            <span class="hidden" data-calc-volumetrico-target="metros"></span>
          </div>
        </div>

        <div class="mt-5 flex flex-wrap items-center gap-3">
          <%# El texto de los dos primeros lo reescribe el JS según lo que va a
              pasar: con un grupo a medias, F10 no imprime —guarda y salta a la
              caja siguiente—, y prometerlo sería mentir. Va en un `<span>` para
              poder cambiarlo; como el botón tiene contenido, ese texto **es** su
              nombre accesible y no hay `aria-label` que sincronizar. %>
          <%= render(ButtonComponent.new(variant: :gold, size: :lg, shortcut: "F10", shortcut_label_only: true,
                data: { medicion_target: "guardar", action: "medicion#guardar" })) do %><span data-medicion-target="guardarTexto">Guardar e imprimir</span><% end %>
          <%= render(ButtonComponent.new(variant: :secondary, size: :lg, shortcut: "F9", shortcut_label_only: true,
                data: { medicion_target: "reimprimir", action: "medicion#reimprimir" }, class: "hidden")) do %><span data-medicion-target="reimprimirTexto">Reimprimir la etiqueta</span><% end %>
          <%= render(ButtonComponent.new(variant: :secondary, size: :lg, shortcut: "F2", shortcut_label_only: true,
                data: { action: "medicion#limpiar" })) { "Limpiar" } %>
        </div>
      </div>

      <%# Lo que queda en pantalla cuando el envío se terminó: la pantalla se
          limpia para el siguiente —Jorge: *"cuando se facture o se termine de
          imprimir se debería limpiar"*— y esto guarda el resultado y la única
          acción que todavía tiene sentido. Se va con el escaneo siguiente. %>
      <div class="rounded-lg bg-cec-teal/10 text-cec-teal-dark p-4 hidden" data-medicion-target="banner">
        <p class="text-lg font-semibold" data-medicion-target="bannerTexto"></p>
        <div class="mt-2">
          <%= render(ButtonComponent.new(variant: :secondary, size: :sm,
                data: { medicion_target: "bannerReimprimir", action: "medicion#reimprimir" }, class: "hidden")) do %><span data-medicion-target="bannerReimprimirTexto">Reimprimir</span><% end %>
        </div>
      </div>
    </div>

    <%# ── e · lo que falta de este manifiesto ─────────────────────────────

        Jorge: *"¿cómo ayuda eso de «medidos hoy»? Sería bueno que aparezcan los
        que faltan de ese manifiesto, así como match con lo que se mandó desde
        Miami… y la fecha de cuándo fue enviado"*. Un contador de lo ya hecho no
        le sirve a nadie parado en la línea; lo que falta, sí.

        El panel sigue al manifiesto de la caja que se acaba de escanear. %>
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow overflow-hidden self-start"
         data-medicion-target="panelManifiesto">
      <div class="px-4 py-3 border-b border-gray-200 dark:border-gray-700">
        <h2 class="text-base font-semibold text-gray-800 dark:text-gray-100">Lo que falta de este manifiesto</h2>
        <p class="mt-1 font-mono font-bold text-cec-navy dark:text-cec-gold" data-medicion-target="manifiestoNumero"></p>
        <p class="text-xs text-gray-500 dark:text-gray-400" data-medicion-target="manifiestoFechas"></p>
        <%# El match con lo que Miami dijo que mandó. %>
        <p class="mt-1 text-sm font-semibold text-gray-700 dark:text-gray-200" data-medicion-target="manifiestoConteo"></p>
      </div>

      <ul class="divide-y divide-gray-200 dark:divide-gray-700 max-h-[32rem] overflow-y-auto"
          data-medicion-target="pendientes"></ul>

      <p class="px-4 py-6 text-center text-sm text-gray-500 dark:text-gray-400 hidden"
         data-medicion-target="sinPendientes">No falta nada por medir de este manifiesto.</p>

      <%# El renglón vive en el ERB, como el cuadrito: el markup se lee acá y
          Tailwind ve sus clases. El JS lo clona y lo llena. %>
      <template data-medicion-target="plantillaPendiente">
        <li class="px-4 py-2 flex items-start gap-2">
          <div class="flex-1 min-w-0">
            <p class="font-mono text-sm text-cec-navy dark:text-cec-gold truncate" data-campo="wr"></p>
            <p class="text-xs text-gray-600 dark:text-gray-300 truncate" data-campo="cliente"></p>
            <p class="text-xs" data-campo="donde"></p>
            <%# C26-17 · Cuáles vienen consolidados, sin tener que escanearlos. %>
            <p class="mt-0.5 inline-block text-[11px] font-semibold px-1.5 py-0.5 rounded bg-amber-100 text-amber-900 hidden"
               data-campo="unir"></p>
          </div>
          <%= render(ButtonComponent.new(variant: :ghost, size: :xs, icon: "x-mark", label: "Sacar de la lista",
                data: { action: "medicion#abrirDescarte" }, class: "hidden shrink-0")) %>
        </li>
      </template>
    </div>
  </div>

  <%# ── El modal rojo grande ──────────────────────────────────────────────
      Jorge: *"se debe mostrar un modal rojo grande con el problema que se
      encuentre"*. Enter = Entendido, Escape frenado (C20-13). %>
  <dialog data-medicion-target="problemaModal" data-action="cancel->medicion#avisoCancelar"
          style="margin: auto" class="rounded-xl p-0 w-[44rem] max-w-[95vw] backdrop:bg-black/70">
    <div class="px-8 py-5 bg-red-700 text-white">
      <p class="text-xs font-bold uppercase tracking-wider">Problema</p>
      <p class="text-3xl font-bold mt-1" data-medicion-target="problemaTitulo"></p>
    </div>
    <div class="bg-white px-8 py-6">
      <p class="text-xl text-gray-900" data-medicion-target="problemaTexto"></p>
    </div>
    <div class="flex items-center justify-end gap-3 px-8 py-4 bg-gray-50 border-t border-gray-200">
      <%= render(ButtonComponent.new(variant: :secondary, size: :md, label: "Medir de nuevo",
            data: { medicion_target: "medirDeNuevo", action: "medicion#medirDeNuevo" }, class: "hidden")) { "Medir de nuevo" } %>
      <%= render(ButtonComponent.new(variant: :primary, size: :lg, label: "Entendido",
            data: { medicion_target: "problemaEntendido", action: "medicion#avisoEntendido" })) { "Entendido" } %>
    </div>
  </dialog>

  <%# ── Sacar una caja de la lista: perdida, o ya entregada. Solo admin ──── %>
  <dialog data-medicion-target="descarteModal" data-action="cancel->medicion#avisoCancelar"
          style="margin: auto" class="rounded-xl p-0 w-[32rem] max-w-[95vw] backdrop:bg-black/60">
    <div class="px-6 py-4 bg-cec-navy text-white">
      <p class="text-xs font-bold uppercase tracking-wider">Solo administración</p>
      <p class="text-xl font-bold mt-1">Sacar de la lista</p>
    </div>
    <div class="bg-white px-6 py-5 space-y-4">
      <p class="text-base text-gray-900 font-mono" data-medicion-target="descarteCaja"></p>
      <div>
        <span class="block text-sm font-medium text-gray-700 mb-1">Por qué</span>
        <% DescartarDeMedicion::MOTIVOS.each_with_index do |(valor, etiqueta), i| %>
          <label class="flex items-center gap-2 text-sm text-gray-700 min-h-11">
            <%= radio_button_tag "medicion_descarte_motivo", valor, i.zero?,
                  data: { medicion_target: "descarteMotivo" }, class: "text-cec-teal focus:ring-cec-teal" %>
            <%= etiqueta %>
          </label>
        <% end %>
      </div>
      <div>
        <%= label_tag :medicion_descarte_nota, "Nota (opcional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= text_field_tag :medicion_descarte_nota, nil, autocomplete: "off",
              data: { medicion_target: "descarteNota" },
              class: "block w-full min-h-11 rounded-lg border-gray-300 shadow-sm focus:ring-cec-teal focus:border-cec-teal" %>
      </div>
      <p class="text-sm text-gray-500">La caja **no** cambia de estado: solo deja de esperarse acá, con tu nombre y la hora.</p>
      <p class="text-base font-medium text-red-700 hidden" data-medicion-target="descarteError"></p>
    </div>
    <div class="flex items-center justify-end gap-3 px-6 py-3 bg-gray-50 border-t border-gray-200">
      <%= render(ButtonComponent.new(variant: :secondary, size: :md, label: "Cancelar",
            data: { action: "medicion#cerrarDescarte" })) { "Cancelar" } %>
      <%= render(ButtonComponent.new(variant: :danger, size: :md, label: "Sacar esta caja de la lista",
            data: { medicion_target: "confirmarDescarte", action: "medicion#confirmarDescarte" })) { "Sacar de la lista" } %>
    </div>
  </dialog>

  <%# ── Facturar lo que hay: la alerta, y se pasa ───────────────────────── %>
  <dialog data-medicion-target="excepcionModal" data-action="cancel->medicion#avisoCancelar"
          style="margin: auto" class="rounded-xl p-0 w-[44rem] max-w-[95vw] backdrop:bg-black/70">
    <div class="px-8 py-5 bg-red-700 text-white">
      <p class="text-xs font-bold uppercase tracking-wider">El grupo está incompleto</p>
      <p class="text-3xl font-bold mt-1" data-medicion-target="excepcionTitulo">Facturar lo que hay</p>
    </div>
    <div class="bg-white px-8 py-6 space-y-4">
      <p class="text-xl text-gray-900">Se va a seguir sin estas cajas:</p>
      <ul class="text-lg font-mono text-red-800 space-y-1" data-medicion-target="excepcionFaltantes"></ul>
      <p class="text-base text-gray-600">Queda anotado en la pre-alerta con tu nombre, la hora y lo que faltaba.</p>
      <p class="text-base font-medium text-red-700 hidden" data-medicion-target="excepcionError"></p>
    </div>
    <div class="flex items-center justify-end gap-3 px-8 py-4 bg-gray-50 border-t border-gray-200">
      <%= render(ButtonComponent.new(variant: :secondary, size: :md, label: "Cancelar la excepción",
            data: { action: "medicion#cerrarExcepcion" })) { "Cancelar" } %>
      <%= render(ButtonComponent.new(variant: :danger, size: :lg, label: "Sí, facturar lo que hay",
            data: { medicion_target: "confirmarParcial", action: "medicion#confirmarParcial" })) { "Sí, facturar lo que hay" } %>
    </div>
  </dialog>
</div>
