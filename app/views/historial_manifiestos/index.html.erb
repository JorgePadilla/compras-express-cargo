<%# C32-01 · El historial de manifiestos: todos, por período, con filtros que
    se marcan. Solo consulta — se arma y se edita en `/manifiestos`. El porqué
    de cada filtro está en `HistorialManifiestosController`. %>
<%= render PageHeaderComponent.new(title: "Historial de manifiestos",
      subtitle: "#{@manifiestos.total_count} manifiestos") %>

<%# Accesible (Jorge, 2026-10-15: *"some components seem too small, make sure
    the page is accessible"*): todo lo que se toca mide 44 px (`docs/07`,
    «Tamaño táctil»), los textos van en `text-base`, los grupos de casillas son
    `fieldset` con su `legend`, y el foco es `cec-teal-deep`, que es la tinta
    que pasa contraste. %>
<% campo = "block w-full min-h-11 rounded-lg border border-gray-500 dark:border-gray-400 dark:bg-gray-900 dark:text-gray-100 shadow-sm py-2.5 text-base focus:border-cec-teal-deep focus:ring-cec-teal-deep" %>
<% rotulo = "block text-base font-medium text-gray-800 dark:text-gray-100 mb-1.5" %>
<%= form_tag historial_manifiestos_path, method: :get, role: "search", "aria-label": "Filtros del historial",
      class: "mb-6 bg-white dark:bg-gray-800 rounded-lg shadow px-6 py-6 space-y-6",
      data: { controller: "f2-clear", f2_clear_submit_value: "true", turbo: false } do %>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    <div>
      <label for="q" class="<%= rotulo %>">Buscar</label>
      <%= text_field_tag :q, params[:q], autocomplete: "off", placeholder: "Número, guía o tipo de envío (CER)",
            "aria-describedby": "q_ayuda", class: campo %>
      <p id="q_ayuda" class="text-sm text-gray-600 dark:text-gray-300 mt-1.5">Exacto: trae solo los que dicen eso, entero.</p>
    </div>
    <div>
      <label for="empresa_manifiesto_id" class="<%= rotulo %>">Empresa</label>
      <%= select_tag :empresa_manifiesto_id,
            options_from_collection_for_select(@empresas, :id, :nombre, params[:empresa_manifiesto_id]),
            include_blank: "— Todas —", class: campo %>
    </div>
    <div>
      <label for="tipo" class="<%= rotulo %>">Manifiesto</label>
      <%= select_tag :tipo, options_for_select([ [ "Oficial", "oficial" ], [ "Interno", "interno" ] ], params[:tipo]),
            include_blank: "— Oficial e interno —", class: campo %>
    </div>
  </div>

  <fieldset>
    <legend class="<%= rotulo %>">Estado</legend>
    <div class="flex flex-wrap gap-3" data-filtro="estados">
      <% HistorialManifiestosController::ESTADOS.each do |valor, texto| %>
        <%= render "historial_manifiestos/casilla", name: "estados[]", value: valor,
              checked: @estados.include?(valor), id: "estado_#{valor}", texto: texto %>
      <% end %>
    </div>
  </fieldset>

  <%# Las tarjetas de tipo de envío, con el ícono y el color de cada servicio:
      las mismas del formulario del manifiesto (`shared/_tipo_envio_casilla`).
      Ninguna marcada es todas. %>
  <fieldset>
    <legend class="<%= rotulo %>">Tipo de envío</legend>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3" data-filtro="tipos-de-envio">
      <% @tipo_envios.each do |tipo| %>
        <%= render "shared/tipo_envio_casilla", tipo: tipo, name: "tipo_envio_ids[]",
              checked: Array(params[:tipo_envio_ids]).include?(tipo.id.to_s), id: "tipo_envio_#{tipo.id}" %>
      <% end %>
    </div>
  </fieldset>

  <%# *"Lo normal que nosotros buscamos es de 1 a 2 meses. 3 es como mucho."* %>
  <fieldset class="pt-5 border-t border-gray-200 dark:border-gray-700">
    <legend class="sr-only">Período</legend>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 items-end">
      <div>
        <label for="desde" class="<%= rotulo %>">Creado desde</label>
        <%= date_field_tag :desde, params[:desde], class: campo, data: { controller: "flatpickr" } %>
      </div>
      <div>
        <label for="hasta" class="<%= rotulo %>">Hasta</label>
        <%= date_field_tag :hasta, params[:hasta], class: campo, data: { controller: "flatpickr" } %>
      </div>
      <div class="lg:col-span-2">
        <p class="text-base text-gray-700 dark:text-gray-200 mb-1.5">Sin fechas: los últimos 3 meses. Para más atrás:</p>
        <div class="flex flex-wrap gap-3">
          <%= render "historial_manifiestos/casilla", name: :incluir_3_12_meses, value: "1",
                checked: params[:incluir_3_12_meses] == "1", id: "incluir_3_12_meses", texto: "Incluir 3–12 meses" %>
          <%= render "historial_manifiestos/casilla", name: :incluir_mas_1_ano, value: "1",
                checked: params[:incluir_mas_1_ano] == "1", id: "incluir_mas_1_ano", texto: "Incluir más de 1 año" %>
        </div>
      </div>
    </div>
  </fieldset>

  <div class="flex flex-wrap gap-3">
    <%= render(ButtonComponent.new(variant: :primary, size: :lg, type: :submit, icon: "magnifying-glass")) { "Buscar" } %>
    <%= render(ButtonComponent.new(variant: :secondary, size: :lg, href: historial_manifiestos_path, icon: "x-mark")) { "Limpiar filtros" } %>
  </div>
<% end %>

<% if @manifiestos.any? %>
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
        <caption class="sr-only">Manifiestos que cumplen los filtros</caption>
        <thead class="bg-gray-50 dark:bg-gray-900">
          <tr>
            <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider">Manifiesto</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider">Tipo de envío</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider">Empresa</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider">Va a</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider">Estado</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider">Creado</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider">Enviado</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider">Recibido</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider">Inició pre-factura</th>
            <th scope="col" class="px-4 py-3 text-right text-xs font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wider">Paquetes</th>
          </tr>
        </thead>
        <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
          <% @manifiestos.each do |m| %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/40" data-manifiesto="<%= m.numero %>">
              <td class="px-4 py-3 whitespace-nowrap">
                <%= link_to m.numero, manifiesto_path(m), class: "text-sm font-mono font-medium text-cec-navy dark:text-cec-gold hover:underline" %>
                <% if m.tipo_interno? %>
                  <span class="ml-1 inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-cec-navy/10 text-cec-navy dark:bg-cec-gold/20 dark:text-cec-gold">interno</span>
                <% end %>
                <% if (guias = m.numeros_de_guia).any? %>
                  <span class="block text-xs font-mono text-gray-500 dark:text-gray-400"><%= guias.join(" · ") %></span>
                <% end %>
              </td>
              <%# Cada tipo con su ícono y su color, como en el manifiesto. %>
              <td class="px-4 py-3 text-sm" data-columna="tipos-de-envio">
                <% if m.tipo_envios.any? %>
                  <div class="flex flex-wrap gap-1.5">
                    <% m.tipo_envios.sort_by(&:nombre).each do |tipo| %>
                      <% accent = tipo_envio_accent(tipo) %>
                      <span class="inline-flex items-center gap-1.5 rounded-lg <%= accent[:bg] %> px-2 py-1 font-semibold text-cec-navy dark:text-gray-100">
                        <%= icono_de_tipo_envio tipo, variant: :outline, css: "w-4 h-4 #{accent[:text]}", disable_default_class: true %>
                        <%= tipo.nombre %>
                      </span>
                    <% end %>
                  </div>
                <% else %>
                  <span class="text-gray-500">—</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-200"><%= m.tipo_interno? ? "—" : (m.empresa_manifiesto&.nombre || "—") %></td>
              <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-200"><%= m.sucursales_entrega_texto || "—" %></td>
              <td class="px-4 py-3 whitespace-nowrap"><%= render StatusBadgeComponent.new(status: m.estado, label: m.estado_texto) %></td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-700 dark:text-gray-200"><%= m.created_at.strftime("%d/%m/%Y") %></td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-700 dark:text-gray-200"><%= fecha_y_quien(m.fecha_enviado, m.expedido_por) || "—" %></td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-700 dark:text-gray-200"><%= fecha_y_quien(m.fecha_aduana, m.recibido_hn_por) || "—" %></td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-700 dark:text-gray-200"><%= @inicio_de_prefactura[m.id]&.strftime("%d/%m/%Y") || "—" %></td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-right text-gray-700 dark:text-gray-200"><%= m.cantidad_paquetes %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="mt-4">
    <%= render PaginationComponent.new(collection: @manifiestos, label: "manifiestos") %>
  </div>
<% else %>
  <%= render EmptyStateComponent.new(
        title: "No hay manifiestos con esos filtros",
        description: "Probá con más estados marcados, o incluí de 3 a 12 meses.",
        icon: "clock") %>
<% end %>
