<%# C32-01 · El historial de manifiestos: todos, por período, con filtros que
    se marcan. Solo consulta — se arma y se edita en `/manifiestos`. El porqué
    de cada filtro está en `HistorialManifiestosController`. %>
<%= render PageHeaderComponent.new(title: "Historial de manifiestos",
      subtitle: "#{@manifiestos.total_count} manifiestos") %>

<%= form_tag historial_manifiestos_path, method: :get,
      class: "mb-6 bg-white dark:bg-gray-800 rounded-lg shadow px-6 py-5 space-y-5",
      data: { controller: "f2-clear", f2_clear_submit_value: "true", turbo: false } do %>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    <div>
      <label for="q" class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1">Buscar</label>
      <%= text_field_tag :q, params[:q], autocomplete: "off", placeholder: "Número, guía o tipo de envío (CER)",
            class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" %>
      <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-1">Exacto: trae solo los que dicen eso, entero.</p>
    </div>
    <div>
      <label for="empresa_manifiesto_id" class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1">Empresa</label>
      <%= select_tag :empresa_manifiesto_id,
            options_from_collection_for_select(@empresas, :id, :nombre, params[:empresa_manifiesto_id]),
            include_blank: "— Todas —",
            class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" %>
    </div>
    <div>
      <label for="tipo" class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1">Manifiesto</label>
      <%= select_tag :tipo, options_for_select([ [ "Oficial", "oficial" ], [ "Interno", "interno" ] ], params[:tipo]),
            include_blank: "— Oficial e interno —",
            class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <div>
      <span class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">Estado</span>
      <div class="flex flex-wrap gap-x-5 gap-y-2" data-filtro="estados">
        <% HistorialManifiestosController::ESTADOS.each do |valor, texto| %>
          <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-200">
            <%= check_box_tag "estados[]", valor, @estados.include?(valor), id: "estado_#{valor}",
                  class: "rounded border-gray-300 text-cec-teal focus:ring-cec-teal" %>
            <%= texto %>
          </label>
        <% end %>
      </div>
    </div>
    <div>
      <span class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">Tipo de envío</span>
      <div class="flex flex-wrap gap-x-5 gap-y-2">
        <% @tipo_envios.each do |te| %>
          <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-200">
            <%= check_box_tag "tipo_envio_ids[]", te.id, Array(params[:tipo_envio_ids]).include?(te.id.to_s), id: "tipo_envio_#{te.id}",
                  class: "rounded border-gray-300 text-cec-teal focus:ring-cec-teal" %>
            <span class="font-mono uppercase"><%= te.codigo %></span>
          </label>
        <% end %>
      </div>
    </div>
  </div>

  <%# *"Lo normal que nosotros buscamos es de 1 a 2 meses. 3 es como mucho."* %>
  <div class="grid grid-cols-1 md:grid-cols-4 gap-5 items-end pt-4 border-t border-gray-100 dark:border-gray-700">
    <div>
      <label for="desde" class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1">Creado desde</label>
      <%= date_field_tag :desde, params[:desde], class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm",
            data: { controller: "flatpickr" } %>
    </div>
    <div>
      <label for="hasta" class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1">Hasta</label>
      <%= date_field_tag :hasta, params[:hasta], class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm",
            data: { controller: "flatpickr" } %>
    </div>
    <div class="md:col-span-2 flex flex-wrap gap-x-5 gap-y-2 pb-2">
      <span class="text-sm text-gray-500 dark:text-gray-400">Sin fechas: los últimos 3 meses.</span>
      <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-200">
        <%= check_box_tag :incluir_3_12_meses, "1", params[:incluir_3_12_meses] == "1",
              class: "rounded border-gray-300 text-cec-teal focus:ring-cec-teal" %>
        Incluir 3-12 meses
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-200">
        <%= check_box_tag :incluir_mas_1_ano, "1", params[:incluir_mas_1_ano] == "1",
              class: "rounded border-gray-300 text-cec-teal focus:ring-cec-teal" %>
        Incluir &gt; 1 año
      </label>
    </div>
  </div>

  <div class="flex gap-3">
    <%= render(ButtonComponent.new(variant: :primary, type: :submit, icon: "magnifying-glass")) { "Buscar" } %>
    <%= render(ButtonComponent.new(variant: :ghost, href: historial_manifiestos_path, icon: "x-mark")) { "Limpiar" } %>
  </div>
<% end %>

<% if @manifiestos.any? %>
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
        <thead class="bg-gray-50 dark:bg-gray-900">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Manifiesto</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Tipo de envío</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Empresa</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Va a</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Estado</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Creado</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Enviado</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Recibido</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Inició pre-factura</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Paquetes</th>
          </tr>
        </thead>
        <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
          <% @manifiestos.each do |m| %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/40" data-manifiesto="<%= m.numero %>">
              <td class="px-4 py-3 whitespace-nowrap">
                <%= link_to m.numero, manifiesto_path(m), class: "text-sm font-mono font-medium text-cec-navy dark:text-cec-gold hover:underline" %>
                <% if m.tipo_interno? %>
                  <span class="ml-1 inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-cec-navy/10 text-cec-navy dark:bg-cec-gold/20 dark:text-cec-gold">interno</span>
                <% end %>
                <% if (guias = m.numeros_de_guia).any? %>
                  <span class="block text-xs font-mono text-gray-500 dark:text-gray-400"><%= guias.join(" · ") %></span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-200"><%= m.tipos_envio_nuestros.presence || "—" %></td>
              <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-200"><%= m.tipo_interno? ? "—" : (m.empresa_manifiesto&.nombre || "—") %></td>
              <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-200"><%= m.sucursales_entrega_texto || "—" %></td>
              <td class="px-4 py-3 whitespace-nowrap"><%= render StatusBadgeComponent.new(status: m.estado, label: m.estado_texto) %></td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-700 dark:text-gray-200"><%= m.created_at.strftime("%d/%m/%Y") %></td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-700 dark:text-gray-200"><%= fecha_y_quien(m.fecha_enviado, m.expedido_por) || "—" %></td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-700 dark:text-gray-200"><%= fecha_y_quien(m.fecha_aduana, m.recibido_hn_por) || "—" %></td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-700 dark:text-gray-200"><%= @inicio_de_prefactura[m.id]&.strftime("%d/%m/%Y") || "—" %></td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-right text-gray-700 dark:text-gray-200"><%= m.cantidad_paquetes %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="mt-4">
    <%= render PaginationComponent.new(collection: @manifiestos, label: "manifiestos") %>
  </div>
<% else %>
  <%= render EmptyStateComponent.new(
        title: "No hay manifiestos con esos filtros",
        description: "Probá con más estados marcados, o incluí de 3 a 12 meses.",
        icon: "clock") %>
<% end %>
