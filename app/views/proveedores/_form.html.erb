<%= form_with model: proveedor, local: true,
              class: "space-y-4 bg-white rounded-lg shadow p-6" do |f| %>
  <% if proveedor.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-3 text-sm text-red-700">
      <ul class="list-disc list-inside">
        <% proveedor.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= f.label :nombre, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :nombre, required: true,
          class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" %>
      <p class="mt-1 text-xs text-gray-500">Ej: Amazon, Walmart, Driver Juan Carlos.</p>
    </div>

    <div>
      <%= f.label :codigo, "Código (3 letras, autogenerado)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :codigo, maxlength: 8,
          class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm font-mono uppercase focus:ring-cec-teal focus:border-cec-teal" %>
      <p class="mt-1 text-xs text-gray-500">Si lo dejás vacío, lo genero del nombre (Amazon → AMZ). Editable en caso de colisión.</p>
    </div>

    <div>
      <%= f.label :tipo, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :tipo, [ [ "Comercio (con tracking propio)", "comercio" ], [ "Entrega Personal (sin tracking)", "entrega_personal" ] ],
          {}, class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" %>
      <p class="mt-1 text-xs text-gray-500">"Entrega Personal" activa la generación automática de tracking interno (EP-AÑO-SUC-PROV-000001).</p>
    </div>

    <div>
      <%= f.label :position, "Posición (orden de despliegue)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :position, min: 0,
          class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" %>
    </div>
  </div>

  <div>
    <%= f.label :notas, "Notas internas (opcional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :notas, rows: 2,
        class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" %>
  </div>

  <div>
    <label class="flex items-center gap-2">
      <%= f.check_box :activo, class: "rounded border-gray-300 text-cec-teal focus:ring-cec-teal" %>
      <span class="text-sm font-medium text-gray-700">Activo (aparece en el autocomplete del paquete)</span>
    </label>
  </div>

  <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-200">
    <%= link_to "Cancelar (F2)", proveedores_path,
        class: "text-sm text-gray-600 hover:text-gray-900",
        data: { shortcut: "F2" } %>
    <%= f.submit "#{proveedor.persisted? ? 'Guardar' : 'Crear'} (F10)",
        class: "inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium bg-cec-gold text-cec-navy-dark hover:bg-cec-gold-dark transition-colors cursor-pointer",
        data: { shortcut: "F10" } %>
  </div>
<% end %>
