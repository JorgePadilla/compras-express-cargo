<%= render PageHeaderComponent.new(title: "Proveedores", subtitle: "Catálogo de comercios y drivers privados") do |h| %>
  <% h.with_action do %>
    <%= render ButtonComponent.new(href: new_proveedor_path, variant: :primary, icon: "plus", data: { shortcut: "F7" }) do %>
      Nuevo Proveedor <span class="ml-1 text-[10px] opacity-70">(F7)</span>
    <% end %>
  <% end %>
<% end %>

<% if @proveedores.any? %>
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Código</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Nombre</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tipo</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Posición</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Estado</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Acciones</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @proveedores.each do |p| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 text-sm font-mono font-semibold text-cec-navy"><%= p.codigo %></td>
            <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= p.nombre %></td>
            <td class="px-6 py-4 text-sm">
              <% if p.entrega_personal? %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-900">Entrega Personal</span>
              <% else %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-cec-teal/10 text-cec-teal">Comercio</span>
              <% end %>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= p.position %></td>
            <td class="px-6 py-4 text-sm">
              <% if p.activo %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-cec-teal/10 text-cec-teal">Activo</span>
              <% else %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">Inactivo</span>
              <% end %>
            </td>
            <td class="px-6 py-4 text-right text-sm">
              <%= render RowActionComponent.new(action: :edit, href: edit_proveedor_path(p), label: "Editar proveedor") %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <%= render EmptyStateComponent.new(title: "No hay proveedores", description: "Crea uno para que aparezca en el autocomplete del paquete.", icon: "tag") %>
<% end %>
