<h2>Hola <%= @cliente.nombre %>,</h2>

<p>Tu paquete con tracking <strong><%= @paquete.tracking %></strong> ha sido recibido en nuestra bodega de <%= @sucursal %>.</p>

<% if @nota %>
  <p><strong>Nota sobre este paquete:</strong></p>
  <%= simple_format(@nota) %>
<% end %>

<% if @fecha_entrega %>
  <p>Posible fecha de entrega: <strong><%= @fecha_entrega %></strong>.</p>
<% else %>
  <p>Sera incluido en el proximo envio disponible.</p>
<% end %>

<p>Gracias por usar Compras Express Cargo.</p>
