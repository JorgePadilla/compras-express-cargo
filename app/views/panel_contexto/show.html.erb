<%# PR-9.b: franja de contexto de /etiquetar y /entrega_personal.
    Se carga como turbo-frame; los Stimulus de ambas pantallas le setean el
    `src` al elegir cliente o al matchear una pre-alerta. Solo lectura salvo
    el checkbox de las tareas. %>
<%= turbo_frame_tag "panel_contexto" do %>
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow ring-1 ring-gray-200 dark:ring-gray-700 overflow-hidden">

    <% if @cliente.nil? %>
      <%# Estado vacío — el operario todavía no eligió cliente. %>
      <div class="px-4 py-10 text-center">
        <%= heroicon "user-circle", variant: :outline,
              options: { class: "w-10 h-10 mx-auto text-gray-300 dark:text-gray-600" } %>
        <p class="mt-3 text-sm font-medium text-gray-500 dark:text-gray-400">Sin cliente seleccionado</p>
        <p class="mt-1 text-xs text-gray-400 dark:text-gray-500">
          Al elegir el cliente aparecen aquí sus tareas y sus notas.
        </p>
      </div>

    <% else %>
      <%# ── Cliente ── el "Jalar → Nombre" de la hoja. %>
      <div class="px-4 py-3 bg-cec-navy dark:bg-cec-navy-dark">
        <p class="text-[10px] uppercase tracking-wider font-bold text-cec-gold">Cliente</p>
        <p class="text-base font-bold text-white leading-tight"><%= @cliente.nombre_completo %></p>
        <p class="text-xs text-white/70 font-mono mt-0.5">
          <%= @cliente.codigo %><%= " · #{@cliente.categoria_precio.nombre}" if @cliente.categoria_precio %>
        </p>
      </div>

      <%# ── Tareas ── checkbox que marca realizada y registra quién la hizo. %>
      <div class="px-4 py-3 border-b border-gray-200 dark:border-gray-700">
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 inline-flex items-center gap-1.5">
            <%= heroicon "clipboard-document-check", variant: :solid,
                  options: { class: "w-4 h-4 text-cec-teal" } %>
            Tareas
          </h3>
          <span class="inline-flex items-center justify-center min-w-[1.5rem] px-1.5 py-0.5 rounded-full text-xs font-bold
                       <%= @tareas.any? ? 'bg-cec-gold/20 text-cec-gold-dark dark:text-cec-gold-light' : 'bg-slate-100 dark:bg-gray-700 text-slate-500 dark:text-slate-400' %>">
            <span id="tareas-pendientes-count"><%= @tareas.size %></span>
          </span>
        </div>

        <% if @tareas.any? %>
          <ul class="space-y-1.5">
            <% @tareas.each do |tarea| %>
              <li id="<%= dom_id(tarea) %>"
                  class="flex items-start gap-2.5 p-2 rounded-lg bg-slate-50 dark:bg-gray-700/50 ring-1 ring-slate-200 dark:ring-gray-600">
                <%= button_to completar_tarea_path(tarea),
                      form: { data: { turbo_frame: "_top" }, class: "shrink-0 mt-0.5" },
                      class: "block w-5 h-5 rounded border-2 border-cec-teal/60 hover:bg-cec-teal hover:border-cec-teal transition-colors",
                      title: "Marcar como hecha",
                      aria: { label: "Marcar «#{tarea.titulo}» como hecha" } do %><% end %>

                <div class="min-w-0 flex-1">
                  <p class="text-sm font-medium text-gray-900 dark:text-gray-100 leading-snug"><%= tarea.titulo %></p>
                  <% if tarea.descripcion.present? %>
                    <p class="text-xs text-gray-600 dark:text-gray-300 mt-0.5 whitespace-pre-line"><%= tarea.descripcion %></p>
                  <% end %>
                  <div class="flex flex-wrap items-center gap-1.5 mt-1">
                    <% if tarea.departamento.present? %>
                      <span class="inline-flex items-center text-[10px] uppercase tracking-wider font-semibold px-1.5 py-0.5 rounded bg-cec-navy/5 dark:bg-cec-navy/30 text-cec-navy dark:text-cec-gold ring-1 ring-cec-navy/20">
                        <%= tarea.departamento_label %>
                      </span>
                    <% end %>
                    <% if tarea.en_proceso? %>
                      <span class="inline-flex items-center text-[10px] uppercase tracking-wider font-semibold px-1.5 py-0.5 rounded bg-cec-gold/10 text-cec-gold-dark ring-1 ring-cec-gold/30">
                        En proceso
                      </span>
                    <% end %>
                    <% if tarea.asignado_a %>
                      <span class="text-[10px] text-gray-500 dark:text-gray-400">→ <%= tarea.asignado_a.iniciales_display %></span>
                    <% end %>
                  </div>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-xs italic text-gray-400 dark:text-gray-500 py-1">— sin tareas pendientes —</p>
        <% end %>
      </div>

      <%# ── Notas ── las 5 categorías, ordenadas por departamento. %>
      <% blocks = notas_contexto_blocks(cliente: @cliente, paquete: @paquete,
                                        notas_especiales: @notas_especiales, user: Current.user) %>
      <div class="px-4 py-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 inline-flex items-center gap-1.5 mb-2">
          <%= heroicon "document-text", variant: :solid, options: { class: "w-4 h-4 text-cec-gold" } %>
          Notas
        </h3>

        <% if blocks.any? %>
          <div class="space-y-2">
            <% blocks.each do |b| %>
              <% tono = tono_nota_classes(b[:tono]) %>
              <div class="rounded-lg ring-1 px-3 py-2 <%= tono[:wrap] %>">
                <p class="text-[10px] uppercase tracking-wider font-bold <%= tono[:label] %>">
                  <%= b[:etiqueta] %><% if b[:detalle].present? %>
                    <span class="font-mono normal-case tracking-normal opacity-70">· <%= b[:detalle] %></span>
                  <% end %>
                </p>
                <p class="text-sm text-gray-800 dark:text-gray-100 mt-1 whitespace-pre-line"><%= b[:texto] %></p>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-xs italic text-gray-400 dark:text-gray-500 py-1">— este cliente no tiene notas —</p>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
