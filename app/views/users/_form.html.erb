<%= form_with model: user, class: "space-y-6" do |f| %>
  <% if user.errors.any? %>
    <div class="p-4 bg-red-50 rounded-lg">
      <div class="flex items-center gap-2 mb-2">
        <%= heroicon "exclamation-triangle", variant: :outline, options: { class: "w-5 h-5 text-red-600" } %>
        <h3 class="text-sm font-medium text-red-800">
          Se encontraron <%= user.errors.count %> error(es) al guardar:
        </h3>
      </div>
      <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
        <% user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <%= f.label :nombre, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :nombre, required: true,
          class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                 focus:ring-cec-teal focus:border-cec-teal" %>
    </div>

    <div>
      <%= f.label :iniciales, "Iniciales", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :iniciales, maxlength: 8, placeholder: "Ej: YG, JP, YS",
          class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm font-mono uppercase
                 focus:ring-cec-teal focus:border-cec-teal" %>
      <p class="mt-1 text-xs text-gray-500">Hasta 8 caracteres. Aparece en la bitácora y el Warehouse Receipt.</p>
    </div>

    <div>
      <%= f.label :email_address, "Email", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.email_field :email_address, required: true,
          class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                 focus:ring-cec-teal focus:border-cec-teal" %>
    </div>

    <div>
      <%= f.label :password, "Contrasena", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password, required: user.new_record?, autocomplete: "new-password",
          class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                 focus:ring-cec-teal focus:border-cec-teal" %>
      <% if user.persisted? %>
        <p class="mt-1 text-xs text-gray-500">Dejar vacio para mantener la contrasena actual</p>
      <% end %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirmar Contrasena", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password_confirmation, required: user.new_record?, autocomplete: "new-password",
          class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                 focus:ring-cec-teal focus:border-cec-teal" %>
    </div>

    <div>
      <%= f.label :rol, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :rol, User.rol_options_for_select,
          { include_blank: "— Seleccionar Rol —" },
          { required: true, class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                 focus:ring-cec-teal focus:border-cec-teal" } %>
    </div>

    <%# PR-13.c: el PIN de 4 dígitos con el que autoriza cambios de precio en la
        pre-factura. Solo para los roles que pueden autorizar; el resto no tiene
        para qué tener uno. El admin asigna el inicial y el supervisor lo cambia
        desde su pantalla — mientras no lo cambie, el admin conoce el PIN con el
        que él autoriza y el registro deja de probar nada. %>
    <div class="sm:col-span-2 p-4 rounded-lg bg-cec-navy/5 border border-cec-navy/20">
      <div class="flex items-start gap-2 mb-3">
        <%= heroicon "key", variant: :solid, options: { class: "w-5 h-5 text-cec-navy shrink-0 mt-0.5" } %>
        <div class="text-sm text-gray-700">
          <strong>PIN de autorizacion</strong> — solo aplica a
          Administrador, Supervisor Caja, Supervisor Pre-Factura y Supervisor de
          Servicio al Cliente. Con el destraban cambios de precio en la
          pre-factura sin tener que iniciar sesion.
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :pin, "PIN (4 digitos)", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.password_field :pin, inputmode: "numeric", maxlength: 4, autocomplete: "off",
              class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm tracking-widest
                     focus:ring-cec-teal focus:border-cec-teal" %>
          <p class="mt-1 text-xs text-gray-500">
            <%= user.pin_digest.present? ? "Dejar vacio para mantener el PIN actual" : "Se lo entregas al supervisor para que el lo cambie" %>
          </p>
        </div>
        <div>
          <%= f.label :pin_confirmation, "Confirmar PIN", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.password_field :pin_confirmation, inputmode: "numeric", maxlength: 4, autocomplete: "off",
              class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm tracking-widest
                     focus:ring-cec-teal focus:border-cec-teal" %>
        </div>
      </div>

      <% if user.pin_sin_cambiar? %>
        <p class="mt-3 text-xs text-amber-700">
          Este usuario todavia tiene el PIN que vos le asignaste. Hasta que lo
          cambie, vos podes autorizar en su nombre.
        </p>
      <% end %>
    </div>

    <div>
      <%= f.label :ubicacion, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :ubicacion, [["Miami", "miami"], ["Honduras", "honduras"]],
          { include_blank: "— Seleccionar Ubicacion —" },
          { required: true, class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                 focus:ring-cec-teal focus:border-cec-teal" } %>
    </div>

    <%# Seguimiento de C18-02. Yusef: "ahí vamos a amarrar al usuario de dónde
        es". Si la sucursal recibe carga, Etiquetar y Entrega Personal la
        preseleccionan; si no tiene, va la de recepción por defecto. %>
    <div>
      <%= f.label :sucursal_id, "Sucursal donde trabaja", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.collection_select :sucursal_id, @sucursales, :id, :nombre,
          { include_blank: "— Ninguna —" },
          { class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm
                 focus:ring-cec-teal focus:border-cec-teal" } %>
      <p class="mt-1 text-xs text-gray-500">Si recibe carga, Etiquetar y Entrega Personal la dejan preseleccionada.</p>
    </div>

    <% if user.persisted? %>
      <div class="flex items-center gap-3">
        <%= f.check_box :activo, class: "rounded border-gray-300 text-cec-teal focus:ring-cec-teal" %>
        <%= f.label :activo, "Usuario activo", class: "text-sm font-medium text-gray-700" %>
      </div>
    <% end %>
  </div>

  <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-200">
    <%= link_to "Cancelar (F2)", user.persisted? ? user_path(user) : users_path,
        class: "text-sm text-gray-600 hover:text-gray-900",
        data: { shortcut: "F2" } %>
    <%= f.submit "#{user.persisted? ? 'Guardar Cambios' : 'Crear Usuario'} (F10)",
        class: "inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium
               bg-cec-gold text-cec-navy-dark hover:bg-cec-gold-dark transition-colors cursor-pointer",
        data: { shortcut: "F10" } %>
  </div>
<% end %>
