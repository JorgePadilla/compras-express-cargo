<%# PR-C6.46: el envoltorio se acerca al del portal. Las tarjetas de paquete ya
    hablaban el mismo idioma desde PR-C6.44; lo que estaba viejo era esto — la
    tarjeta, el título de sección, el pie suelto.

    Los controles NO cambian (decisión de Jorge, 2026-08-12): el select de tipo
    de envío y los checkboxes se quedan. Quien carga treinta al día va más
    rápido así, y el wizard de 3 pasos del portal ya se había descartado para
    admin. Lo que se acerca es cómo se ve, no cómo se opera. %>
<%= render PageHeaderComponent.new(title: "Nueva Pre-Alerta",
      subtitle: "Cargá el cliente, el servicio y los paquetes que vienen en camino") %>

<div class="max-w-5xl mx-auto">
  <%= form_with model: @pre_alerta, url: pre_alertas_path, class: "space-y-6 animate-fade-in-up" do |f| %>
    <% if @pre_alerta.errors.any? %>
      <div class="p-4 bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 rounded-xl">
        <p class="text-sm font-medium text-red-700 dark:text-red-300"><%= @pre_alerta.errors.full_messages.join(", ") %></p>
      </div>
    <% end %>

    <%= render FormSectionComponent.new(title: "Cliente",
          subtitle: "A nombre de quién entra esta pre-alerta") do %>
      <div data-controller="client-autocomplete" data-client-autocomplete-url-value="<%= buscar_clientes_path %>">
        <div class="relative">
          <%# PR-C6.33: faltaba el `keydown`. El controller siempre supo manejar
              flechas y Enter, pero acá nadie se los mandaba — así que en esta
              pantalla el dropdown solo se podía usar con el mouse. Eso es lo
              que Yusef pidió como "preseleccionar de los dropdown" (A3-10). %>
          <input type="text" data-client-autocomplete-target="input"
                 data-action="input->client-autocomplete#search
                              keydown->client-autocomplete#onKeydown"
                 placeholder="Buscar por codigo o nombre..."
                 autocomplete="off"
                 class="<%= clases_de_input %>">
          <%= f.hidden_field :cliente_id, data: { client_autocomplete_target: "clienteId" } %>
          <div data-client-autocomplete-target="dropdown" class="hidden absolute z-10 w-full mt-1 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-600 rounded-lg shadow-lg max-h-60 overflow-y-auto"></div>
        </div>
        <p data-client-autocomplete-target="nombre" class="mt-1 text-sm text-gray-500 dark:text-gray-400 hidden"></p>
      </div>
    <% end %>

    <%= render FormSectionComponent.new(title: "Servicio",
          subtitle: "Cómo viaja, y si se agrupa con otros paquetes") do %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="<%= clases_de_etiqueta %>"><%= etiqueta_de_campo("Tipo de Envío") %></label>
          <%= f.select :tipo_envio_id, options_from_collection_for_select(@tipo_envios, :id, :nombre, @pre_alerta.tipo_envio_id || @tipo_envio_sugerido&.id),
              { include_blank: "— Seleccionar —" },
              class: clases_de_input %>
        </div>
        <div class="flex flex-col justify-end gap-3">
          <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-200">
            <%= f.check_box :con_reempaque, class: "rounded border-gray-300 dark:border-gray-600 text-cec-teal focus:ring-cec-teal" %>
            Con Reempaque
          </label>
          <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-200">
            <%= f.check_box :consolidado, class: "rounded border-gray-300 dark:border-gray-600 text-cec-teal focus:ring-cec-teal" %>
            Consolidado
          </label>
        </div>
      </div>
    <% end %>

    <%= render FormSectionComponent.new(title: "Referencia",
          subtitle: "Con qué se va a reconocer este envío") do %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="<%= clases_de_etiqueta %>"><%= etiqueta_de_campo("Título de Referencia") %></label>
          <%= f.text_field :titulo, placeholder: "Ej. Televisor, Zapatos...", class: clases_de_input %>
        </div>
        <div>
          <label class="<%= clases_de_etiqueta %>">
            <%= etiqueta_de_campo("Proveedor / Tienda", ayuda: "(opcional)") %>
          </label>
          <%# PR-C6.36: sugerencias del catalogo de Proveedores, con texto libre.
              Mismo patron que el carrier de /etiquetar, que Yusef ya aprobo:
              "dropdown con texto libre para agregar a la lista". No se migra
              a FK porque `PreAlerta.proveedor` es un string y cambiarlo
              tocaria datos viejos por una pantalla que nadie reporto rota. %>
          <%= f.text_field :proveedor, list: "proveedores-list", placeholder: "Ej. Amazon, Best Buy...",
              class: clases_de_input %>
          <datalist id="proveedores-list">
            <% @proveedores_sugeridos.each do |p| %>
              <option value="<%= p.nombre %>">
            <% end %>
          </datalist>
        </div>
      </div>
    <% end %>

    <%= render FormSectionComponent.new(title: "Notas del grupo",
          subtitle: "Van a toda la pre-alerta, no a un paquete suelto") do %>
      <%= f.text_area :notas_grupo, rows: 2,
          placeholder: "Notas opcionales...", class: clases_de_input %>
    <% end %>

    <%# La tarjeta ES el elemento de Stimulus: `pre-alerta-editor` vive acá y no
        en un div de adentro, así que los targets del template y del contador
        quedan dentro de su alcance. Por eso el componente acepta `data`. %>
    <%= render FormSectionComponent.new(data: { controller: "pre-alerta-editor" }) do |s| %>
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-2">
          <h2 class="text-xl sm:text-2xl font-bold text-cec-navy dark:text-cec-gold">Paquetes</h2>
          <span data-pre-alerta-editor-target="counter" class="inline-flex items-center justify-center px-2 py-0.5 rounded-full text-xs font-semibold bg-cec-navy/10 dark:bg-cec-gold/20 text-cec-navy dark:text-cec-gold">0</span>
        </div>
      </div>

      <div data-pre-alerta-editor-target="paquetesBody" class="space-y-4">
<% @pre_alerta.pre_alerta_paquetes.each.with_index do |pap, index| %>
  <%= render "pre_alertas/paquete_card", f: f, pap: pap, index: index %>
<% end %>
      </div>

      <div class="mt-4">
        <%= render ButtonComponent.new(variant: :outline_teal, size: :md, icon: "plus-circle",
              data: { action: "click->pre-alerta-editor#addPaquete",
                      pre_alerta_editor_target: "addButton" }) do %>Agregar Paquete<% end %>
      </div>

<template data-pre-alerta-editor-target="template">
  <%= render "pre_alertas/paquete_card",
        f: f, pap: PreAlertaPaquete.new, index: "NEW_INDEX" %>
</template>

      <%# El pie va DENTRO de la última tarjeta, como en el portal: suelto abajo
          se leía como si no perteneciera al formulario. %>
      <% s.with_footer do %>
        <%= render ButtonComponent.new(variant: :ghost, size: :lg, icon: "arrow-left", href: pre_alertas_path) do %>
          Cancelar
        <% end %>
        <%= render ButtonComponent.new(variant: :gold, size: :lg, icon: "check-circle", type: "submit") do %>
          Crear Pre-Alerta
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
