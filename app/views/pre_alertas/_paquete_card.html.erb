<%# Una fila de paquete de `/pre_alertas/new`, en forma de tarjeta.
    Locals: f, pap, index.

    Es tarjeta y no `<tr>` porque en `new` no hay tabla: todavía no existe
    Estado ni Vinculado que mostrar —nada está guardado ni vinculado— y una
    tabla de tres columnas anchas se lee peor que una tarjeta.

    PR-C6.44: pinta la fila del servidor **y** el `<template>`. Antes eran dos
    copias, y el aviso de tracking duplicado que pidió Yusef estaba solo en la
    del servidor: al agregar una fila con el botón, el aviso desaparecía.

    Ojo con `reject_if` (`PreAlerta`): una fila con SOLO la fecha llena se
    descarta en silencio — hace falta tracking, descripción o instrucciones. %>
<% nueva = !pap.persisted? %>

<div class="paquete-row relative bg-gray-50 dark:bg-gray-800/60 rounded-xl p-4 border border-gray-200 dark:border-gray-700"
     <%= tag.attributes(data: { new_record: true }) if nueva %>>
  <div class="absolute top-3 right-3">
    <%= render ButtonComponent.new(variant: :ghost, size: :xs, icon: "trash",
          label: "Quitar este paquete de la pre-alerta",
          data: { action: "click->pre-alerta-editor#removePaquete" }) %>
  </div>

  <%= f.fields_for :pre_alerta_paquetes, pap, child_index: index do |pf| %>
    <% unless nueva %>
      <%= pf.hidden_field :id %>
    <% end %>

    <div class="grid grid-cols-1 gap-4">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <%# PR-C6.26: avisa si el tracking ya existe. Yusef: "ya tiene un error
            y NO LO DETECTA QUE YA EXISTE". Avisa, no bloquea: hay duplicados
            legítimos que se resuelven con sufijo en /etiquetar. %>
        <%# `tracking-input` va PRIMERO en el `data-action`: limpia el valor
            antes de que el otro salga a preguntar. Avisa lo que sacó — no se lo
            traga en silencio. %>
        <div class="sm:col-span-2"
             data-controller="tracking-duplicado tracking-input"
             data-tracking-duplicado-url-value="<%= check_tracking_paquetes_path %>"
             data-tracking-duplicado-excluir-paquete-id-value="<%= pap.paquete_id %>">
          <label class="<%= clases_de_etiqueta %>">
            Tracking o Número de Rastreo
            <span class="text-xs font-normal text-red-500 ml-1">Obligatorio (Aquí NO va el Número de Orden)</span>
          </label>
          <%= pf.text_field :tracking, placeholder: "Ej. 1Z999AA1...",
              autocomplete: "off", inputmode: "latin", spellcheck: "false",
              pattern: "[A-Za-z0-9\\-]+",
              title: "Solo letras, números y guiones. Sin espacios ni símbolos.",
              data: { "1p-ignore": true, lpignore: true, "form-type": "other",
                      tracking_input_target: "input",
                      action: "input->tracking-input#sanitize input->tracking-duplicado#buscar" },
              class: clases_de_input %>
          <p data-tracking-input-target="error" class="hidden text-xs text-red-600 dark:text-red-400 mt-1"></p>
          <p data-tracking-duplicado-target="aviso"
             class="hidden mt-1 text-xs text-amber-700 dark:text-amber-300 bg-amber-50 dark:bg-amber-900/30 border border-amber-200 dark:border-amber-800 rounded px-2 py-1">
            <span data-tracking-duplicado-target="texto"></span>
          </p>
        </div>

        <div>
          <label class="<%= clases_de_etiqueta %>">Fecha</label>
          <%# La pone el servidor y no se edita: es el sello de cuándo se cargó
              la pre-alerta, no una fecha que el operario elija. El portal ya la
              mostraba así —como texto, nunca como campo— y admin era el único
              lugar donde se podía tocar.

              Como no es un input, el Tab lo salta solo (Jorge lo pidió) y de
              paso desaparece el autofill de tarjetas que traía flatpickr. El
              valor no viaja en el form: lo pone el default del atributo. %>
          <p class="<%= clases_de_campo_sellado %>"><%= (pap.fecha || Date.current).strftime("%d/%m/%Y") %></p>
        </div>
      </div>

      <div>
        <label class="<%= clases_de_etiqueta %>">
          Descripción del Producto
          <span class="text-xs font-normal text-red-500 ml-1">Obligatorio</span>
        </label>
        <%= pf.text_field :descripcion, placeholder: "¿Qué contiene el paquete?",
            class: clases_de_input %>
      </div>

      <%# Yusef: "nos hace falta la opción de Retener en Miami en Pre Alerta de
          Admin". A veces se sabe antes de que el paquete llegue al mostrador.
          El motivo se pide al etiquetar, que es cuando se conoce. %>
      <label class="flex items-start gap-2 cursor-pointer rounded-lg ring-1 ring-amber-200 dark:ring-amber-800 bg-amber-50 dark:bg-amber-900/20 px-3 py-2">
        <%= pf.check_box :retener_miami,
              class: "mt-0.5 rounded border-gray-300 dark:border-gray-600 text-amber-600 focus:ring-amber-500" %>
        <span>
          <span class="block text-sm font-medium text-amber-900 dark:text-amber-200">Retener en Miami</span>
          <span class="block text-xs text-amber-700 dark:text-amber-300">
            Llega marcado para no despacharse. El motivo se pide al etiquetarlo.
          </span>
        </span>
      </label>

      <div>
        <label class="<%= clases_de_etiqueta %>">
          Instrucciones Especiales del Paquete <span class="text-xs font-normal text-gray-500">(opcional)</span>
        </label>
        <%= pf.text_area :instrucciones, rows: 2,
            placeholder: "Instrucciones para el procesamiento del paquete...",
            class: clases_de_input %>
      </div>
    </div>
  <% end %>
</div>
