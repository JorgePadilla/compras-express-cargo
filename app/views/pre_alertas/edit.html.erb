<div data-controller="pre-alerta-editor"
     <%# PR-C6.25: sin este valor el Stimulus cortaba en seco y el boton
         "Guardar (F8)" no hacia NADA — borrar una fila tampoco persistia. %>
     data-pre-alerta-editor-autosave-url-value="<%= pre_alerta_path(@pre_alerta) %>"
     data-pre-alerta-editor-cancel-url-value="<%= pre_alertas_path %>">
  <div id="pre_alerta_header">
    <%= render "pre_alertas/header", pre_alerta: @pre_alerta %>
  </div>

  <div id="flash"></div>

  <%= form_with model: @pre_alerta, url: pre_alerta_path(@pre_alerta), method: :patch,
      data: { pre_alerta_editor_target: "form" }, class: "space-y-6" do |f| %>

    <%# PR-C6.25: esta pantalla no tenía dónde mostrar un error. El `update`
        re-renderizaba con 422 y el usuario veía la misma página, sin saber por
        qué no se había guardado — el caso más común es un tracking repetido
        dentro de la misma pre-alerta. %>
    <% if @pre_alerta.errors.any? %>
      <div class="p-4 bg-red-50 border border-red-200 rounded-lg" data-bloque="errores">
        <p class="text-sm font-medium text-red-800 mb-1">No se pudo guardar:</p>
        <ul class="list-disc list-inside text-sm text-red-700 space-y-0.5">
          <% @pre_alerta.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%# Info row %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
        <p class="text-xs text-gray-500">Numero</p>
        <p class="font-mono font-bold text-cec-navy"><%= @pre_alerta.numero_documento %></p>
      </div>
      <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
        <p class="text-xs text-gray-500">Cliente</p>
        <p class="font-mono font-medium text-cec-navy"><%= @pre_alerta.cliente.codigo %></p>
        <p class="text-sm text-gray-600"><%= @pre_alerta.cliente.nombre_completo %></p>
      </div>
      <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
        <p class="text-xs text-gray-500">Tipo Envio</p>
        <p class="font-medium text-gray-800"><%= @pre_alerta.tipo_envio.nombre %></p>
      </div>
      <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
        <p class="text-xs text-gray-500">Estado</p>
        <div class="mt-1">
          <%= f.select :estado, options_for_select(PreAlerta.estados.keys.map { |e| [e.humanize, e] }, @pre_alerta.estado),
              {},
              class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-cec-teal focus:border-cec-teal" %>
        </div>
      </div>
    </div>

    <%# Opciones %>
    <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
      <div class="flex flex-wrap gap-4">
        <label class="flex items-center gap-2 text-sm">
          <%= f.check_box :con_reempaque, class: "rounded border-gray-300 text-cec-teal focus:ring-cec-teal" %>
          Con Reempaque
        </label>
        <label class="flex items-center gap-2 text-sm">
          <%= f.check_box :consolidado, class: "rounded border-gray-300 text-cec-teal focus:ring-cec-teal" %>
          Consolidado
        </label>
      </div>
    </div>

    <%# Titulo + Proveedor %>
    <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Título de Referencia</label>
          <%= f.text_field :titulo, placeholder: "Ej. Televisor, Zapatos...",
              class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm
                     focus:outline-none focus:ring-2 focus:ring-cec-teal focus:border-cec-teal" %>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Proveedor / Tienda</label>
          <%# PR-C6.36: sugerencias del catalogo de Proveedores, con texto libre.
              Mismo patron que el carrier de /etiquetar, que Yusef ya aprobo:
              "dropdown con texto libre para agregar a la lista". No se migra
              a FK porque `PreAlerta.proveedor` es un string y cambiarlo
              tocaria datos viejos por una pantalla que nadie reporto rota. %>
          <%= f.text_field :proveedor, list: "proveedores-list", placeholder: "Ej. Amazon, Best Buy...",
              class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm
                     focus:outline-none focus:ring-2 focus:ring-cec-teal focus:border-cec-teal" %>
          <datalist id="proveedores-list">
            <% @proveedores_sugeridos.each do |p| %>
              <option value="<%= p.nombre %>">
            <% end %>
          </datalist>
        </div>
      </div>
    </div>

    <%# Notas %>
    <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
      <label class="block text-sm font-medium text-gray-700 mb-1.5">Notas del grupo</label>
      <%= f.text_area :notas_grupo, rows: 2,
          placeholder: "Notas opcionales para este grupo de paquetes...",
          class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm
                 focus:outline-none focus:ring-2 focus:ring-cec-teal focus:border-cec-teal" %>
    </div>

    <%# Paquetes table %>
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
      <div class="px-4 py-3 border-b border-gray-100 flex items-center gap-3">
        <h3 class="text-sm font-bold text-gray-800">Paquetes</h3>
        <span data-pre-alerta-editor-target="counter"
              class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-500"></span>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Tracking</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Descripcion</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Instrucciones</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Fecha</th>
              <th class="px-4 py-2 text-center text-xs font-medium text-gray-500 uppercase">Estado</th>
              <th class="px-4 py-2 text-center text-xs font-medium text-gray-500 uppercase">Vinculado</th>
              <th class="px-4 py-2"></th>
            </tr>
          </thead>
          <tbody data-pre-alerta-editor-target="paquetesBody" class="divide-y divide-gray-200">
<% @pre_alerta.pre_alerta_paquetes.each.with_index do |pap, index| %>
  <%= render "pre_alertas/paquete_row", f: f, pap: pap, index: index %>
<% end %>
          </tbody>
        </table>
      </div>
    </div>

<%# PR-C6.44: el template sale del MISMO partial que las filas de arriba.
    Antes era HTML a mano con SEIS celdas contra siete columnas, asi que
    cada fila que agregaba el JS salia corrida. %>
<template data-pre-alerta-editor-target="template">
  <%= render "pre_alertas/paquete_row",
        f: f, pap: PreAlertaPaquete.new, index: "NEW_INDEX" %>
</template>

    <%# Action buttons %>
    <div class="flex flex-col sm:flex-row gap-3 justify-end">
      <%= link_to "Cancelar (F2)", pre_alertas_path,
          class: "text-gray-600 hover:text-gray-800 text-sm font-medium px-4 py-2.5 text-center" %>
      <button type="button" data-action="click->pre-alerta-editor#addPaquete"
              data-pre-alerta-editor-target="addButton"
              class="inline-flex items-center gap-1.5 border border-cec-teal text-cec-teal font-semibold px-6 py-2.5 rounded-lg text-sm hover:bg-cec-teal/10 transition-colors">
        <%= heroicon "plus-circle", variant: :outline, options: { class: "w-4 h-4" } %>
        Agregar Paquete (F6)
      </button>
      <button type="button" data-action="click->pre-alerta-editor#save"
              class="bg-cec-teal text-white font-semibold px-6 py-2.5 rounded-lg shadow-sm text-sm hover:bg-cec-teal-dark transition-colors">
        Guardar (F8)
      </button>
    </div>
  <% end %>
</div>
