<%# Pagination compuesta — summary izq, controles y per-page der. El `nav` lo
    pone este componente, con un nombre por posición (PR-PAG.1); el
    `_paginator` de Kaminari solo dibuja los links. %>
<% if empty? %>
  <div class="<%= margen %> text-sm text-gray-600 dark:text-gray-300 italic py-2">
    Sin <%= @label %> que mostrar.
  </div>
<% elsif fuera_de_rango? %>
  <div class="<%= margen %> py-3 text-base text-gray-700 dark:text-gray-200">
    Esta página ya no tiene <%= @label %>.
    <%= link_to "Ir a la primera página", primera_pagina_url,
          class: "inline-flex min-h-11 items-center font-semibold text-cec-teal-deep dark:text-cec-teal-light underline" %>
  </div>
<% else %>
  <div class="<%= margen %> flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 py-2 text-sm text-gray-700 dark:text-gray-200"
       data-paginacion="<%= @posicion %>">
    <%# Summary %>
    <div>
      <% if single_page? %>
        Mostrando <span class="font-semibold text-gray-900 dark:text-gray-100"><%= total %></span>
        <%= total == 1 ? @label.singularize : @label %>
      <% else %>
        Mostrando
        <span class="font-semibold text-gray-900 dark:text-gray-100">
          <%= number_with_delimiter(first_index) %>&nbsp;–&nbsp;<%= number_with_delimiter(last_index) %>
        </span>
        de
        <span class="font-semibold text-gray-900 dark:text-gray-100"><%= number_with_delimiter(total) %></span>
        <%= @label %>
      <% end %>
    </div>

    <%# Controles + per-page %>
    <div class="flex items-center gap-3 flex-wrap">
      <% unless single_page? %>
        <nav aria-label="<%= nav_label %>">
          <%= helpers.paginate @collection %>
        </nav>
      <% end %>

      <% if show_per_page_selector? %>
        <div class="inline-flex items-center gap-2">
          <label for="<%= selector_id %>" class="text-sm text-gray-700 dark:text-gray-200">Por página:</label>
          <select id="<%= selector_id %>" onchange="window.location.href = this.value"
                  class="min-h-11 rounded-md border border-gray-500 dark:border-gray-400 dark:bg-gray-700 dark:text-gray-100 text-sm py-2 pr-8 focus:ring-cec-teal-deep focus:border-cec-teal-deep">
            <% opciones_por_pagina.each do |opt| %>
              <option value="<%= per_page_url(opt) %>" <%= "selected" if opt == per_page %>>
                <%= opt %>
              </option>
            <% end %>
          </select>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
