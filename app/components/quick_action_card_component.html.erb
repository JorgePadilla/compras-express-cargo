<%= link_to @href,
      class: "group flex items-start gap-3 rounded-xl border border-gray-100 dark:border-gray-700 bg-white dark:bg-gray-800 p-4 shadow-sm ring-1 ring-transparent hover:-translate-y-0.5 hover:shadow-md transition motion-reduce:transition-none motion-reduce:hover:translate-y-0 #{palette[:ring]} #{palette[:glow]} focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cec-teal",
      aria: { label: @subtitle.present? ? "#{@title} — #{@subtitle}" : @title } do %>
  <span class="icon-pill shrink-0 inline-flex items-center justify-center w-10 h-10 <%= palette[:icon_bg] %>">
    <%= helpers.heroicon @icon, variant: :solid, options: { class: "w-5 h-5 #{palette[:icon_fg]}" } %>
  </span>
  <span class="min-w-0 flex-1">
    <span class="block text-sm font-semibold text-gray-900 dark:text-gray-100 truncate"><%= @title %></span>
    <% if @subtitle.present? %>
      <span class="block text-xs text-gray-500 dark:text-gray-400 truncate"><%= @subtitle %></span>
    <% end %>
  </span>
<% end %>
