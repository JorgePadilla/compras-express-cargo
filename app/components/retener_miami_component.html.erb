<%# ⚠️ Nada acá lleva `required`. Esto vive adentro de un `<dialog>` cerrado, y
    un campo obligatorio dentro de un contenedor oculto hace que Chrome se niegue
    a enviar el formulario **sin decir por qué** — lo mismo que quedó anotado en
    `#306`. %>
<div data-controller="checkbox-modal"
     class="px-3 py-2 rounded-lg ring-1 ring-gray-200 dark:ring-gray-700 hover:bg-amber-50 dark:hover:bg-amber-900/20 transition-colors">
  <label class="flex items-center gap-2 cursor-pointer">
    <%= f.check_box :retener_miami,
        data: { checkbox_modal_target: "checkbox", action: "change->checkbox-modal#onChange" },
        class: "rounded border-gray-300 text-amber-600 focus:ring-amber-500" %>
    <span class="text-sm font-medium text-gray-700 dark:text-gray-200">Retener en Miami</span>
    <% if activo? %>
      <span class="ml-auto text-[10px] uppercase tracking-wider font-bold px-1.5 py-0.5 rounded bg-amber-100 text-amber-900">activo</span>
    <% end %>
  </label>
  <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Especificá motivo(s) de la retención.</p>

  <dialog data-checkbox-modal-target="dialog"
          aria-label="Retener en Miami"
          style="margin: auto" class="rounded-xl p-0 w-[32rem] max-w-[95vw] backdrop:bg-black/40 ring-1 ring-amber-300">
    <div class="bg-amber-50 px-5 py-3 border-b border-amber-200">
      <h3 class="text-base font-semibold text-amber-900">Retener en Miami</h3>
    </div>
    <div class="p-5 space-y-4 bg-white">
      <div>
        <span class="block text-sm font-medium text-gray-700 mb-1">Motivos</span>
        <% if hay_motivos? %>
          <%# `collection_check_boxes` y no una lista a mano: si mañana agregan un
              motivo al catálogo tiene que salir solo, sin tocar esto. %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <%= f.collection_check_boxes :motivo_retencion_ids, motivos, :id, :nombre do |b| %>
              <label class="flex items-start gap-2 text-sm text-gray-800">
                <%= b.check_box(class: "mt-0.5 rounded border-amber-300 text-amber-600 focus:ring-amber-500") %>
                <span><%= b.text %></span>
              </label>
            <% end %>
          </div>
        <% else %>
          <p class="text-xs text-amber-700 italic">
            No hay motivos configurados todavía. Pedile a un admin que los cargue en
            <%= link_to "Motivos de retención", motivos_retencion_path, class: "underline" %>.
          </p>
        <% end %>
      </div>
      <div>
        <%= f.label :notas_retencion, "Otro motivo / detalle del caso",
            class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_area :notas_retencion, rows: 3,
            placeholder: "Detalle adicional. Obligatorio si no seleccionaste motivo.",
            class: "block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-amber-500 focus:border-amber-500" %>
      </div>
    </div>
    <div class="flex items-center justify-end gap-2 px-5 py-3 bg-gray-50 border-t border-gray-200">
      <%= render ButtonComponent.new(variant: :ghost, size: :sm,
            data: { action: "checkbox-modal#cancel" }) do %>Cancelar<% end %>
      <%= render ButtonComponent.new(variant: :warning, size: :sm,
            data: { action: "checkbox-modal#confirm" }) do %>Confirmar<% end %>
    </div>
  </dialog>
</div>
