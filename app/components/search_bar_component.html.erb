<%= form_with url: @url, method: :get, data: { turbo_frame: "_top" }, class: "w-full sm:max-w-md" do |f| %>
  <div class="flex items-center gap-1">
    <div class="relative flex-1">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <%= helpers.heroicon "magnifying-glass", variant: :outline, options: { class: "w-5 h-5 text-gray-400" } %>
      </div>
      <%= f.text_field @param, value: @value, placeholder: @placeholder,
          class: "block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-lg text-sm
                 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-cec-teal focus:border-cec-teal",
          autocomplete: "off" %>
    </div>
    <% if @value.present? %>
      <%# Botón limpiar al lado del input (sibling), no dentro. Navega
          a @url quitando todos los params. %>
      <%= link_to @url,
          class: "shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-lg text-gray-400 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-500 transition-colors",
          title: "Limpiar búsqueda",
          aria: { label: "Limpiar búsqueda" },
          data: { turbo_frame: "_top" } do %>
        <%= helpers.heroicon "x-mark", variant: :outline, options: { class: "w-5 h-5" } %>
      <% end %>
    <% end %>
  </div>
<% end %>
