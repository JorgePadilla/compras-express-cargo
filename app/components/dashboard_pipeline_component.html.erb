<div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 p-5">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-sm font-bold text-gray-800 dark:text-gray-100">Pipeline operativo</h2>
    <p class="text-[11px] text-gray-400 dark:text-gray-500 hidden sm:block">Flujo Miami → Honduras → Cliente</p>
  </div>

  <ol class="flex flex-col md:flex-row md:items-stretch gap-3" data-controller="stagger-reveal" data-stagger-reveal-step-value="80">
    <% stages.each_with_index do |s, idx| %>
      <li data-stagger class="animate-stagger flex-1 min-w-0 group">
        <div class="relative h-full rounded-xl bg-gray-50 dark:bg-gray-900/40 ring-1 <%= s[:accent_classes][:ring] %> p-3 transition hover:bg-white dark:hover:bg-gray-800 hover:shadow-md">
          <div class="flex items-start justify-between gap-2">
            <span class="icon-pill inline-flex items-center justify-center w-9 h-9 <%= s[:accent_classes][:chip] %>">
              <%= helpers.heroicon s[:icon], variant: :solid, options: { class: "w-4 h-4" } %>
            </span>
            <span class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 dark:text-gray-500">#<%= idx + 1 %></span>
          </div>
          <p class="mt-2 text-[11px] font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400"><%= s[:label] %></p>
          <p class="text-2xl font-bold text-cec-navy dark:text-gray-100 tabular-nums leading-none mt-1"
             data-controller="count-up"
             data-count-up-target-value="<%= s[:count] %>"
             data-count-up-duration-value="700">0</p>
          <p class="text-[10px] text-gray-400 dark:text-gray-500 mt-1.5"><%= s[:caption] %></p>

          <%# Volumen relativo (barra) %>
          <div class="mt-3 h-1.5 rounded-full bg-gray-200/70 dark:bg-gray-700 overflow-hidden">
            <div class="h-full rounded-full <%= s[:accent_classes][:bar] %> transition-[width] duration-700"
                 style="width: <%= [ s[:pct], 4 ].max %>%;"
                 aria-hidden="true"></div>
          </div>
        </div>
      </li>

      <% if idx < stages.length - 1 %>
        <li class="hidden md:flex items-center justify-center text-gray-300 dark:text-gray-600 shrink-0" aria-hidden="true">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </li>
        <li class="md:hidden flex items-center justify-center text-gray-300 dark:text-gray-600" aria-hidden="true">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M12 5v14M6 13l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </li>
      <% end %>
    <% end %>
  </ol>
</div>
