<% dot_class, chip_class, message = helpers.health_chip(@health_status) %>
<section class="relative overflow-hidden rounded-2xl bg-cec-hero text-white shadow-cec-navy-glow animate-fade-in-up">
  <%# Patrón decorativo (suaves círculos de luz) %>
  <div aria-hidden="true" class="absolute -top-16 -right-12 w-72 h-72 rounded-full bg-cec-teal/15 blur-3xl"></div>
  <div aria-hidden="true" class="absolute -bottom-20 -left-10 w-80 h-80 rounded-full bg-cec-gold/10 blur-3xl"></div>

  <div class="relative px-6 sm:px-8 py-7 flex flex-col lg:flex-row lg:items-stretch lg:justify-between gap-5">
    <%# IZQ: Saludo + descripción del día %>
    <div class="min-w-0 flex flex-col justify-center">
      <p class="text-xs uppercase tracking-[0.2em] text-white/60 font-semibold mb-1"><%= long_date %></p>
      <h1 class="text-2xl sm:text-3xl font-bold leading-tight">
        <%= helpers.greeting_for(@time) %>,
        <span class="bg-gradient-to-r from-cec-gold-light to-cec-gold bg-clip-text text-transparent"><%= display_name %></span>
      </h1>
      <p class="mt-2 text-sm text-white/70 max-w-xl">Aquí está el panorama del día — un vistazo rápido a operación, ingresos y entregas para que todo siga fluyendo.</p>
    </div>

    <%# DER: Operations Panel — status pulsante + 4 KPIs accionables.
        Yusef 2026-05-02: pidió mejorar visibilidad y agregar análisis
        más profundo de la operación en el espacio del antiguo chip. %>
    <div class="shrink-0 w-full lg:w-[28rem] rounded-xl bg-white/8 backdrop-blur-md ring-1 ring-white/15 overflow-hidden">
      <%# Header: status pulsante + label uppercase %>
      <div class="px-4 py-2.5 flex items-center gap-2.5 border-b border-white/10 <%= chip_class %>">
        <span class="relative inline-flex w-2.5 h-2.5">
          <span class="absolute inset-0 rounded-full <%= dot_class %> opacity-75 dot-pulse" aria-hidden="true"></span>
          <span class="relative inline-block w-2.5 h-2.5 rounded-full <%= dot_class %>"></span>
        </span>
        <span class="text-xs font-bold uppercase tracking-wider"><%= message %></span>
      </div>

      <%# 4 mini-stats. Mobile/tablet: grid 2x2. Desktop lg+: 4x1.
          Click-through cuando hay href; valor cambia color por threshold. %>
      <% if mini_stats.any? %>
        <div class="grid grid-cols-2 lg:grid-cols-4 divide-x divide-y lg:divide-y-0 divide-white/10">
          <% mini_stats.each do |s| %>
            <% wrapper_tag = s[:href] ? :a : :div %>
            <%= content_tag wrapper_tag, (s[:href] ? { href: s[:href] } : {}).merge(
                  class: "px-3 py-3 flex flex-col gap-1 #{'hover:bg-white/10 transition-colors cursor-pointer' if s[:href]}"
                ) do %>
              <div class="flex items-center gap-1.5 text-[10px] uppercase tracking-wider text-white/60 font-semibold">
                <%= helpers.heroicon s[:icon], variant: :outline, options: { class: "w-3 h-3" } %>
                <span class="truncate"><%= s[:label] %></span>
              </div>
              <div class="text-2xl font-bold leading-none
                <%= case s[:tone]
                    when :alert then 'text-red-300'
                    when :warn  then 'text-cec-gold-light'
                    else             'text-white'
                    end %>">
                <%= number_with_delimiter(s[:value]) %>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</section>
