<% dot_class, chip_class, message = helpers.health_chip(@health_status) %>
<section class="relative overflow-hidden rounded-2xl bg-cec-hero text-white shadow-cec-navy-glow animate-fade-in-up">
  <%# Patrón decorativo (suaves círculos de luz) %>
  <div aria-hidden="true" class="absolute -top-16 -right-12 w-72 h-72 rounded-full bg-cec-teal/15 blur-3xl"></div>
  <div aria-hidden="true" class="absolute -bottom-20 -left-10 w-80 h-80 rounded-full bg-cec-gold/10 blur-3xl"></div>

  <div class="relative px-6 sm:px-8 py-7 flex flex-col md:flex-row md:items-center md:justify-between gap-5">
    <div class="min-w-0">
      <p class="text-xs uppercase tracking-[0.2em] text-white/60 font-semibold mb-1"><%= long_date %></p>
      <h1 class="text-2xl sm:text-3xl font-bold leading-tight">
        <%= helpers.greeting_for(@time) %>,
        <span class="bg-gradient-to-r from-cec-gold-light to-cec-gold bg-clip-text text-transparent"><%= display_name %></span>
      </h1>
      <p class="mt-2 text-sm text-white/70 max-w-xl">Aquí está el panorama del día — un vistazo rápido a operación, ingresos y entregas para que todo siga fluyendo.</p>
    </div>

    <div class="shrink-0 flex items-center gap-3">
      <div class="inline-flex items-center gap-2 rounded-full px-3.5 py-2 <%= chip_class %>">
        <span class="relative inline-flex w-2.5 h-2.5">
          <span class="absolute inset-0 rounded-full <%= dot_class %> opacity-75 dot-pulse" aria-hidden="true"></span>
          <span class="relative inline-block w-2.5 h-2.5 rounded-full <%= dot_class %>"></span>
        </span>
        <span class="text-xs font-bold uppercase tracking-wider"><%= message %></span>
      </div>

      <%# PR-C29.16 · Los signos del servidor. Jorge: *"pon un icono en / root y
          al lado derecho para ver los signos del servidor"*. La píldora de al
          lado es del negocio; ésta es de la máquina, y el puntito trae su
          semáforo (la cola y las conexiones, que es lo barato de medir). %>
      <%# 2026-10-08 · Jorge: *"creo que podemos mejorar el icono de signos
          vitales, hacerlo más agradable, y el color"*. Era un cuadrado blanco
          con un ícono de servidor chiquito: sobre el navy del saludo se veía
          pegado de otra pantalla. Ahora es una píldora de vidrio, hermana de
          la de la operación: el chip, la palabra «Servidor» y el puntito del
          semáforo, que late como el de al lado. Blanco sobre el navy del
          saludo: más de 12:1. %>
      <% if signos? %>
        <%= link_to helpers.signos_vitales_path,
              class: "group inline-flex items-center gap-2 min-h-11 rounded-full px-3.5 py-2 " \
                     "bg-white/10 ring-1 ring-white/25 backdrop-blur-sm text-white " \
                     "hover:bg-white/20 hover:ring-white/40 transition-colors foco-cec",
              title: "Signos del servidor", "aria-label": "Signos del servidor: #{texto_signos}",
              data: { signos: @signos } do %>
          <%= helpers.heroicon "cpu-chip", variant: :outline, options: { class: "w-4 h-4 text-cec-teal-light", "aria-hidden" => "true" } %>
          <span class="text-xs font-bold uppercase tracking-wider">Servidor</span>
          <span class="relative inline-flex w-2.5 h-2.5" aria-hidden="true">
            <span class="absolute inset-0 rounded-full <%= color_signos %> opacity-75 dot-pulse"></span>
            <span class="relative inline-block w-2.5 h-2.5 rounded-full <%= color_signos %>"></span>
          </span>
        <% end %>
      <% end %>
    </div>
  </div>
</section>
