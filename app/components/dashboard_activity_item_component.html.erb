<%= link_to href, class: "group flex items-center gap-3 px-4 py-2.5 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-cec-teal" do %>
  <span class="shrink-0 w-9 h-9 rounded-full <%= avatar_class %> text-white text-xs font-bold flex items-center justify-center shadow-sm" aria-hidden="true">
    <%= initials %>
  </span>
  <div class="min-w-0 flex-1">
    <p class="font-mono text-[10px] text-gray-500 dark:text-gray-400 leading-tight"><%= eyebrow %></p>
    <p class="text-sm text-gray-800 dark:text-gray-100 truncate"><%= title %></p>
    <% if relative_time %>
      <p class="text-[10px] text-gray-400 dark:text-gray-500 mt-0.5"><%= relative_time %></p>
    <% end %>
  </div>
  <% if badge? %>
    <div class="shrink-0"><%= badge %></div>
  <% end %>
<% end %>
